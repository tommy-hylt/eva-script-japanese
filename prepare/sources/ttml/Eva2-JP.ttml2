   <style tts:textAlign="start" xml:id="s2"></style> 
   <style tts:fontShear="16.78842%" xml:id="s3"></style> 
   <style tts:ruby="container" xml:id="s4"></style> 
   <style tts:ruby="base" xml:id="s5"></style> 
   <style tts:ruby="text" tts:rubyPosition="before" xml:id="s6"></style> 
   <style tts:fontSize="1.5em 1.0em" xml:id="s7"></style> 
   <style tts:fontShear="16.78842%" tts:textAlign="center" xml:id="s8"></style> 
   <style tts:ruby="text" tts:rubyPosition="after" xml:id="s9"></style> 
   <style tts:textCombine="all" xml:id="s10"></style> 
  </styling> 
  <layout> 
   <region tts:displayAlign="after" tts:extent="80vw 15vh" tts:position="center bottom 10vh" xml:id="横下" /> 
   <region tts:extent="15vw 80vh" tts:position="right 10vw center" tts:writingMode="tbrl" xml:id="縦右" /> 
   <region tts:displayAlign="after" tts:extent="15vw 80vh" tts:position="left 10vw center" tts:writingMode="tbrl" xml:id="縦左" /> 
  </layout> 
 </head> 
 <body region="横下" xml:space="preserve"> 
  <div> 
   <p begin="00:00:31.991" end="00:00:34.785" style="s1"><span style="s2">（空気が泡になる音）</span></p> 
   <p begin="00:00:34.910" end="00:00:36.370" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:36.370" end="00:00:38.080" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:36.370" end="00:00:38.080" region="縦右" style="s3">（男性隊員１・英語）</p> 
   <p begin="00:00:38.080" end="00:00:38.622" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:38.622" end="00:00:40.791" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:38.622" end="00:00:40.791" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:00:40.791" end="00:00:41.125" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:41.125" end="00:00:42.960" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:41.125" end="00:00:42.960" region="縦右" style="s3">（男性隊員２・英語）</p> 
   <p begin="00:00:42.960" end="00:00:43.335" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:43.335" end="00:00:44.754" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:43.335" end="00:00:44.754" region="縦右" style="s3">（男性隊員２・英語）</p> 
   <p begin="00:00:44.754" end="00:00:45.296" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:45.296" end="00:00:47.381" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:45.296" end="00:00:47.381" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:00:47.381" end="00:00:47.757" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:47.757" end="00:00:49.383" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:47.757" end="00:00:49.383" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:00:49.383" end="00:00:49.925" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:49.925" end="00:00:52.136" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:49.925" end="00:00:52.136" region="縦右" style="s3">（男性隊員１・英語）</p> 
   <p begin="00:00:52.136" end="00:00:52.303" region="縦左">（深い呼吸）</p> 
   <p begin="00:00:52.678" end="00:00:56.432" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:00:57.516" end="00:01:00.811" style="s1"><span style="s2">（５号機パイロット）<br />えっと 初めてなんで 日本語で！</span></p> 
   <p begin="00:01:01.145" end="00:01:01.729" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:01:06.984" end="00:01:07.985" style="s1"><span style="s2">うっ うっ…</span></p> 
   <p begin="00:01:08.068" end="00:01:10.529" style="s1"><span style="s2">（<span style="s4"><span style="s5">加持</span><span style="s6">かじ</span></span>）新型の支給<br />間に合わなかったか</span></p> 
   <p begin="00:01:10.738" end="00:01:12.948" style="s1"><span style="s2">胸がキツくて ヤダ</span></p> 
   <p begin="00:01:13.032" end="00:01:17.536" style="s1"><span style="s2">（加持）おまけに急造品の機体で<br />いきなり実戦とは 誠にすまない</span></p> 
   <p begin="00:01:18.537" end="00:01:21.540" style="s1"><span style="s2">やっと乗せてくれたから…<br />いい</span></p> 
   <p begin="00:01:21.707" end="00:01:24.710" style="s1"><span style="s2">（加持）<br />おまえは問題児だからな<br />まっ 頼むよ</span></p> 
   <p begin="00:01:25.002" end="00:01:29.715" style="s1"><span style="s2">動いてる 動いてる<br />いいなぁ～ ワクワクするなぁ</span></p> 
   <p begin="00:01:32.218" end="00:01:35.679" style="s1"><span style="s2">さて エヴァンゲリオン仮設５号機</span></p> 
   <p begin="00:01:35.888" end="00:01:36.889" style="s1"><span style="s2">起動</span></p> 
   <p begin="00:01:38.182" end="00:01:39.183" style="s1"><span style="s2">（ビームの音）</span></p> 
   <p begin="00:01:39.266" end="00:01:41.560" style="s1"><span style="s2">（金属のきしむ音）</span></p> 
   <p begin="00:01:43.729" end="00:01:45.856" style="s1"><span style="s2">（使徒の<span style="s4"><span style="s5">咆哮</span><span style="s6">ほうこう</span></span>）</span></p> 
   <p begin="00:01:46.565" end="00:01:49.610" style="s1"><span style="s2">（砲撃音）</span></p> 
   <p begin="00:01:49.944" end="00:01:54.907" region="縦右">（司令・英語）</p> 
   <p begin="00:01:55.491" end="00:01:59.245" region="縦右">（司令・英語）</p> 
   <p begin="00:02:00.037" end="00:02:02.373" region="縦右">（加持・英語）</p> 
   <p begin="00:02:02.581" end="00:02:03.249" style="s1"><span style="s2">ウム？</span></p> 
   <p begin="00:02:03.457" end="00:02:07.336" region="縦右">（加持・英語）</p> 
   <p begin="00:02:08.045" end="00:02:10.798" region="縦右">（加持・英語）</p> 
   <p begin="00:02:11.340" end="00:02:15.678" region="縦右">（加持・英語）</p> 
   <p begin="00:02:16.095" end="00:02:17.471" region="縦右">（加持・英語）</p> 
   <p begin="00:02:17.596" end="00:02:18.347" style="s1"><span style="s2">ン？</span></p> 
   <p begin="00:02:20.891" end="00:02:25.271" style="s1"><span style="s2">（５号機パイロット）<br />♪しっあわっせはぁ～<br />あるいてこない～</span></p> 
   <p begin="00:02:25.479" end="00:02:29.859" style="s1"><span style="s2">だ～から 歩いてゆくんだね～</span></p> 
   <p begin="00:02:29.942" end="00:02:34.071" style="s1"><span style="s2">一日一歩　三日で三歩</span></p> 
   <p begin="00:02:34.238" end="00:02:38.450" style="s1"><span style="s2">三歩すすんで二歩さがる～</span></p> 
   <p begin="00:02:38.617" end="00:02:42.705" style="s1"><span style="s2">人生は ワンツウパンチィ～♪</span></p> 
   <p begin="00:02:42.955" end="00:02:45.291" style="s1"><span style="s2">おっ！ 来たぁ フィールド展開</span></p> 
   <p begin="00:02:45.457" end="00:02:48.544" style="s1"><span style="s2">（骨格が鳴る音）</span></p> 
   <p begin="00:02:48.627" end="00:02:50.296" style="s1"><span style="s2">（咆哮）</span></p> 
   <p begin="00:02:52.631" end="00:02:56.385" region="縦右" style="s3">（女性隊員・英語）</p> 
   <p begin="00:03:00.764" end="00:03:02.975" style="s1"><span style="s2">（マリ）<br />うおぉりゃっ!!</span></p> 
   <p begin="00:03:03.726" end="00:03:04.727" style="s1"><span style="s2">あちゃ！</span></p> 
   <p begin="00:03:04.810" end="00:03:05.811" style="s1"><span style="s2">（急制動音）</span></p> 
   <p begin="00:03:05.936" end="00:03:07.146" style="s1"><span style="s2">動きが重いっ！</span></p> 
   <p begin="00:03:07.271" end="00:03:08.647" style="s1"><span style="s2">（ドリル回転音）</span></p> 
   <p begin="00:03:12.026" end="00:03:15.905" style="s1"><span style="s2">こりゃ 力押ししかないじゃん！</span></p> 
   <p begin="00:03:16.322" end="00:03:17.489" style="s1"><span style="s2">（ビームの音）</span></p> 
   <p begin="00:03:18.532" end="00:03:20.993" style="s1"><span style="s2">（使徒の咆哮）</span></p> 
   <p begin="00:03:29.168" end="00:03:33.297" region="縦右">（女性隊員・英語）</p> 
   <p begin="00:03:34.840" end="00:03:37.760" style="s1"><span style="s2">（ビームの音）</span></p> 
   <p begin="00:03:42.681" end="00:03:46.185" region="縦右">（女性隊員・英語）</p> 
   <p begin="00:03:46.393" end="00:03:48.312" region="縦右">（司令・英語）</p> 
   <p begin="00:03:50.522" end="00:03:52.024" style="s1"><span style="s2">にげんなあっ!!</span></p> 
   <p begin="00:03:52.149" end="00:03:53.734" style="s1"><span style="s2">おらあぁあ!!</span></p> 
   <p begin="00:03:56.487" end="00:03:57.988" style="s1"><span style="s2">（使徒の咆哮）</span></p> 
   <p begin="00:03:58.072" end="00:04:00.366" style="s1"><span style="s2">（ビームの音）</span></p> 
   <p begin="00:04:00.532" end="00:04:02.117" style="s1"><span style="s2">イッタイ!!</span></p> 
   <p begin="00:04:02.201" end="00:04:03.911" style="s1"><span style="s2">すっげーイタイけど</span></p> 
   <p begin="00:04:04.036" end="00:04:05.871" style="s1"><span style="s2">面白いからいいっ!!</span></p> 
   <p begin="00:04:10.876" end="00:04:11.877" style="s1"><span style="s2">時間がない！</span></p> 
   <p begin="00:04:14.338" end="00:04:16.548" style="s1"><span style="s2">機体も もたない！</span></p> 
   <p begin="00:04:16.757" end="00:04:19.551" style="s1"><span style="s2">義手パーツは<br />ムリヤリシンクロさせてるぶん<span style="s7">―</span></span></p> 
   <p begin="00:04:19.677" end="00:04:21.095" style="s1"><span style="s2">パワーも足りない！</span></p> 
   <p begin="00:04:23.555" end="00:04:25.891" style="s1"><span style="s2">（ビームの音）</span></p> 
   <p begin="00:04:27.393" end="00:04:29.645" style="s1"><span style="s2">ええい!! しゃあない!!</span></p> 
   <p begin="00:04:29.728" end="00:04:32.940" style="s1"><span style="s2">腕の一本くれてやるっ!!</span></p> 
   <p begin="00:04:38.028" end="00:04:39.405" style="s1"><span style="s2">さっさと…</span></p> 
   <p begin="00:04:39.738" end="00:04:43.909" style="s1"><span style="s2">くたばれぇぇぇっ!!</span></p> 
   <p begin="00:04:44.034" end="00:04:45.244" style="s1"><span style="s2">（破砕する音）</span></p> 
   <p begin="00:04:58.674" end="00:05:03.762" region="縦右" style="s3">（男性隊員３・英語）</p> 
   <p begin="00:05:04.263" end="00:05:08.100" style="s1"><span style="s2">５号機の自爆プログラムは<br />うまく作動してくれたか…</span></p> 
   <p begin="00:05:09.268" end="00:05:10.978" style="s1"><span style="s2">折り込み済みとはいえ</span></p> 
   <p begin="00:05:11.103" end="00:05:14.898" style="s1"><span style="s2">大人の都合に子供を巻き込むのは<br />気が引けるなぁ…</span></p> 
   <p begin="00:05:20.279" end="00:05:22.614" style="s1"><span style="s2">イテテテッ</span></p> 
   <p begin="00:05:22.740" end="00:05:26.243" style="s1"><span style="s2">エヴァとのシンクロって<br />聞いてたより キツイじゃん</span></p> 
   <p begin="00:05:28.746" end="00:05:30.456" style="s1"><span style="s2">っはぁ…</span></p> 
   <p begin="00:05:31.123" end="00:05:33.584" style="s1"><span style="s2">まあ… 生きてりゃいいや</span></p> 
   <p begin="00:05:34.793" end="00:05:39.423" style="s1"><span style="s2">自分の目的に大人を巻き込むのは<br />気後れするなあ</span></p> 
   <p begin="00:05:40.299" end="00:05:42.801" style="s1"><span style="s2">さよなら エヴァ５号機</span></p> 
   <p begin="00:05:43.260" end="00:05:44.803" style="s1"><span style="s2">御役目御苦労さん</span></p> 
   <p begin="00:05:49.933" end="00:05:54.605" style="s1"><span style="s2">（乾いた風の音）</span></p> 
   <p begin="00:05:58.650" end="00:06:02.988" style="s1"><span style="s2">（ゲンドウ）３年ぶりだな<br />二人でここに来るのは</span></p> 
   <p begin="00:06:03.989" end="00:06:08.827" style="s1"><span style="s2">（シンジ）<br />僕は… あの時逃げ出して<br />そのあとは来てない</span></p> 
   <p begin="00:06:09.661" end="00:06:12.790" style="s1"><span style="s2">（シンジ）<br />ここに母さんが眠ってるって<br />ピンとこないんだ</span></p> 
   <p begin="00:06:13.165" end="00:06:14.833" style="s1"><span style="s2">（シンジ）<br />顔もおぼえてないのに</span></p> 
   <p begin="00:06:15.501" end="00:06:18.629" style="s1"><span style="s2">（ゲンドウ）<br />人は思い出を忘れることで<br />生きて行ける</span></p> 
   <p begin="00:06:19.129" end="00:06:22.883" style="s1"><span style="s2">（ゲンドウ）<br />だが 決して忘れては<br />ならないこともある</span></p> 
   <p begin="00:06:23.175" end="00:06:25.969" style="s1"><span style="s2">（ゲンドウ）<br />ユイは そのかけがえのないものを<br />教えてくれた</span></p> 
   <p begin="00:06:26.470" end="00:06:29.515" style="s1"><span style="s2">（ゲンドウ）<br />私は その確認をするために<br />ここに来ている</span></p> 
   <p begin="00:06:30.641" end="00:06:32.184" style="s1"><span style="s2">写真とか ないの？</span></p> 
   <p begin="00:06:33.185" end="00:06:38.690" style="s1"><span style="s2">残ってはいない<br />この墓もただの飾りだ　遺体はない</span></p> 
   <p begin="00:06:39.733" end="00:06:43.153" style="s1"><span style="s2">先生の言ってた通り<br />全部 捨てちゃったんだね</span></p> 
   <p begin="00:06:44.071" end="00:06:46.031" style="s1"><span style="s2">（ゲンドウ）全ては心の中だ</span></p> 
   <p begin="00:06:46.990" end="00:06:48.492" style="s1"><span style="s2">今はそれでいい</span></p> 
   <p begin="00:06:51.537" end="00:06:54.206" style="s1"><span style="s2">（噴射音）</span></p> 
   <p begin="00:06:54.373" end="00:06:56.375" style="s1"><span style="s2">時間だ 先に帰るぞ</span></p> 
   <p begin="00:07:02.047" end="00:07:03.173" style="s1"><span style="s2">父さん</span></p> 
   <p begin="00:07:05.592" end="00:07:07.553" style="s1"><span style="s2">あの…</span></p> 
   <p begin="00:07:07.886" end="00:07:11.140" style="s1"><span style="s2">今日は うれしかった<br />父さんと話せて</span></p> 
   <p begin="00:07:12.558" end="00:07:13.559" style="s1"><span style="s2">そうか</span></p> 
   <p begin="00:07:18.063" end="00:07:35.497" style="s1"><span style="s2">（噴射上昇音）</span></p> 
   <p begin="00:07:54.600" end="00:07:58.187" style="s1"><span style="s2">どう？ シンジ君<br />あれこれ心配してたけど<span style="s7">―</span></span></p> 
   <p begin="00:07:58.270" end="00:08:00.981" style="s1"><span style="s2">会っちゃえば<br />どうってことなかったでしょ</span></p> 
   <p begin="00:08:02.024" end="00:08:05.235" style="s1"><span style="s2">（ミサト）<br />家でウジウジしてないで<br />来てよかったじゃない</span></p> 
   <p begin="00:08:05.444" end="00:08:07.571" style="s1"><span style="s2">（ミサト）<br />お母さんのお墓参りなんだし</span></p> 
   <p begin="00:08:08.113" end="00:08:10.574" style="s1"><span style="s2">（シンジ）ミサトさんが<br />無理矢理連れて来ただけです</span></p> 
   <p begin="00:08:10.782" end="00:08:14.161" style="s1"><span style="s2">（ミサト）<br />そりゃあ シンジ君の中に<br />行きたいって気持ちがあったからよ</span></p> 
   <p begin="00:08:14.411" end="00:08:16.330" style="s1"><span style="s2">（ミサト）<br />少しは素直になりなさい</span></p> 
   <p begin="00:08:16.788" end="00:08:19.249" style="s1"><span style="s2">（シンジ）素直になっても<br />イヤな想いするだけです</span></p> 
   <p begin="00:08:19.583" end="00:08:22.836" style="s1"><span style="s2">みんなの期待に応えて<br />私たちを救ったのよ</span></p> 
   <p begin="00:08:23.128" end="00:08:24.838" style="s1"><span style="s2">もっと自信持ちなさい</span></p> 
   <p begin="00:08:27.591" end="00:08:30.969" style="s1"><span style="s2">きっとお父さんも<br />シンジ君を認めてくれてるわよ</span></p> 
   <p begin="00:08:31.136" end="00:08:32.846" style="s1"><span style="s2">（ケータイ着信音）</span></p> 
   <p begin="00:08:33.013" end="00:08:34.014" style="s1"><span style="s2">（ミサト）ハイ葛城</span></p> 
   <p begin="00:08:35.849" end="00:08:39.144" style="s1"><span style="s2">（ミサト）<br />わっぁあぁあ！っとっとと</span></p> 
   <p begin="00:08:39.561" end="00:08:40.562" style="s1"><span style="s2">なんですって!？</span></p> 
   <p begin="00:08:40.646" end="00:08:43.523" region="縦右">（砲撃音）</p> 
   <p begin="00:09:09.049" end="00:09:12.928" style="s1"><span style="s2">（青葉）<br />相模湾沖にて 第７使徒を捕捉<br />第２方面軍が交戦中</span></p> 
   <p begin="00:09:13.387" end="00:09:16.056" style="s1"><span style="s2">３分前に 非常事態宣言が<br />発令されました</span></p> 
   <p begin="00:09:16.682" end="00:09:20.394" style="s1"><span style="s2">（ミサト）<br />こちらも肉眼で確認したわ！<br />現在 初号機パイロットを移送中</span></p> 
   <p begin="00:09:20.519" end="00:09:23.855" style="s1"><span style="s2">（ミサト）<br />零号機優先のタスク03を<br />ただちに発動させて</span></p> 
   <p begin="00:09:23.981" end="00:09:26.483" style="s1"><span style="s2">（日向）いえ 既に<br />タスク02を実行中です</span></p> 
   <p begin="00:09:26.566" end="00:09:27.734" style="s1"><span style="s2">（ミサト）タスク02？</span></p> 
   <p begin="00:09:27.859" end="00:09:28.860" style="s1"><span style="s2">まさか!？</span></p> 
   <p begin="00:09:33.031" end="00:09:36.743" region="縦右">♪</p> 
   <p begin="00:09:36.743" end="00:09:37.911" region="縦右">♪</p> 
   <p begin="00:09:36.743" end="00:09:37.911" style="s1"><span style="s2">やはり２号機！</span></p> 
   <p begin="00:09:37.911" end="00:10:13.030" region="縦右">♪</p> 
   <p begin="00:10:13.030" end="00:10:14.698" region="縦右">♪</p> 
   <p begin="00:10:13.030" end="00:10:14.698" style="s1"><span style="s2">すごい コアを 一撃で！</span></p> 
   <p begin="00:10:14.698" end="00:10:14.781" region="縦右">♪</p> 
   <p begin="00:10:14.781" end="00:10:16.575" region="縦右">♪</p> 
   <p begin="00:10:14.781" end="00:10:16.575" style="s1"><span style="s2">ちがう！ デコイだわ！</span></p> 
   <p begin="00:10:16.575" end="00:10:29.004" region="縦右">♪</p> 
   <p begin="00:10:29.004" end="00:10:30.339" region="縦右">♪</p> 
   <p begin="00:10:29.004" end="00:10:30.339" style="s1"><span style="s2">（連続発射音）</span></p> 
   <p begin="00:10:30.339" end="00:10:31.965" region="縦右">♪</p> 
   <p begin="00:10:31.965" end="00:10:33.216" region="縦右">♪</p> 
   <p begin="00:10:31.965" end="00:10:33.216" style="s1"><span style="s2">（２号機パイロット）でっ！</span></p> 
   <p begin="00:10:33.216" end="00:10:35.552" region="縦右">♪</p> 
   <p begin="00:10:35.552" end="00:10:38.388" region="縦右">♪</p> 
   <p begin="00:10:35.552" end="00:10:38.388" style="s1"><span style="s2">（２号機パイロット）<br />どおぅりゃあああ!!</span></p> 
   <p begin="00:10:38.388" end="00:10:42.100" region="縦右">♪</p> 
   <p begin="00:10:42.100" end="00:10:46.104" region="縦右">♪</p> 
   <p begin="00:10:42.100" end="00:10:46.104" style="s1"><span style="s2">（次々と矢を押し込む音）</span></p> 
   <p begin="00:10:46.104" end="00:10:51.985" region="縦右">♪</p> 
   <p begin="00:11:04.331" end="00:11:07.959" style="s1"><span style="s2">（ミサト）きゃぁああっ！<br />（シンジ）うわぁああ！</span></p> 
   <p begin="00:11:11.338" end="00:11:12.881" style="s1"><span style="s2">（２号機パイロット）<br />状況終了</span></p> 
   <p begin="00:11:13.131" end="00:11:15.801" style="s8"><span style="s2">（女性オペレーターの声）<br />該当地区の封鎖は全て完了</span></p> 
   <p begin="00:11:16.468" end="00:11:19.596" style="s8"><span style="s2">現在、エヴァ２ 号機は<br />相模第１ 本戦を移動中</span></p> 
   <p begin="00:11:22.349" end="00:11:25.811" style="s1"><span style="s2">（トウジ）うわ～っ<br />赤いんか２号機って</span></p> 
   <p begin="00:11:25.936" end="00:11:27.729" style="s1"><span style="s2">（女性の声）違うのは<br />カラーリングだけじゃないわ</span></p> 
   <p begin="00:11:27.813" end="00:11:28.814" style="s1"><span style="s2">（一同）あ？</span></p> 
   <p begin="00:11:28.897" end="00:11:30.649" style="s1"><span style="s2">所詮 零号機と初号機は<span style="s7">―</span></span></p> 
   <p begin="00:11:30.816" end="00:11:33.652" style="s1"><span style="s2">開発過程の<br />プロトタイプとテストタイプ</span></p> 
   <p begin="00:11:33.819" end="00:11:35.737" style="s1"><span style="s2">けど この２号機は違う！</span></p> 
   <p begin="00:11:35.821" end="00:11:37.781" style="s1"><span style="s2">これこそ実戦用に作られた</span></p> 
   <p begin="00:11:37.906" end="00:11:40.742" style="s1"><span style="s2">世界初の本物の<br />エヴァンゲリオンなのよ</span></p> 
   <p begin="00:11:40.826" end="00:11:42.202" style="s1"><span style="s2">制式タイプのね</span></p> 
   <p begin="00:11:42.619" end="00:11:46.915" style="s1"><span style="s2">紹介するわ ユーロ空軍のエース<br /><span style="s4"><span style="s5">式波</span><span style="s9">しきなみ</span></span>･アスカ･ラングレー大尉</span></p> 
   <p begin="00:11:47.499" end="00:11:51.461" style="s1"><span style="s2">（ミサト）第２の少女<br />エヴァ２号機担当パイロットよ</span></p> 
   <p begin="00:11:47.499" end="00:11:51.461" region="縦右">（アスカ）よっ はっ<br />ほっ よっ とっ！</p> 
   <p begin="00:11:53.046" end="00:11:55.090" style="s1"><span style="s2">ひさしぶりね ミサト</span></p> 
   <p begin="00:11:55.173" end="00:11:56.216" style="s1"><span style="s2">あ…</span></p> 
   <p begin="00:11:57.843" end="00:12:01.304" style="s1"><span style="s2">あれが エコヒイキで選ばれた<br />零号機パイロット</span></p> 
   <p begin="00:12:02.347" end="00:12:06.852" style="s1"><span style="s2">で？ どれが ナナヒカリで選ばれた<br />初号機パイロット？</span></p> 
   <p begin="00:12:07.185" end="00:12:08.520" style="s1"><span style="s2">（シンジ）あ… あの</span></p> 
   <p begin="00:12:08.728" end="00:12:09.729" style="s1"><span style="s2">ふ～ん</span></p> 
   <p begin="00:12:10.689" end="00:12:11.982" style="s1"><span style="s2">あんた バカ</span></p> 
   <p begin="00:12:12.065" end="00:12:14.985" style="s1"><span style="s2">肝心な時にいないなんて<br />なんて無自覚</span></p> 
   <p begin="00:12:16.069" end="00:12:17.279" style="s1"><span style="s2">（シンジ）わっ!？</span></p> 
   <p begin="00:12:17.362" end="00:12:18.738" style="s1"><span style="s2">おまけに無警戒</span></p> 
   <p begin="00:12:19.030" end="00:12:21.199" style="s1"><span style="s2">う うう…</span></p> 
   <p begin="00:12:21.533" end="00:12:24.536" style="s1"><span style="s2">エヴァで戦えなかったことを<br />ハジとも思わないなんて</span></p> 
   <p begin="00:12:24.703" end="00:12:26.580" style="s1"><span style="s2">（アスカ）所詮ナナヒカリね</span></p> 
   <p begin="00:12:26.663" end="00:12:27.664" style="s1"><span style="s2">（シンジ）あ…</span></p> 
   <p begin="00:12:28.206" end="00:12:29.374" style="s1"><span style="s2">フン…</span></p> 
   <p begin="00:12:29.583" end="00:12:33.170" style="s1"><span style="s2">まったく 何様や！　あの女<br />何ぬかしとんのや</span></p> 
   <p begin="00:12:34.421" end="00:12:39.384" style="s1"><span style="s2">それにしても同い歳にして<br />すでに大尉とはスゴイ　スゴすぎる</span></p> 
   <p begin="00:12:39.718" end="00:12:42.053" style="s1"><span style="s2">飛び級で大卒ってことでしょ</span></p> 
   <p begin="00:12:42.179" end="00:12:43.263" style="s1"><span style="s2">（加持）失礼</span></p> 
   <p begin="00:12:44.055" end="00:12:46.475" style="s1"><span style="s2">（加持）ジオフロントの<br />ハブターミナル行きは</span></p> 
   <p begin="00:12:46.558" end="00:12:47.851" style="s1"><span style="s2">この改札でいいのかな？</span></p> 
   <p begin="00:12:47.934" end="00:12:51.813" style="s1"><span style="s2">あ はい　４つ先の駅で<br />乗り換えがありますけど</span></p> 
   <p begin="00:12:52.731" end="00:12:56.776" style="s1"><span style="s2">たった２年離れただけで<br />ウラシマ太郎の気分だ…</span></p> 
   <p begin="00:12:57.235" end="00:12:59.029" style="s1"><span style="s2">ありがとう 助かったよ</span></p> 
   <p begin="00:12:59.529" end="00:13:02.073" style="s1"><span style="s2">ところで葛城は<br />一緒じゃないのかい？</span></p> 
   <p begin="00:13:03.742" end="00:13:05.410" style="s1"><span style="s2">古い友人さ</span></p> 
   <p begin="00:13:05.535" end="00:13:08.830" style="s1"><span style="s2">君だけが彼女の寝相の悪さを<br />知っているワケじゃないぞ</span></p> 
   <p begin="00:13:08.914" end="00:13:10.248" style="s1"><span style="s2">碇シンジ君</span></p> 
   <p begin="00:13:15.045" end="00:13:16.588" style="s1"><span style="s2">寝相って…</span></p> 
   <p begin="00:13:16.713" end="00:13:18.423" style="s1"><span style="s2">何や あいつ</span></p> 
   <p begin="00:13:18.757" end="00:13:21.092" style="s1"><span style="s2">イヤハヤ 大変な仕事でしたよ</span></p> 
   <p begin="00:13:21.885" end="00:13:25.764" style="s1"><span style="s2">（加持）<br />懸案の第３使徒とエヴァ５号機は<br />予定通り処理しました</span></p> 
   <p begin="00:13:26.097" end="00:13:28.558" style="s1"><span style="s2">（加持）原因はあくまで事故<br />ベタニアベースでの<span style="s7">―</span></span></p> 
   <p begin="00:13:28.642" end="00:13:31.144" style="s1"><span style="s2">マルドゥック計画は<br />これで<span style="s4"><span style="s5">頓挫</span><span style="s9">とんざ</span></span>します</span></p> 
   <p begin="00:13:31.436" end="00:13:33.605" style="s1"><span style="s2">全てあなたのシナリオ通りです</span></p> 
   <p begin="00:13:33.813" end="00:13:36.942" style="s1"><span style="s2">で いつものゼーレ最新資料は<br />先ほど<span style="s7">―</span></span></p> 
   <p begin="00:13:37.234" end="00:13:39.069" style="s1"><span style="s2">（冬月）拝見させてもらった</span></p> 
   <p begin="00:13:39.152" end="00:13:42.405" style="s1"><span style="s2"><span style="s4"><span style="s5">Mark</span><span style="s6">マーク</span></span>.<span style="s4"><span style="s5">06</span><span style="s6">シックス</span></span>建造の確証は<br />役に立ったよ</span></p> 
   <p begin="00:13:42.531" end="00:13:43.532" style="s1"><span style="s2">（加持）結構です</span></p> 
   <p begin="00:13:43.990" end="00:13:46.117" style="s1"><span style="s2">これがお約束の<span style="s4"><span style="s5">代物</span><span style="s6">しろもの</span></span>です</span></p> 
   <p begin="00:13:46.660" end="00:13:49.246" style="s1"><span style="s2">予備として保管されていた<br />ロストナンバー</span></p> 
   <p begin="00:13:49.329" end="00:13:50.789" style="s1"><span style="s2">（トランクのロックが外れる音）</span></p> 
   <p begin="00:13:51.915" end="00:13:55.126" style="s1"><span style="s2">神と魂を紡ぐ 道しるべですね</span></p> 
   <p begin="00:13:55.794" end="00:13:58.964" style="s1"><span style="s2">（ゲンドウ）<br />ああ 人類補完の扉を開く<span style="s7">―</span></span></p> 
   <p begin="00:13:59.798" end="00:14:02.133" style="s1"><span style="s2">ネブカドネザルの鍵だ</span></p> 
   <p begin="00:14:02.425" end="00:14:06.304" style="s1"><span style="s2">ではこれで しばらくは<br />好きにさせてもらいますよ</span></p> 
   <p begin="00:14:08.098" end="00:14:10.350" style="s1"><span style="s2">（ドアが閉まる音）</span></p> 
   <p begin="00:14:10.475" end="00:14:15.981" style="s1"><span style="s2">（冬月）<br />加持リョウジ首席監察官<br />信用に足る男かね？</span></p> 
   <p begin="00:14:19.025" end="00:14:20.318" style="s1"><span style="s2">はぁ…</span></p> 
   <p begin="00:14:23.655" end="00:14:25.991" style="s1"><span style="s2">少し痩せたかな リッちゃん</span></p> 
   <p begin="00:14:26.074" end="00:14:29.035" style="s1"><span style="s2">残念　1570グラムプラスよ</span></p> 
   <p begin="00:14:29.828" end="00:14:31.830" style="s1"><span style="s2">肉眼で確認したいな</span></p> 
   <p begin="00:14:31.955" end="00:14:34.666" style="s1"><span style="s2">いいけど<br />この部屋 監視されてるわよ</span></p> 
   <p begin="00:14:34.833" end="00:14:38.336" style="s1"><span style="s2">ノープロブレム<br />すでにダミー画像が走ってる</span></p> 
   <p begin="00:14:38.503" end="00:14:40.839" style="s1"><span style="s2">は… 相変わらず用意周到ね</span></p> 
   <p begin="00:14:41.006" end="00:14:43.008" style="s1"><span style="s2">負け戦が嫌いなだけさ</span></p> 
   <p begin="00:14:43.216" end="00:14:45.885" style="s1"><span style="s2">（リツコ）でも負けよ<br />（加持）ん？</span></p> 
   <p begin="00:14:46.052" end="00:14:48.722" style="s1"><span style="s2">（リツコ）<br />コワ～イお姉さんが見ているわ</span></p> 
   <p begin="00:14:48.888" end="00:14:50.390" style="s1"><span style="s2">ふん が～</span></p> 
   <p begin="00:14:50.473" end="00:14:52.309" style="s1"><span style="s2">リョウちゃん お久しぶり</span></p> 
   <p begin="00:14:52.392" end="00:14:53.852" style="s1"><span style="s2">や！ しばらく</span></p> 
   <p begin="00:14:54.185" end="00:14:58.064" style="s1"><span style="s2">（ミサト）<br />なんであんたが ここにいるのよ！<br />ユーロ担当でしょ</span></p> 
   <p begin="00:14:58.189" end="00:15:00.900" style="s1"><span style="s2">特命でね<br />しばらくは本部付きさ</span></p> 
   <p begin="00:15:01.192" end="00:15:04.195" style="s1"><span style="s2">また三人でつるめるな<br />学生の時みたいに</span></p> 
   <p begin="00:15:04.571" end="00:15:07.157" style="s1"><span style="s2">昔に還る気なんてないわよ！</span></p> 
   <p begin="00:15:07.240" end="00:15:09.659" style="s1"><span style="s2">私はリツコに<br />用があっただけなの！</span></p> 
   <p begin="00:15:09.743" end="00:15:12.829" style="s1"><span style="s2">アスカの件 人事部に<br />話 通しておいたから じゃ!!</span></p> 
   <p begin="00:15:12.912" end="00:15:15.040" style="s1"><span style="s2">（足音 扉を出る）</span></p> 
   <p begin="00:15:15.206" end="00:15:19.753" style="s1"><span style="s2">ミサト あからさまな嫉妬ね<br />リョウちゃん 勝算はあるわよ</span></p> 
   <p begin="00:15:20.211" end="00:15:22.213" style="s1"><span style="s2">はて どうかな</span></p> 
   <p begin="00:15:29.054" end="00:15:31.389" style="s1"><span style="s2">（シンジの声）式波･アスカ</span></p> 
   <p begin="00:15:32.515" end="00:15:35.226" style="s1"><span style="s2">エヴァに乗ってて<br />うれしいヒトもいるんだ</span></p> 
   <p begin="00:15:36.227" end="00:15:38.188" style="s1"><span style="s2">（シンジ）ただいまぁー…って</span></p> 
   <p begin="00:15:38.271" end="00:15:39.272" style="s1"><span style="s2">（シンジ）なんだこれ？</span></p> 
   <p begin="00:15:40.899" end="00:15:42.233" style="s1"><span style="s2">僕の部屋が…</span></p> 
   <p begin="00:15:42.400" end="00:15:43.902" style="s1"><span style="s2">（アスカ）失礼ねっ！</span></p> 
   <p begin="00:15:43.985" end="00:15:45.737" style="s1"><span style="s2">（アスカ）私の荷物よ<br />（シンジ）えっ…？</span></p> 
   <p begin="00:15:45.904" end="00:15:47.864" style="s1"><span style="s2">（シンジ）じゃあ僕のは？　あれ？<br />（アスカ）ぐびぐび</span></p> 
   <p begin="00:15:47.947" end="00:15:49.741" style="s1"><span style="s2">なんで 式波がココにいんの？</span></p> 
   <p begin="00:15:50.116" end="00:15:53.244" style="s1"><span style="s2">（アスカ）はぁ… あんたバカぁ？<br />（シンジ）ん？</span></p> 
   <p begin="00:15:53.578" end="00:15:55.747" style="s1"><span style="s2">あんた お払い箱ってことよ</span></p> 
   <p begin="00:15:56.373" end="00:16:00.460" style="s1"><span style="s2">ま どっちが優秀かを考えれば<br />当然の結論ね</span></p> 
   <p begin="00:16:00.585" end="00:16:01.878" style="s1"><span style="s2">（シンジ）そんな…</span></p> 
   <p begin="00:16:01.961" end="00:16:05.465" style="s1"><span style="s2">しかし どうしてこう<br />日本の部屋ってせまいのかしら</span></p> 
   <p begin="00:16:05.757" end="00:16:08.259" style="s1"><span style="s2">（アスカ）<br />荷物が半分も入りきらなかったわ</span></p> 
   <p begin="00:16:08.635" end="00:16:12.722" style="s1"><span style="s2">おまけに どうしてこう<br />日本人って危機感足りないのかしら</span></p> 
   <p begin="00:16:12.931" end="00:16:16.601" style="s1"><span style="s2">よくこんなカギのない部屋で<br />暮らせるわね 信じらんない</span></p> 
   <p begin="00:16:17.102" end="00:16:18.269" style="s1"><span style="s2">わぁ！</span></p> 
   <p begin="00:16:18.353" end="00:16:21.398" style="s1"><span style="s2">日本人の身上は<br />察しと思いやりだからよ</span></p> 
   <p begin="00:16:21.564" end="00:16:22.982" style="s1"><span style="s2">あ ミサトさん</span></p> 
   <p begin="00:16:23.108" end="00:16:24.401" style="s1"><span style="s2">うっとうしいわね</span></p> 
   <p begin="00:16:24.526" end="00:16:26.861" style="s1"><span style="s2">（アスカ）ゴミといっしょに<br />さっさと出ていきなさいよ</span></p> 
   <p begin="00:16:26.945" end="00:16:29.197" style="s1"><span style="s2">あらぁ<br />シンちゃんもココに残るのよ</span></p> 
   <p begin="00:16:29.280" end="00:16:30.323" style="s1"><span style="s2">ええー！</span></p> 
   <p begin="00:16:30.532" end="00:16:34.536" style="s1"><span style="s2">アスカとシンちゃんに足りないのは<br />適切なコミュニケーション</span></p> 
   <p begin="00:16:34.619" end="00:16:37.789" style="s1"><span style="s2">同じパイロット同士<br />同じ釜の飯を食って<span style="s7">―</span></span></p> 
   <p begin="00:16:37.872" end="00:16:39.499" style="s1"><span style="s2">仲良くしないとね</span></p> 
   <p begin="00:16:40.667" end="00:16:41.668" style="s1"><span style="s2">ふん！</span></p> 
   <p begin="00:16:41.835" end="00:16:43.294" style="s1"><span style="s2">これは命令よ</span></p> 
   <p begin="00:17:01.312" end="00:17:03.314" style="s1"><span style="s2">（ミサト）はい！ みんなで一緒に</span></p> 
   <p begin="00:17:03.481" end="00:17:05.483" style="s1"><span style="s2">（３人）ごちそーさまでした</span></p> 
   <p begin="00:17:05.650" end="00:17:08.361" style="s1"><span style="s2">んぐんぐんぐ…</span></p> 
   <p begin="00:17:08.486" end="00:17:11.156" style="s1"><span style="s2">ぷは～っ くぅー！</span></p> 
   <p begin="00:17:11.281" end="00:17:14.117" style="s1"><span style="s2">やっぱひとっ風呂浴びた後の<br />ビールは最高ね！</span></p> 
   <p begin="00:17:15.160" end="00:17:19.456" style="s1"><span style="s2">キャーァ！なっ なな なんか<br />変な生き物がおフロにいる～</span></p> 
   <p begin="00:17:20.749" end="00:17:21.499" style="s1"><span style="s2">（ミサトの楽しげな鼻歌）</span></p> 
   <p begin="00:17:21.499" end="00:17:21.958" style="s1"><span style="s2">（ミサトの楽しげな鼻歌）</span></p> 
   <p begin="00:17:21.499" end="00:17:21.958" region="縦右">（ペンペンの鳴き声）</p> 
   <p begin="00:17:21.958" end="00:17:22.542" region="縦右">（ペンペンの鳴き声）</p> 
   <p begin="00:17:22.625" end="00:17:24.127" style="s1"><span style="s2">（シンジ）ペンギンていう鳥だよ</span></p> 
   <p begin="00:17:24.210" end="00:17:25.462" style="s1"><span style="s2">名前はペンペン…</span></p> 
   <p begin="00:17:25.545" end="00:17:26.880" style="s1"><span style="s2">あ!？ んあっ…</span></p> 
   <p begin="00:17:27.213" end="00:17:28.381" style="s1"><span style="s2">ん？</span></p> 
   <p begin="00:17:29.507" end="00:17:30.675" style="s1"><span style="s2">うわッ!! ッつひッ</span></p> 
   <p begin="00:17:31.009" end="00:17:32.135" style="s1"><span style="s2">（アスカ）てぃっ！</span></p> 
   <p begin="00:17:31.009" end="00:17:32.135" region="縦右">（打撃音）</p> 
   <p begin="00:17:32.302" end="00:17:33.553" style="s1"><span style="s2">（シンジ）あうっ</span></p> 
   <p begin="00:17:34.512" end="00:17:36.055" style="s1"><span style="s2">（シンジ）ぐはぁ…</span></p> 
   <p begin="00:17:36.639" end="00:17:39.517" style="s1"><span style="s2">このエッチっ!! バカっ！<br />ヘンタイっ！信じらんない！</span></p> 
   <p begin="00:17:39.809" end="00:17:42.061" region="縦右" style="s3">（アスカ）だから<br />男の子って嫌いなのよ</p> 
   <p begin="00:17:39.809" end="00:17:42.061" style="s1"><span style="s2">（ミサト）<br />二人とも 素直になってきて<br />いい傾向じゃない</span></p> 
   <p begin="00:17:42.061" end="00:17:42.771" style="s1"><span style="s2">（ミサト）<br />二人とも 素直になってきて<br />いい傾向じゃない</span></p> 
   <p begin="00:17:42.854" end="00:17:44.022" style="s1"><span style="s2">（ミサト）ねぇペンペン</span></p> 
   <p begin="00:17:44.105" end="00:17:44.981" style="s1"><span style="s2">クワッ</span></p> 
   <p begin="00:17:52.238" end="00:17:56.034" style="s1"><span style="s2">（ミサトの高いびき）</span></p> 
   <p begin="00:17:57.535" end="00:18:02.207" style="s1"><span style="s2">（幼い<span style="s4"><span style="s5">声色</span><span style="s6">こわいろ</span></span>のアスカ）<br />あいつらとも違ぁあう<br />私は特別っ！</span></p> 
   <p begin="00:18:02.540" end="00:18:05.502" style="s1"><span style="s2">だから これからも<span style="s7">―</span></span></p> 
   <p begin="00:18:06.211" end="00:18:09.255" style="s1"><span style="s2">（素の声のアスカ）<br />一人でやるしかないのよ アスカ</span></p> 
   <p begin="00:18:19.224" end="00:18:26.731" style="s1"><span style="s2">（呼出し音）</span></p> 
   <p begin="00:18:31.069" end="00:18:33.863" style="s1"><span style="s2">やっぱり出ないや… 父さん</span></p> 
   <p begin="00:18:43.623" end="00:18:46.417" region="縦右" style="s3">♪～</p> 
   <p begin="00:18:46.751" end="00:19:57.822" region="縦右" style="s3">♪</p> 
   <p begin="00:19:58.239" end="00:19:58.281" region="縦右">～<span style="s3">♪</span></p> 
   <p begin="00:19:58.281" end="00:19:59.616" region="縦右">～<span style="s3">♪</span></p> 
   <p begin="00:19:58.281" end="00:19:59.616" style="s1"><span style="s2">社会科見学？　加持が？</span></p> 
   <p begin="00:19:59.616" end="00:20:00.658" style="s1"><span style="s2">社会科見学？　加持が？</span></p> 
   <p begin="00:20:00.825" end="00:20:03.161" style="s1"><span style="s2">ええ みんなのことも<br />誘うといいって</span></p> 
   <p begin="00:20:03.453" end="00:20:06.205" style="s1"><span style="s2">あいつにかかわると<br />ロクなことないわよ</span></p> 
   <p begin="00:20:06.331" end="00:20:08.207" style="s1"><span style="s2">（アスカ）<br />じゃあ あたしパ～ス</span></p> 
   <p begin="00:20:08.374" end="00:20:11.336" style="s1"><span style="s2">ダメよ<br />和を持って尊しとな～ス</span></p> 
   <p begin="00:20:11.669" end="00:20:12.754" style="s1"><span style="s2">アスカは行きなさい</span></p> 
   <p begin="00:20:13.129" end="00:20:14.839" style="s1"><span style="s2">それも命令？</span></p> 
   <p begin="00:20:23.056" end="00:20:26.309" style="s1"><span style="s2">（冬月）月面のタブハベースを<br />目前にしながら<span style="s7">―</span></span></p> 
   <p begin="00:20:26.392" end="00:20:31.189" style="s1"><span style="s2">上陸許可を出さんとは<br />ゼーレもえげつないことをする</span></p> 
   <p begin="00:20:31.522" end="00:20:36.486" style="s1"><span style="s2">（ゲンドウ）<br />Mark.06の建造方式が<br />他とは違う その確認で十分だ</span></p> 
   <p begin="00:20:37.695" end="00:20:41.074" style="s1"><span style="s2">しかし ５号機以降の計画など<br />なかったはずだぞ</span></p> 
   <p begin="00:20:41.532" end="00:20:45.745" style="s1"><span style="s2">おそらく 開示されていない<br />死海文書の外典がある</span></p> 
   <p begin="00:20:45.995" end="00:20:49.540" style="s1"><span style="s2">ゼーレは それに基づいた<br />シナリオを進めるつもりだ</span></p> 
   <p begin="00:20:50.667" end="00:20:53.711" style="s1"><span style="s2">（冬月）だが ゼーレとて<br />気づいているのだろう？</span></p> 
   <p begin="00:20:53.836" end="00:20:55.964" style="s1"><span style="s2">（冬月）ネルフ究極の目的に</span></p> 
   <p begin="00:20:56.047" end="00:21:00.551" style="s1"><span style="s2">そうだとしても<br />我々は我々の道をゆくだけだ</span></p> 
   <p begin="00:21:00.927" end="00:21:04.389" style="s1"><span style="s2">たとえ<br />神の<span style="s4"><span style="s5">理</span><span style="s9">ことわり</span></span>と敵対することになろうとも</span></p> 
   <p begin="00:21:10.061" end="00:21:12.188" style="s1"><span style="s2">ヒトか？ …まさかな</span></p> 
   <p begin="00:21:13.898" end="00:21:16.859" style="s1"><span style="s2">（カヲル）はじめまして お父さん</span></p> 
   <p begin="00:21:17.944" end="00:21:19.862" style="s1"><span style="s2">（ケンスケ）<br />すごい！ すごすぎるっ!!</span></p> 
   <p begin="00:21:20.196" end="00:21:22.615" style="s1"><span style="s2">（ケンスケ）<br />失われた海洋生物の永久保存と</span></p> 
   <p begin="00:21:22.740" end="00:21:25.535" style="s1"><span style="s2">赤く染まった海を<br />元の姿に戻すという<span style="s7">―</span></span></p> 
   <p begin="00:21:25.618" end="00:21:29.580" style="s1"><span style="s2">まさに神のごとき<br />大実験計画を担う禁断の聖地！</span></p> 
   <p begin="00:21:29.706" end="00:21:32.959" style="s1"><span style="s2">その表層の一部だけでも<br />見学出来るとは！</span></p> 
   <p begin="00:21:33.084" end="00:21:35.712" style="s1"><span style="s2">まさに<br />持つべきものは友達って感じ</span></p> 
   <p begin="00:21:35.795" end="00:21:37.588" style="s1"><span style="s2">ホンマ感謝すんで</span></p> 
   <p begin="00:21:37.964" end="00:21:39.841" style="s1"><span style="s2">お礼だったら加持さんに言ってよ</span></p> 
   <p begin="00:21:40.967" end="00:21:43.678" style="s1"><span style="s2">（加持）最もこっからが<br />ちょいとめんどうだけどな</span></p> 
   <p begin="00:21:43.761" end="00:21:44.762" style="s1"><span style="s2">は？</span></p> 
   <p begin="00:21:52.311" end="00:21:54.147" style="s1"><span style="s2">（各々）アチチチ</span></p> 
   <p begin="00:21:55.440" end="00:21:57.275" style="s1"><span style="s2">（シンジ）ゴボガボ　くるしい</span></p> 
   <p begin="00:21:58.568" end="00:22:00.611" style="s1"><span style="s2">んググググ～ ブルブル</span></p> 
   <p begin="00:21:58.568" end="00:22:00.611" region="縦右">（ペンペン）<br />ギャッ！ ギャッ！</p> 
   <p begin="00:22:01.821" end="00:22:03.656" style="s1"><span style="s2">（トウジ）ゴボボッボ　またかいな</span></p> 
   <p begin="00:22:04.949" end="00:22:06.576" style="s1"><span style="s2">（アスカ）いや～っ</span></p> 
   <p begin="00:22:07.910" end="00:22:09.662" style="s1"><span style="s2">（ケンスケ）<br />もうだめ　ゴポゴポ…</span></p> 
   <p begin="00:22:09.829" end="00:22:11.330" style="s1"><span style="s2">（出来あがりのベル）</span></p> 
   <p begin="00:22:13.833" end="00:22:14.834" style="s1"><span style="s2">（一同）あ!？</span></p> 
   <p begin="00:22:17.628" end="00:22:19.964" style="s1"><span style="s2">（トウジ）ヒョォ～ホホッ！<br />でっかい水槽やなぁ！</span></p> 
   <p begin="00:22:20.048" end="00:22:21.049" style="s1"><span style="s2">（シンジ）すごい！</span></p> 
   <p begin="00:22:23.009" end="00:22:24.135" style="s1"><span style="s2">（トウジ）あん？</span></p> 
   <p begin="00:22:24.469" end="00:22:27.764" style="s1"><span style="s2">（シンジ）<br />これがセカンドインパクト前の<br />生き物なんですか！</span></p> 
   <p begin="00:22:30.475" end="00:22:33.519" style="s1"><span style="s2">（ペンギン語）</span></p> 
   <p begin="00:22:34.187" end="00:22:36.314" style="s1"><span style="s2">（ペンギンの拍手）</span></p> 
   <p begin="00:22:36.647" end="00:22:38.691" style="s1"><span style="s2">（トウジ）ほえ～ 生きとる！</span></p> 
   <p begin="00:22:38.775" end="00:22:40.943" style="s1"><span style="s2">（ケンスケ）<br />すごい！ すごすぎる！</span></p> 
   <p begin="00:22:41.152" end="00:22:43.988" style="s1"><span style="s2">（トウジ）おおっ背中になんか<br />背負ったヤツもおるぞ！</span></p> 
   <p begin="00:22:44.072" end="00:22:45.990" style="s1"><span style="s2">（ケンスケ）亀って言うらしいよ<br />（トウジ）カメ？</span></p> 
   <p begin="00:22:46.115" end="00:22:49.660" style="s1"><span style="s2">子供がはしゃいじゃって<br />バッカみたいー</span></p> 
   <p begin="00:22:50.995" end="00:22:52.205" style="s1"><span style="s2">（アスカ）あ…</span></p> 
   <p begin="00:22:54.207" end="00:22:55.458" style="s1"><span style="s2">フン</span></p> 
   <p begin="00:23:00.129" end="00:23:03.966" style="s1"><span style="s2">（シンジ）<br />綾波も来れてよかった<br />身体 もういいの？</span></p> 
   <p begin="00:23:04.342" end="00:23:08.179" style="s1"><span style="s2">（レイ）ええ<br />ノルマ終わったから 今日はいいの</span></p> 
   <p begin="00:23:10.306" end="00:23:14.185" style="s1"><span style="s2">狭いなあ もっと広いとこで<br />泳げばいいのに</span></p> 
   <p begin="00:23:14.644" end="00:23:18.856" style="s1"><span style="s2">無理 この子たちは<br />この中でしか生きられないもの</span></p> 
   <p begin="00:23:20.024" end="00:23:21.400" style="s1"><span style="s2">私と同じ</span></p> 
   <p begin="00:23:30.368" end="00:23:32.078" style="s1"><span style="s2">（一同）いっただーきまーす</span></p> 
   <p begin="00:23:32.328" end="00:23:33.871" style="s1"><span style="s2">（アスカ）ん！<br />（ケンスケ･トウジ）んん！</span></p> 
   <p begin="00:23:34.038" end="00:23:35.790" style="s1"><span style="s2">（アスカ）意外 ウマイわね</span></p> 
   <p begin="00:23:35.873" end="00:23:38.709" style="s1"><span style="s2">（加持）<br />ああ見事な焼き方と味付けだなぁ</span></p> 
   <p begin="00:23:39.043" end="00:23:42.880" style="s1"><span style="s2">（ケンスケ）<br />あの九割人造肉が 調理しだいで<br />こうもおいしくなるとは…</span></p> 
   <p begin="00:23:43.047" end="00:23:44.715" style="s1"><span style="s2">まさに<span style="s4"><span style="s5">驚愕</span><span style="s6">きょうがく</span></span>だよ</span></p> 
   <p begin="00:23:44.799" end="00:23:47.260" style="s1"><span style="s2">（トウジ）<br />シンジ 隠れた才能やな</span></p> 
   <p begin="00:23:47.385" end="00:23:50.388" style="s1"><span style="s2">ミサトさん<br />いつもレトルトばかりだから…</span></p> 
   <p begin="00:23:50.555" end="00:23:51.931" style="s1"><span style="s2">僕が作るしかないんだ</span></p> 
   <p begin="00:23:52.223" end="00:23:55.184" style="s1"><span style="s2">シンジ君<br />台所に立つ男はモテるぞ</span></p> 
   <p begin="00:23:55.393" end="00:23:56.686" style="s1"><span style="s2">だってさ！</span></p> 
   <p begin="00:23:56.769" end="00:23:59.772" style="s1"><span style="s2">いや ワシは 立たんぞ！<br />男のすることやない</span></p> 
   <p begin="00:23:59.897" end="00:24:02.233" style="s1"><span style="s2">前時代的 バッカみたい</span></p> 
   <p begin="00:24:02.358" end="00:24:05.027" style="s1"><span style="s2">なんやと！<br />ポリシーは大事なもんなんやで！</span></p> 
   <p begin="00:24:05.111" end="00:24:06.487" style="s1"><span style="s2">（アスカ）ますますバカっぽい</span></p> 
   <p begin="00:24:06.571" end="00:24:08.406" style="s1"><span style="s2">（シンジ）<br />いいから食べてよ食べてよ</span></p> 
   <p begin="00:24:06.571" end="00:24:08.406" region="縦右">（トウジ）なんやとぉ<span style="s10">!?</span></p> 
   <p begin="00:24:10.533" end="00:24:12.618" style="s1"><span style="s2">（ペンペン）<br />クァフ クァフ クァフ</span></p> 
   <p begin="00:24:13.911" end="00:24:16.414" style="s1"><span style="s2">ごめん 綾波<br />口に合わなかったかな？</span></p> 
   <p begin="00:24:17.081" end="00:24:19.250" style="s1"><span style="s2">いいえ 肉 食べないだけ</span></p> 
   <p begin="00:24:19.584" end="00:24:22.628" style="s1"><span style="s2">（アスカ）なんで 悪くもないのに<br />謝んのよ！ 日本人は</span></p> 
   <p begin="00:24:22.879" end="00:24:24.213" style="s1"><span style="s2">それに あんたねぇ！</span></p> 
   <p begin="00:24:24.297" end="00:24:26.090" style="s1"><span style="s2">生き物は生き物<br />食べて生きてんのよ</span></p> 
   <p begin="00:24:26.424" end="00:24:29.385" style="s1"><span style="s2">せっかくの命は<br />全部もれなく食べ尽くしなさいよ</span></p> 
   <p begin="00:24:30.636" end="00:24:31.971" style="s1"><span style="s2">（ペンペン）ククッ…</span></p> 
   <p begin="00:24:32.221" end="00:24:33.973" style="s1"><span style="s2">エコヒイキ！ ケンカ売る気!？</span></p> 
   <p begin="00:24:35.892" end="00:24:38.769" style="s1"><span style="s2">（トウジ）へ～<br />チョイチョイチョイっと…</span></p> 
   <p begin="00:24:39.103" end="00:24:40.813" style="s1"><span style="s2">（トウジ）<br />そなら ワシが遠慮のう…</span></p> 
   <p begin="00:24:40.938" end="00:24:42.273" style="s1"><span style="s2">（ペンペン）<br />ンギャ ギャッ ゴゴゴ！</span></p> 
   <p begin="00:24:42.398" end="00:24:43.858" style="s1"><span style="s2">（トウジ）なんや？ やらへんぞ！</span></p> 
   <p begin="00:24:43.941" end="00:24:46.110" style="s1"><span style="s2">…いやしいやっちゃな<br />もう 来んな！</span></p> 
   <p begin="00:24:46.319" end="00:24:48.196" style="s1"><span style="s2">（トウジ）アホぉ！<br />（ペンペン）ンホォ～っ！</span></p> 
   <p begin="00:24:48.279" end="00:24:49.947" style="s1"><span style="s2">（アスカ）バッカみたい！</span></p> 
   <p begin="00:24:50.948" end="00:24:52.950" style="s1"><span style="s2">（シンジ）<br />じゃあ みそ汁はどう？</span></p> 
   <p begin="00:24:56.621" end="00:24:57.955" style="s1"><span style="s2">あったまるよ</span></p> 
   <p begin="00:25:09.592" end="00:25:10.760" style="s1"><span style="s2">（レイ）おいしい…</span></p> 
   <p begin="00:25:11.761" end="00:25:16.682" style="s1"><span style="s2">これが母なる大地とは<br />痛ましくて 見ておれんよ</span></p> 
   <p begin="00:25:17.600" end="00:25:21.354" style="s1"><span style="s2">（ゲンドウ）だがしかし<br />この惨状を願った者たちもいる</span></p> 
   <p begin="00:25:22.313" end="00:25:24.315" style="s1"><span style="s2">（ゲンドウ）<br />ヒトさえ立ち入ることの出来ぬ<span style="s7">―</span></span></p> 
   <p begin="00:25:24.649" end="00:25:28.319" style="s1"><span style="s2">原罪のけがれなき<br />浄化された世界だからな</span></p> 
   <p begin="00:25:28.486" end="00:25:32.823" style="s1"><span style="s2">私は ヒトでケガれた<br />混沌とした世界を望むよ</span></p> 
   <p begin="00:25:33.032" end="00:25:35.493" style="s1"><span style="s2">カオスはヒトの印象にすぎない</span></p> 
   <p begin="00:25:35.826" end="00:25:39.038" style="s1"><span style="s2">世界は全て<br />調和と秩序で成り立っている</span></p> 
   <p begin="00:25:39.664" end="00:25:43.251" style="s1"><span style="s2">（冬月）<br />ヒトの心が 世界を乱すか…</span></p> 
   <p begin="00:25:45.336" end="00:25:50.258" style="s1"><span style="s2">（シンジ）<br />僕が生まれる前は この海が<br />青かったなんて 想像出来ません</span></p> 
   <p begin="00:25:50.341" end="00:25:54.971" style="s1"><span style="s2">（加持）<br />こうしてヒトが生きていける環境<br />だけでも よくも復元出来たものさ</span></p> 
   <p begin="00:25:55.471" end="00:25:57.139" style="s1"><span style="s2">（シンジ）<br />でも この潮風って…</span></p> 
   <p begin="00:25:57.139" end="00:25:58.182" style="s1"><span style="s2">（シンジ）<br />でも この潮風って…</span></p> 
   <p begin="00:25:57.139" end="00:25:58.182" region="縦右">（シンジの匂い嗅ぐ音）</p> 
   <p begin="00:25:58.474" end="00:26:01.227" style="s1"><span style="s2">なんだか生ぐさい<br />変なニオイがしますね</span></p> 
   <p begin="00:26:01.560" end="00:26:06.023" style="s1"><span style="s2">（加持）<br />海の生物が腐った匂いだ<br />生きていた証なのさ</span></p> 
   <p begin="00:26:06.649" end="00:26:11.570" style="s1"><span style="s2">（加持）<br />あの何もない 赤い水とは違う<br />本当の海の姿なんだよ</span></p> 
   <p begin="00:26:12.488" end="00:26:16.993" style="s1"><span style="s2">（加持）本来 この世界は広くて<br />色んな生命に満ち満ちている</span></p> 
   <p begin="00:26:17.243" end="00:26:20.204" style="s1"><span style="s2">そのことを 君らに<br />知っておいて欲しかったんだ</span></p> 
   <p begin="00:26:20.705" end="00:26:22.206" style="s1"><span style="s2">（シンジ）<br />なんか うれしいです</span></p> 
   <p begin="00:26:22.707" end="00:26:24.875" style="s1"><span style="s2">ミサトさんも<br />来ればよかったのに</span></p> 
   <p begin="00:26:25.167" end="00:26:28.421" style="s1"><span style="s2">葛城は来ないよ<br />思い出すからな</span></p> 
   <p begin="00:26:28.879" end="00:26:29.922" style="s1"><span style="s2">何をですか？</span></p> 
   <p begin="00:26:31.173" end="00:26:32.800" style="s1"><span style="s2">…セカンドインパクト</span></p> 
   <p begin="00:26:33.050" end="00:26:36.220" region="縦右" style="s3">♪～</p> 
   <p begin="00:26:36.387" end="00:27:17.428" region="縦右" style="s3">♪</p> 
   <p begin="00:27:17.428" end="00:27:20.931" region="縦右" style="s3">♪</p> 
   <p begin="00:27:17.428" end="00:27:20.931" style="s1"><span style="s2">葛城が 何故ネルフに入ったか<br />聞いたかい？</span></p> 
   <p begin="00:27:20.931" end="00:27:22.391" region="縦右" style="s3">♪</p> 
   <p begin="00:27:22.391" end="00:27:27.772" region="縦右" style="s3">♪</p> 
   <p begin="00:27:22.391" end="00:27:27.772" style="s1"><span style="s2">葛城の父親は 自分の研究<br />夢の中に生きる人だったそうだ</span></p> 
   <p begin="00:27:27.772" end="00:27:28.773" region="縦右" style="s3">♪</p> 
   <p begin="00:27:28.773" end="00:27:33.944" region="縦右" style="s3">♪</p> 
   <p begin="00:27:28.773" end="00:27:33.944" style="s1"><span style="s2">彼女はそんな父親を嫌ってた<br />憎んでさえいたと思う</span></p> 
   <p begin="00:27:33.944" end="00:27:34.153" region="縦右" style="s3">♪</p> 
   <p begin="00:27:34.153" end="00:27:37.156" region="縦右" style="s3">♪</p> 
   <p begin="00:27:34.153" end="00:27:37.156" style="s1"><span style="s2">苦手なのね お父さんが<br />私と同じね</span></p> 
   <p begin="00:27:37.156" end="00:27:37.948" region="縦右" style="s3">♪</p> 
   <p begin="00:27:37.948" end="00:27:39.617" region="縦右" style="s3">♪</p> 
   <p begin="00:27:37.948" end="00:27:39.617" style="s1"><span style="s2">…僕と同じだ</span></p> 
   <p begin="00:27:39.617" end="00:27:40.451" region="縦右" style="s3">♪</p> 
   <p begin="00:27:40.451" end="00:27:44.622" region="縦右" style="s3">♪</p> 
   <p begin="00:27:40.451" end="00:27:44.622" style="s1"><span style="s2">（加持）だが… 最後は<br />その父親に助けられた</span></p> 
   <p begin="00:27:44.622" end="00:27:45.956" region="縦右" style="s3">♪</p> 
   <p begin="00:27:45.956" end="00:27:48.793" region="縦右" style="s3">♪</p> 
   <p begin="00:27:45.956" end="00:27:48.793" style="s1"><span style="s2">（加持）生き残るっていうのは<br />色んな意味を持つ</span></p> 
   <p begin="00:27:48.793" end="00:27:49.502" region="縦右" style="s3">♪</p> 
   <p begin="00:27:49.502" end="00:27:53.839" region="縦右" style="s3">♪</p> 
   <p begin="00:27:49.502" end="00:27:53.839" style="s1"><span style="s2">（加持）<br />死んだ人の犠牲を受け止め<br />意志を受け継がなきゃいけない</span></p> 
   <p begin="00:27:53.839" end="00:27:54.465" region="縦右" style="s3">♪</p> 
   <p begin="00:27:54.465" end="00:27:56.842" region="縦右" style="s3">♪</p> 
   <p begin="00:27:54.465" end="00:27:56.842" style="s1"><span style="s2">（加持）<br />それが一人だったら なおさらだ</span></p> 
   <p begin="00:27:58.135" end="00:28:00.346" style="s1"><span style="s2">つらいのは 君だけじゃない</span></p> 
   <p begin="00:27:58.135" end="00:28:00.346" region="縦右" style="s3">～♪</p> 
   <p begin="00:28:00.346" end="00:28:02.139" region="縦右" style="s3">～♪</p> 
   <p begin="00:28:06.268" end="00:28:10.815" style="s1"><span style="s2">３分前にマウナケア観測所で捕捉<br />現在 軌道要素を入力中</span></p> 
   <p begin="00:28:10.940" end="00:28:13.776" style="s1"><span style="s2">目標を 第３監視衛星が<br />光学で捉えました</span></p> 
   <p begin="00:28:13.984" end="00:28:15.152" style="s1"><span style="s2">最大望遠で出します</span></p> 
   <p begin="00:28:16.654" end="00:28:17.863" style="s1"><span style="s2">（一同）おお…</span></p> 
   <p begin="00:28:18.322" end="00:28:20.825" style="s1"><span style="s2">光をゆがめる程の<br />Ａ.Ｔ.フィールドとは</span></p> 
   <p begin="00:28:20.908" end="00:28:22.118" style="s1"><span style="s2">おそれいるわね</span></p> 
   <p begin="00:28:22.535" end="00:28:24.954" style="s1"><span style="s2">で 落下予測地点は？</span></p> 
   <p begin="00:28:25.996" end="00:28:27.998" style="s1"><span style="s2">とうぜん ココよね</span></p> 
   <p begin="00:28:28.165" end="00:28:32.336" style="s1"><span style="s2">マギも再計算 ネルフ本部への<br />命中確率 シックスナインです</span></p> 
   <p begin="00:28:32.503" end="00:28:33.504" style="s1"><span style="s2">ちっ…</span></p> 
   <p begin="00:28:39.635" end="00:28:42.346" style="s1"><span style="s2">（日向）Ｎ２航空爆雷も<br />まるで効いてません</span></p> 
   <p begin="00:28:42.513" end="00:28:44.390" style="s1"><span style="s2">軌道修正は不可能か…</span></p> 
   <p begin="00:28:44.515" end="00:28:47.476" style="s1"><span style="s2">Ａ.Ｔ.フィールドを<br />一極集中して押し出してますから</span></p> 
   <p begin="00:28:47.852" end="00:28:50.229" style="s1"><span style="s2">これに落下のエネルギーも<br />加算されます</span></p> 
   <p begin="00:28:50.521" end="00:28:53.190" style="s1"><span style="s2">まさに使徒そのものが<br />爆弾というわけね</span></p> 
   <p begin="00:28:53.482" end="00:28:57.695" style="s1"><span style="s2">第８使徒 直撃時の<br />爆災推定規模は直径42万…</span></p> 
   <p begin="00:28:57.903" end="00:29:00.364" style="s1"><span style="s2">ジオイドマイナス１万５千レベル</span></p> 
   <p begin="00:29:00.531" end="00:29:02.616" style="s1"><span style="s2">第３新東京市は蒸発</span></p> 
   <p begin="00:29:02.700" end="00:29:06.203" style="s1"><span style="s2">ジオフロントどころか<br />セントラルドグマが丸裸にされます</span></p> 
   <p begin="00:29:06.537" end="00:29:07.538" style="s1"><span style="s2">碇司令は？</span></p> 
   <p begin="00:29:07.663" end="00:29:10.374" style="s1"><span style="s2">使徒の影響で<br />大気上層の電波が不安定です</span></p> 
   <p begin="00:29:10.541" end="00:29:12.543" style="s1"><span style="s2">現在 連絡不能</span></p> 
   <p begin="00:29:13.043" end="00:29:15.337" style="s1"><span style="s2">ここで独自に判断するしかないわね</span></p> 
   <p begin="00:29:17.840" end="00:29:20.551" style="s1"><span style="s2">日本国政府 及び各省に通達</span></p> 
   <p begin="00:29:20.676" end="00:29:24.180" style="s1"><span style="s2">ネルフ権限における<br />特別宣言Ｄ‐17を発令</span></p> 
   <p begin="00:29:24.346" end="00:29:27.933" style="s1"><span style="s2">半径120キロ内の全市民は<br />速やかに避難を開始</span></p> 
   <p begin="00:29:28.184" end="00:29:29.393" style="s1"><span style="s2">（青葉）問題ありません</span></p> 
   <p begin="00:29:29.560" end="00:29:33.063" style="s1"><span style="s2">すでに政府関係者から<br />我先に避難を始めてますよ</span></p> 
   <p begin="00:29:47.703" end="00:29:50.915" style="s1"><span style="s2">（アナウンス）市内における<br />民間人の避難は全て完了</span></p> 
   <p begin="00:29:51.040" end="00:29:56.962" style="s1"><span style="s2">部内警報Ｃによる 非戦闘員 及び<br />Ｄ級勤務者の退避 完了しました</span></p> 
   <p begin="00:29:57.129" end="00:29:59.715" style="s1"><span style="s2">マギのバックアップは<br />松代に頼みました</span></p> 
   <p begin="00:29:59.924" end="00:30:01.550" style="s1"><span style="s2">（リツコ）<br />で どうするつもり？</span></p> 
   <p begin="00:30:01.800" end="00:30:04.762" style="s1"><span style="s2">（青葉）<br />いくらエヴァといったって<br />空が飛べるわけではないですし</span></p> 
   <p begin="00:30:05.262" end="00:30:06.722" style="s1"><span style="s2">（作戦課員）<br />空間の歪みがひどく<span style="s7">―</span></span></p> 
   <p begin="00:30:06.805" end="00:30:08.933" style="s1"><span style="s2">あらゆるポイントからの狙撃も<br />不可能です</span></p> 
   <p begin="00:30:09.099" end="00:30:12.478" style="s1"><span style="s2">（日向）<br />こんなベラボーな相手じゃ<br />手の打ちようがありませんよ</span></p> 
   <p begin="00:30:18.609" end="00:30:19.735" style="s1"><span style="s2">（リツコ）本気なの？</span></p> 
   <p begin="00:30:19.818" end="00:30:21.237" style="s1"><span style="s2">（ミサト）ええ そうよ</span></p> 
   <p begin="00:30:21.320" end="00:30:23.614" style="s1"><span style="s2">（リツコ）<br />作戦といえるの？ このプランが</span></p> 
   <p begin="00:30:24.073" end="00:30:27.785" style="s1"><span style="s2">マギの検証でも<br />しくじる確率は99％強</span></p> 
   <p begin="00:30:27.952" end="00:30:30.829" style="s1"><span style="s2">たとえ成功しても<br />エヴァ３体を喪失…</span></p> 
   <p begin="00:30:31.288" end="00:30:33.832" style="s1"><span style="s2">技術部として<br />到底受けいれられません</span></p> 
   <p begin="00:30:33.999" end="00:30:35.751" style="s1"><span style="s2">（ミサト）<br />可能性ゼロではないわ</span></p> 
   <p begin="00:30:36.126" end="00:30:38.629" style="s1"><span style="s2">奇跡を待つより 地道な努力よ</span></p> 
   <p begin="00:30:38.796" end="00:30:41.340" style="s1"><span style="s2">リリスと初号機の保護を<br />最優先とすべきです</span></p> 
   <p begin="00:30:41.590" end="00:30:44.969" style="s1"><span style="s2">（ミサト）待つ気はないわ<br />奇跡を起こすのよ ヒトの意志で</span></p> 
   <p begin="00:30:45.094" end="00:30:46.804" style="s1"><span style="s2">葛城一佐！</span></p> 
   <p begin="00:30:47.012" end="00:30:48.764" style="s1"><span style="s2">現責任者は私です</span></p> 
   <p begin="00:30:49.473" end="00:30:52.309" style="s1"><span style="s2">私が判断するわ それに…</span></p> 
   <p begin="00:30:52.476" end="00:30:54.979" style="s1"><span style="s2">使徒殲滅が 私の仕事です</span></p> 
   <p begin="00:30:55.145" end="00:30:59.817" style="s1"><span style="s2">（リツコ）仕事？ <span style="s4"><span style="s5">私怨</span><span style="s6">しえん</span></span>でしょ？<br />あなたの使徒への復讐は</span></p> 
   <p begin="00:31:00.609" end="00:31:02.903" style="s1"><span style="s2">（アスカ）えーっ!!<br />手で 受けとめるう～？</span></p> 
   <p begin="00:31:03.028" end="00:31:04.863" style="s1"><span style="s2">（ミサト）<br />そうよ 飛来する使徒を<span style="s7">―</span></span></p> 
   <p begin="00:31:04.989" end="00:31:07.700" style="s1"><span style="s2">エヴァのＡ.Ｔ.フィールド全開で<br />直接受け止めるの</span></p> 
   <p begin="00:31:08.033" end="00:31:10.202" style="s1"><span style="s2">目標は<br />位置情報を攪乱しているから<span style="s7">―</span></span></p> 
   <p begin="00:31:10.327" end="00:31:13.455" style="s1"><span style="s2">補償観測による<br />正確な弾道計算は期待出来ないわ</span></p> 
   <p begin="00:31:13.539" end="00:31:16.542" style="s1"><span style="s2">状況に応じて<br />多角的に対処するため</span></p> 
   <p begin="00:31:16.667" end="00:31:19.461" style="s1"><span style="s2">本作戦は エヴァ３機の<br />同時展開とします</span></p> 
   <p begin="00:31:19.545" end="00:31:22.131" style="s1"><span style="s2">無駄よ！<br />私一人で殲滅出来るもん</span></p> 
   <p begin="00:31:22.214" end="00:31:24.216" style="s1"><span style="s2">無理よ エヴァ単機では<span style="s7">―</span></span></p> 
   <p begin="00:31:24.383" end="00:31:27.886" style="s1"><span style="s2">広大な落下予測範囲全域を<br />カバー出来ないわ</span></p> 
   <p begin="00:31:28.512" end="00:31:29.888" style="s1"><span style="s2">この配置の根拠は？</span></p> 
   <p begin="00:31:30.222" end="00:31:31.223" style="s1"><span style="s2">女のカンよ</span></p> 
   <p begin="00:31:31.390" end="00:31:32.850" style="s1"><span style="s2">なんたるアバウト</span></p> 
   <p begin="00:31:33.350" end="00:31:35.019" style="s1"><span style="s2">あの 勝算は？</span></p> 
   <p begin="00:31:35.227" end="00:31:36.895" style="s1"><span style="s2">神のみぞ知るってところね</span></p> 
   <p begin="00:31:37.187" end="00:31:39.940" style="s1"><span style="s2">ふん！だから<br />他のエヴァはジャマなの！</span></p> 
   <p begin="00:31:40.065" end="00:31:43.068" style="s1"><span style="s2">人類を守るくらい<br />私一人で十分よ！</span></p> 
   <p begin="00:31:43.277" end="00:31:44.945" style="s1"><span style="s2">（ミサト）<br />このオペに必要なのは<span style="s7">―</span></span></p> 
   <p begin="00:31:45.029" end="00:31:47.031" style="s1"><span style="s2">シングルコンバットの<br />成績じゃないの</span></p> 
   <p begin="00:31:47.239" end="00:31:49.366" style="s1"><span style="s2">私の才能を認めないわけね</span></p> 
   <p begin="00:31:49.491" end="00:31:53.912" style="s1"><span style="s2">違うわ<br />あなたたち三人の力が必要なのよ</span></p> 
   <p begin="00:31:54.204" end="00:31:55.414" style="s1"><span style="s2">奇跡を起こすために</span></p> 
   <p begin="00:31:55.539" end="00:31:58.584" style="s1"><span style="s2">（オペレーター）<br />エヴァ全機 ライブ電源稼働中</span></p> 
   <p begin="00:31:58.751" end="00:32:03.339" style="s1"><span style="s2">（交錯するオペレーターの報告）</span></p> 
   <p begin="00:32:03.422" end="00:32:06.592" style="s1"><span style="s2">（男性オペレーター）<br />新御殿場変電所との<br />接続を完了 投入開始</span></p> 
   <p begin="00:32:06.717" end="00:32:09.845" style="s1"><span style="s2">（女性オペレーター）<br />零号機の体内充電率<br />105％を突破</span></p> 
   <p begin="00:32:09.928" end="00:32:12.014" style="s1"><span style="s2">（女性オペレーター）<br />予備電源延長ケーブルが到着</span></p> 
   <p begin="00:32:12.222" end="00:32:15.225" style="s1"><span style="s2">（女性オペレーター）第８班は<br />接続作業を急いでください</span></p> 
   <p begin="00:32:16.060" end="00:32:18.729" style="s1"><span style="s2">（女性オペレーター）初号機の<br />コネクタリンクを確認 異常なし</span></p> 
   <p begin="00:32:18.854" end="00:32:22.524" style="s1"><span style="s2">各パイロットは待機中<br />呼吸および心拍数は正常</span></p> 
   <p begin="00:32:22.608" end="00:32:24.777" style="s1"><span style="s2">医学最終チェック 問題なし</span></p> 
   <p begin="00:32:26.362" end="00:32:30.074" style="s1"><span style="s2">（シンジ）<br />エヴァの中… なんでだろう…</span></p> 
   <p begin="00:32:30.240" end="00:32:35.412" style="s1"><span style="s2">こんな時なのに妙に落ちつく<br />もう乗ってるのが当たり前なのかな</span></p> 
   <p begin="00:32:36.580" end="00:32:40.626" style="s1"><span style="s2">なんでだろう…<br />なつかしい感じがする…</span></p> 
   <p begin="00:32:41.085" end="00:32:42.711" style="s1"><span style="s2">匂い？</span></p> 
   <p begin="00:32:42.795" end="00:32:44.546" style="s1"><span style="s2">母さんの匂い？</span></p> 
   <p begin="00:32:45.756" end="00:32:46.965" style="s1"><span style="s2">綾波の匂い？</span></p> 
   <p begin="00:32:47.633" end="00:32:49.343" style="s1"><span style="s2">（女性オペレーター）<br />現在 目標の軌道を計算中</span></p> 
   <p begin="00:32:49.426" end="00:32:50.969" style="s1"><span style="s2">（女性オペレーター）<br />野辺山の追尾電波 観測誤差…</span></p> 
   <p begin="00:32:51.053" end="00:32:52.638" style="s1"><span style="s2">おいでなすったわね</span></p> 
   <p begin="00:32:53.097" end="00:32:54.807" style="s1"><span style="s2">エヴァ全機 スタート位置</span></p> 
   <p begin="00:33:01.772" end="00:33:03.941" style="s1"><span style="s2">（ミサト）２次的データが<br />あてにならない以上<span style="s7">―</span></span></p> 
   <p begin="00:33:04.024" end="00:33:06.985" style="s1"><span style="s2">以降は現場各自の判断を<br />優先します</span></p> 
   <p begin="00:33:07.486" end="00:33:10.155" style="s1"><span style="s2">エヴァとあなたたちに<br />全てを賭けるわ</span></p> 
   <p begin="00:33:10.322" end="00:33:12.282" style="s1"><span style="s2">（青葉）<br />目標接近 距離 およそ２万！</span></p> 
   <p begin="00:33:12.491" end="00:33:14.451" style="s1"><span style="s2">では 作戦開始</span></p> 
   <p begin="00:33:15.953" end="00:33:16.954" style="s1"><span style="s2">発進</span></p> 
   <p begin="00:33:17.079" end="00:33:18.789" region="縦右"><span style="s3">♪</span>～</p> 
   <p begin="00:33:18.872" end="00:33:47.651" region="縦右" style="s3">♪</p> 
   <p begin="00:33:48.861" end="00:33:50.863" style="s1"><span style="s2">（青葉）<br />目標のＡ.Ｔ.フィールド 変質！</span></p> 
   <p begin="00:33:51.155" end="00:33:54.366" style="s1"><span style="s2">軌道が変わります！<br />落下予想地点 修正205</span></p> 
   <p begin="00:33:54.491" end="00:33:55.868" style="s1"><span style="s2">（日向）目標 更に増速！</span></p> 
   <p begin="00:33:55.993" end="00:33:59.830" style="s1"><span style="s2">なによ 計算より速いじゃない！<br />ダメ！ 私じゃ間に合わない！</span></p> 
   <p begin="00:34:00.164" end="00:34:02.207" style="s1"><span style="s2">こっちでなんとかする<br />ミサトさん！</span></p> 
   <p begin="00:34:02.499" end="00:34:04.668" style="s1"><span style="s2">緊急コース形成！<br />605から675</span></p> 
   <p begin="00:34:04.793" end="00:34:05.794" style="s1"><span style="s2">はい！</span></p> 
   <p begin="00:34:13.218" end="00:34:16.221" style="s1"><span style="s2">次！ 1072から1078！<br />スタンバイ!!</span></p> 
   <p begin="00:34:19.183" end="00:34:28.192" region="縦右" style="s3">♪</p> 
   <p begin="00:34:28.192" end="00:34:30.235" region="縦右" style="s3">♪</p> 
   <p begin="00:34:28.192" end="00:34:30.235" style="s1"><span style="s2">くっ！</span></p> 
   <p begin="00:34:30.235" end="00:34:52.424" region="縦右" style="s3">♪</p> 
   <p begin="00:34:52.508" end="00:34:56.720" region="縦右">～<span style="s3">♪</span></p> 
   <p begin="00:34:56.762" end="00:34:59.097" style="s1"><span style="s2">（青葉）<br />目標 変形！ 距離１万２千！</span></p> 
   <p begin="00:35:04.061" end="00:35:06.271" style="s1"><span style="s2">Ａ.Ｔ.フィールド 全開!!</span></p> 
   <p begin="00:35:19.618" end="00:35:23.914" style="s1"><span style="s2">うぐぅあああああああっ!!</span></p> 
   <p begin="00:35:24.122" end="00:35:25.791" style="s1"><span style="s2">うぐぅああぅう</span></p> 
   <p begin="00:35:26.166" end="00:35:27.251" style="s1"><span style="s2">ううう…</span></p> 
   <p begin="00:35:40.973" end="00:35:42.474" style="s1"><span style="s2">ナナヒカリ！</span></p> 
   <p begin="00:35:43.183" end="00:35:44.184" style="s1"><span style="s2">２号機 コアを！</span></p> 
   <p begin="00:35:44.268" end="00:35:45.477" style="s1"><span style="s2">わかってるわよ！</span></p> 
   <p begin="00:35:46.603" end="00:35:48.397" style="s1"><span style="s2">私に命令しないでっ！</span></p> 
   <p begin="00:35:48.480" end="00:35:50.899" style="s1"><span style="s2">どわぁぁりゃああっ!!</span></p> 
   <p begin="00:35:50.983" end="00:35:52.609" style="s1"><span style="s2">でえい!!</span></p> 
   <p begin="00:35:52.776" end="00:35:54.611" style="s1"><span style="s2">おりゃっ！ でいっ…</span></p> 
   <p begin="00:35:54.820" end="00:35:55.988" style="s1"><span style="s2">外した!？</span></p> 
   <p begin="00:35:56.113" end="00:35:58.323" style="s1"><span style="s2">（アスカ）<br />ちょこまかと往生際悪いわね！</span></p> 
   <p begin="00:35:58.615" end="00:35:59.950" style="s1"><span style="s2">あと30秒</span></p> 
   <p begin="00:36:10.335" end="00:36:11.753" style="s1"><span style="s2">アスカ 早く！</span></p> 
   <p begin="00:36:11.962" end="00:36:13.630" style="s1"><span style="s2">わかってるってば</span></p> 
   <p begin="00:36:17.509" end="00:36:18.677" style="s1"><span style="s2">（アスカ）エコヒイキ？</span></p> 
   <p begin="00:36:18.802" end="00:36:20.012" style="s1"><span style="s2">ううぅっ!!</span></p> 
   <p begin="00:36:22.264" end="00:36:23.348" style="s1"><span style="s2">はやく…</span></p> 
   <p begin="00:36:23.432" end="00:36:24.433" style="s1"><span style="s2">アスカッ</span></p> 
   <p begin="00:36:24.516" end="00:36:28.812" style="s1"><span style="s2">わぁかってるっちゅーのぉ！</span></p> 
   <p begin="00:36:32.357" end="00:36:34.943" style="s1"><span style="s2">もういっちょお!!</span></p> 
   <p begin="00:36:35.027" end="00:36:36.111" style="s1"><span style="s2">てぁっ！</span></p> 
   <p begin="00:36:36.320" end="00:36:37.529" style="s1"><span style="s2">（破砕音）</span></p> 
   <p begin="00:37:13.690" end="00:37:19.905" style="s1"><span style="s2">ハァハァ</span></p> 
   <p begin="00:37:31.541" end="00:37:32.918" style="s1"><span style="s2">ふぅ…</span></p> 
   <p begin="00:37:33.085" end="00:37:34.086" style="s1"><span style="s2">（オペレーター）状況終了</span></p> 
   <p begin="00:37:34.211" end="00:37:36.505" style="s1"><span style="s2">（ミサト）<br />ありがとう みんな</span></p> 
   <p begin="00:37:36.588" end="00:37:40.050" style="s1"><span style="s2">（青葉）電波システム回復<br />碇司令から 通信が入っています</span></p> 
   <p begin="00:37:40.258" end="00:37:41.343" style="s1"><span style="s2">（ミサト）おつなぎして</span></p> 
   <p begin="00:37:43.053" end="00:37:47.057" style="s1"><span style="s2">申し訳ありません<br />私の独断でエヴァ３体を破損</span></p> 
   <p begin="00:37:47.224" end="00:37:49.559" style="s1"><span style="s2">パイロットにも<br />負傷をおわせてしまいました</span></p> 
   <p begin="00:37:49.685" end="00:37:52.020" style="s1"><span style="s2">責任は全て 私にあります</span></p> 
   <p begin="00:37:52.354" end="00:37:55.190" style="s1"><span style="s2">（冬月）<br />かまわん 目標殲滅に対し<span style="s7">―</span></span></p> 
   <p begin="00:37:55.273" end="00:37:58.360" style="s1"><span style="s2">この程度の被害は<br />むしろ幸運といえる</span></p> 
   <p begin="00:37:59.027" end="00:38:01.863" style="s1"><span style="s2">（ゲンドウ）ああ<br />よくやってくれた 葛城一佐</span></p> 
   <p begin="00:38:01.947" end="00:38:03.115" style="s1"><span style="s2">（ミサト）<br />ありがとうございます</span></p> 
   <p begin="00:38:03.240" end="00:38:05.283" style="s1"><span style="s2">（ゲンドウ）初号機の<br />パイロットにつないでくれ</span></p> 
   <p begin="00:38:05.367" end="00:38:06.368" style="s1"><span style="s2">え…</span></p> 
   <p begin="00:38:07.244" end="00:38:10.455" style="s1"><span style="s2">（ゲンドウ）話は聞いた<br />よくやったな シンジ</span></p> 
   <p begin="00:38:10.747" end="00:38:12.624" style="s1"><span style="s2">え？ …はい</span></p> 
   <p begin="00:38:13.041" end="00:38:16.044" style="s1"><span style="s2">（ゲンドウ）では葛城一佐<br />あとの処理は任せる</span></p> 
   <p begin="00:38:16.211" end="00:38:19.047" style="s1"><span style="s2">（ミサト）ハイ<br />エヴァ３機の回収 急いで</span></p> 
   <p begin="00:38:19.381" end="00:38:22.426" style="s1"><span style="s2">（伊吹）搬入は<br />初号機を優先 99ケイジへ</span></p> 
   <p begin="00:38:30.142" end="00:38:34.104" style="s1"><span style="s2">私一人じゃ…<br />何も出来なかった</span></p> 
   <p begin="00:38:53.415" end="00:38:54.750" style="s1"><span style="s2">（アスカ）ん…</span></p> 
   <p begin="00:39:05.469" end="00:39:08.180" style="s1"><span style="s2">（アスカ）ずっと<br />一人が当たり前なのに</span></p> 
   <p begin="00:39:09.806" end="00:39:13.268" style="s1"><span style="s2">孤独って<br />気にならないはずなのに</span></p> 
   <p begin="00:39:25.947" end="00:39:27.657" style="s1"><span style="s2">は!!　え!？…ちょっ…</span></p> 
   <p begin="00:39:27.824" end="00:39:29.367" style="s1"><span style="s2">（アスカ）こっち向かないで</span></p> 
   <p begin="00:39:29.493" end="00:39:33.371" style="s1"><span style="s2">あ… う… うん</span></p> 
   <p begin="00:39:35.373" end="00:39:39.503" style="s1"><span style="s2">ナナヒカリ<br />ちょっとだけ居させて</span></p> 
   <p begin="00:39:44.549" end="00:39:47.844" style="s1"><span style="s2">あ あの… 式波…さん？</span></p> 
   <p begin="00:39:47.969" end="00:39:48.553" region="縦右">（アスカの咳払い）</p> 
   <p begin="00:39:48.553" end="00:39:49.846" region="縦右">（アスカの咳払い）</p> 
   <p begin="00:39:48.553" end="00:39:49.846" style="s1"><span style="s2">ひっ… あ…</span></p> 
   <p begin="00:39:50.639" end="00:39:54.142" style="s1"><span style="s2">（アスカ）<br />今日 どさくさにまぎれて<br />名前呼んだでしょ</span></p> 
   <p begin="00:39:54.226" end="00:39:55.227" style="s1"><span style="s2">あっ…</span></p> 
   <p begin="00:39:55.352" end="00:40:00.565" style="s1"><span style="s2">特別にアスカでいいわよ<br />わたしもバカシンジって呼ぶから</span></p> 
   <p begin="00:40:00.857" end="00:40:05.904" style="s1"><span style="s2">（シンジ）<br />じゃあ あの… アスカは<br />どうしてエヴァに？</span></p> 
   <p begin="00:40:06.321" end="00:40:10.075" style="s1"><span style="s2">（アスカ）愚問ね<br />黙ってなさいよ バカシンジ</span></p> 
   <p begin="00:40:10.242" end="00:40:12.494" style="s1"><span style="s2">（シンジ）う… うん</span></p> 
   <p begin="00:40:14.913" end="00:40:20.836" style="s1"><span style="s2">（アスカ）<br />自分のためよ エヴァに乗るのは<br />あんたはどうなのよ？</span></p> 
   <p begin="00:40:21.336" end="00:40:22.712" style="s1"><span style="s2">（シンジ）よく わかんない</span></p> 
   <p begin="00:40:23.004" end="00:40:25.882" style="s1"><span style="s2">（アスカ）ふぅ… あんたバカ？</span></p> 
   <p begin="00:40:26.174" end="00:40:28.760" style="s1"><span style="s2">そうやって<br />責任逃れしてるだけなんでしょ？</span></p> 
   <p begin="00:40:30.554" end="00:40:33.390" style="s1"><span style="s2">（シンジ）<br />父さんに褒めて欲しいのかな…</span></p> 
   <p begin="00:40:34.683" end="00:40:38.186" style="s1"><span style="s2">今日は 初めて褒めてくれたんだ</span></p> 
   <p begin="00:40:39.104" end="00:40:41.773" style="s1"><span style="s2">初めて 褒められるのが<br />うれしいと思った</span></p> 
   <p begin="00:40:43.108" end="00:40:47.404" style="s1"><span style="s2">父さん もう僕のこと<br />認めてくれたのかな</span></p> 
   <p begin="00:40:48.405" end="00:40:50.949" style="s1"><span style="s2">ミサトさんの言ってた<br />通りかもしれない</span></p> 
   <p begin="00:40:52.742" end="00:40:56.413" style="s1"><span style="s2">ふぅ… あんたって…</span></p> 
   <p begin="00:40:57.080" end="00:40:58.415" style="s1"><span style="s2">ホントにバカね</span></p> 
   <p begin="00:40:58.540" end="00:41:00.125" style="s1"><span style="s2">（動作音）</span></p> 
   <p begin="00:41:00.584" end="00:41:03.128" style="s1"><span style="s2">（生徒たちの声）</span></p> 
   <p begin="00:41:03.295" end="00:41:08.592" style="s1"><span style="s2">さあて メシやメシ<br />学校最大のたのしみやからな</span></p> 
   <p begin="00:41:08.675" end="00:41:11.219" style="s1"><span style="s2">（アスカ）えー!!<br />お弁当持って来てないのぉ!？</span></p> 
   <p begin="00:41:11.303" end="00:41:14.389" style="s1"><span style="s2">今朝は宿題してて<br />作る時間がなかったんだよ</span></p> 
   <p begin="00:41:14.598" end="00:41:16.558" style="s1"><span style="s2">だからって このあたしに</span></p> 
   <p begin="00:41:16.641" end="00:41:19.144" style="s1"><span style="s2">お昼なしで過ごせってえの<br />あんたは！</span></p> 
   <p begin="00:41:19.311" end="00:41:21.271" style="s1"><span style="s2">（シンジ）<br />だから明日はちゃんと作るよ</span></p> 
   <p begin="00:41:21.479" end="00:41:23.648" style="s1"><span style="s2">なんや また夫婦ゲンカかいな？</span></p> 
   <p begin="00:41:24.441" end="00:41:25.609" style="s1"><span style="s2">（クラスメイト笑い声）</span></p> 
   <p begin="00:41:25.734" end="00:41:26.735" style="s1"><span style="s2">（シンジ）違うよ！<br />（アスカ）違うわよ！</span></p> 
   <p begin="00:41:28.653" end="00:41:32.115" style="s1"><span style="s2">（ミサト）<br />アスカ～ 洗顔ソープ貸して～</span></p> 
   <p begin="00:41:32.324" end="00:41:35.493" style="s1"><span style="s2">（アスカ）<br />いい加減にしてよミサト！<br />自分で買ってきなさいよ</span></p> 
   <p begin="00:41:36.244" end="00:41:37.579" style="s1"><span style="s2">（ミサト）ケチんぼ！</span></p> 
   <p begin="00:41:37.662" end="00:41:39.289" style="s1"><span style="s2">（チャイム）</span></p> 
   <p begin="00:41:39.372" end="00:41:41.291" style="s1"><span style="s2">（トウジ）さぁて メシやメシ！</span></p> 
   <p begin="00:41:41.583" end="00:41:44.753" style="s1"><span style="s2">（アスカ）ほっ！ はむっ…</span></p> 
   <p begin="00:41:46.671" end="00:41:50.842" style="s1"><span style="s2">ふーん 今日は まあまあね<br />サボった分 味は落ちてるけど</span></p> 
   <p begin="00:41:51.134" end="00:41:52.677" style="s1"><span style="s2">（女生徒）あの～ アスカさん</span></p> 
   <p begin="00:41:52.761" end="00:41:53.762" style="s1"><span style="s2">ん？</span></p> 
   <p begin="00:41:53.970" end="00:41:56.097" style="s1"><span style="s2">いっしょに食べてもいい？</span></p> 
   <p begin="00:41:58.141" end="00:42:00.810" style="s1"><span style="s2">…いいけど 弁当は分けないわよ</span></p> 
   <p begin="00:42:01.019" end="00:42:02.145" style="s1"><span style="s2">ふふっ</span></p> 
   <p begin="00:42:02.395" end="00:42:03.396" style="s1"><span style="s2">ん…</span></p> 
   <p begin="00:42:05.106" end="00:42:06.483" style="s1"><span style="s2">（シンジ）ハイこれ</span></p> 
   <p begin="00:42:06.733" end="00:42:07.734" style="s1"><span style="s2">え？</span></p> 
   <p begin="00:42:09.110" end="00:42:11.821" style="s1"><span style="s2">いつも 食べてなさそうだったから</span></p> 
   <p begin="00:42:13.031" end="00:42:15.200" style="s1"><span style="s2">あ… ありがとう</span></p> 
   <p begin="00:42:15.325" end="00:42:16.660" style="s1"><span style="s2">良かったぁ<br />思いきって声かけて</span></p> 
   <p begin="00:42:16.785" end="00:42:18.245" style="s1"><span style="s2">ヒカリ だっけ？</span></p> 
   <p begin="00:42:18.328" end="00:42:19.329" style="s1"><span style="s2">え？</span></p> 
   <p begin="00:42:19.621" end="00:42:21.539" style="s1"><span style="s2">残り 食べていいわよ</span></p> 
   <p begin="00:42:21.790" end="00:42:22.791" style="s1"><span style="s2">へ？</span></p> 
   <p begin="00:42:23.041" end="00:42:25.210" style="s1"><span style="s2">（ミサト）はぁ～おなか満腹</span></p> 
   <p begin="00:42:26.002" end="00:42:27.837" style="s1"><span style="s2">ごちそうさまでしたっ</span></p> 
   <p begin="00:42:28.171" end="00:42:29.714" style="s1"><span style="s2">遅い昼飯だな</span></p> 
   <p begin="00:42:29.839" end="00:42:31.383" style="s1"><span style="s2">あ ありがと</span></p> 
   <p begin="00:42:32.342" end="00:42:34.719" style="s1"><span style="s2">シンジくんに<br />作ってもらってるんだって？</span></p> 
   <p begin="00:42:34.970" end="00:42:38.348" style="s1"><span style="s2">まあ 君は<br />手料理ってガラじゃないしな</span></p> 
   <p begin="00:42:38.682" end="00:42:39.683" style="s1"><span style="s2">ふん…</span></p> 
   <p begin="00:42:40.976" end="00:42:43.853" style="s1"><span style="s2">そうねっ<br />ヒマなあんたと違って<span style="s7">―</span></span></p> 
   <p begin="00:42:43.979" end="00:42:46.690" style="s1"><span style="s2">現場の管理職は<br />たんまり仕事があんのよ</span></p> 
   <p begin="00:42:46.815" end="00:42:49.025" style="s1"><span style="s2">（加持）<br />相変わらずマジメだなぁ</span></p> 
   <p begin="00:42:49.317" end="00:42:52.487" style="s1"><span style="s2">（加持）<br />ま そこが 葛城のイイとこだが<br />弱点でもある</span></p> 
   <p begin="00:42:52.904" end="00:42:56.241" style="s1"><span style="s2">この前の時だって リッちゃんと<br />やり合ったって聞いたぜ</span></p> 
   <p begin="00:42:57.200" end="00:42:58.910" style="s1"><span style="s2">もうちょっと余裕持てよ</span></p> 
   <p begin="00:42:59.035" end="00:43:03.123" style="s1"><span style="s2">あいにく 私の器は<br />常に責務で一杯なのよ</span></p> 
   <p begin="00:43:03.206" end="00:43:06.293" style="s1"><span style="s2">（加持）緊張感ありすぎると<br />男にモテないぞ</span></p> 
   <p begin="00:43:06.376" end="00:43:07.752" style="s1"><span style="s2">余計なお世話よ</span></p> 
   <p begin="00:43:07.877" end="00:43:09.045" style="s1"><span style="s2">はっ…</span></p> 
   <p begin="00:43:29.733" end="00:43:31.568" style="s1"><span style="s2">ありがとう…</span></p> 
   <p begin="00:43:31.693" end="00:43:35.280" style="s1"><span style="s2">感謝の言葉<br />はじめての言葉</span></p> 
   <p begin="00:43:37.574" end="00:43:40.577" style="s1"><span style="s2">あの人にも<br />言ったことなかったのに…</span></p> 
   <p begin="00:43:42.120" end="00:43:42.954" style="s1"><span style="s2">（ヒカリ）起立！</span></p> 
   <p begin="00:43:42.954" end="00:43:44.414" style="s1"><span style="s2">（ヒカリ）起立！</span></p> 
   <p begin="00:43:42.954" end="00:43:44.414" region="縦右">（イスが動く音）</p> 
   <p begin="00:43:44.539" end="00:43:46.207" style="s1"><span style="s2">礼！</span></p> 
   <p begin="00:43:46.374" end="00:43:47.000" style="s1"><span style="s2">着席！</span></p> 
   <p begin="00:43:47.000" end="00:43:48.752" style="s1"><span style="s2">着席！</span></p> 
   <p begin="00:43:47.000" end="00:43:48.752" region="縦右">（イスが動く音）</p> 
   <p begin="00:43:49.210" end="00:43:53.214" style="s1"><span style="s2">（先生）あー<br />綾波はまた休みか</span></p> 
   <p begin="00:43:53.465" end="00:43:58.261" style="s1"><span style="s2">（シンジの声）<br />昨日 元気そうだったのに<br />どうしたんだろ</span></p> 
   <p begin="00:43:58.553" end="00:43:59.721" style="s1"><span style="s2">私と同じ</span></p> 
   <p begin="00:44:00.889" end="00:44:03.016" style="s1"><span style="s2">（シンジの声）<br />“ここでしか生きられない”</span></p> 
   <p begin="00:44:03.600" end="00:44:05.268" style="s1"><span style="s2">…どういうことだろ</span></p> 
   <p begin="00:44:09.981" end="00:44:11.566" style="s1"><span style="s2">（ゲンドウ）レイ</span></p> 
   <p begin="00:44:16.821" end="00:44:18.073" style="s1"><span style="s2">食事にしよう</span></p> 
   <p begin="00:44:19.324" end="00:44:20.450" style="s1"><span style="s2">（レイ）ハイ</span></p> 
   <p begin="00:44:27.082" end="00:44:28.416" style="s1"><span style="s2">（レイ）碇司令</span></p> 
   <p begin="00:44:28.917" end="00:44:30.126" style="s1"><span style="s2">（ゲンドウ）なんだ</span></p> 
   <p begin="00:44:30.335" end="00:44:32.796" style="s1"><span style="s2">（レイ）<br />食事って 楽しいですか？</span></p> 
   <p begin="00:44:33.421" end="00:44:34.631" style="s1"><span style="s2">（ゲンドウ）ああ</span></p> 
   <p begin="00:44:35.423" end="00:44:38.968" style="s1"><span style="s2">（レイ）<br />誰かと一緒に食べるって<br />うれしいですか</span></p> 
   <p begin="00:44:40.178" end="00:44:41.429" style="s1"><span style="s2">（ゲンドウ）ああ</span></p> 
   <p begin="00:44:42.597" end="00:44:46.935" style="s1"><span style="s2">（レイ）料理って<br />作ると喜ぶ… ですか？</span></p> 
   <p begin="00:44:47.602" end="00:44:48.937" style="s1"><span style="s2">（ゲンドウ）ああ</span></p> 
   <p begin="00:44:51.648" end="00:44:54.359" style="s1"><span style="s2">（レイ）碇司令 今度…</span></p> 
   <p begin="00:44:54.609" end="00:44:58.655" style="s1"><span style="s2">碇君やみんなと<br />食事… どうですか？</span></p> 
   <p begin="00:45:01.282" end="00:45:03.535" style="s1"><span style="s2">いや その時間は…</span></p> 
   <p begin="00:45:07.122" end="00:45:09.791" style="s1"><span style="s2">（ユイの幻影）あなた　シンジを</span></p> 
   <p begin="00:45:15.880" end="00:45:18.383" style="s1"><span style="s2">（ゲンドウ）…わかった 行こう</span></p> 
   <p begin="00:45:18.800" end="00:45:19.884" style="s1"><span style="s2">ふっ…</span></p> 
   <p begin="00:45:20.260" end="00:45:23.430" style="s1"><span style="s2">（アナウンス）各パイロット<br />擬似シンクロ状態に異常なし</span></p> 
   <p begin="00:45:23.513" end="00:45:25.974" style="s1"><span style="s2">精神汚染濃度 計測されず</span></p> 
   <p begin="00:45:29.352" end="00:45:31.020" style="s1"><span style="s2">（アスカ）あ～あ</span></p> 
   <p begin="00:45:31.146" end="00:45:35.650" style="s1"><span style="s2">退屈ねー<br />使徒が来ないとチェックばっか</span></p> 
   <p begin="00:45:35.733" end="00:45:36.901" style="s1"><span style="s2">まいっちんぐね</span></p> 
   <p begin="00:45:36.985" end="00:45:38.820" style="s1"><span style="s2">いいんじゃないの</span></p> 
   <p begin="00:45:38.903" end="00:45:45.410" style="s1"><span style="s2">使徒の来ない穏やかな日々を願って<br />私らは働いてんの よっと</span></p> 
   <p begin="00:45:45.535" end="00:45:48.746" style="s1"><span style="s2">昨日と同じ今日<br />今日と同じであろう明日</span></p> 
   <p begin="00:45:48.872" end="00:45:51.124" style="s1"><span style="s2">繰り返す日常を謳歌</span></p> 
   <p begin="00:45:51.207" end="00:45:53.710" style="s1"><span style="s2">むしろ感謝すべき事態ね</span></p> 
   <p begin="00:45:55.211" end="00:45:58.465" style="s1"><span style="s2">チェック終了です<br />モニター感度良好</span></p> 
   <p begin="00:45:58.590" end="00:46:02.510" style="s1"><span style="s2">（リツコ）お疲れさま<br />三人とも上がっていいわよ</span></p> 
   <p begin="00:46:09.601" end="00:46:11.227" style="s1"><span style="s2">（トロッコ走行音）</span></p> 
   <p begin="00:46:11.352" end="00:46:13.104" style="s1"><span style="s2">（日向）<br />僕が言うのもなんですけど…</span></p> 
   <p begin="00:46:13.354" end="00:46:17.025" style="s1"><span style="s2">こうも損傷が激しいと<br />作戦運用に支障が出てます</span></p> 
   <p begin="00:46:17.233" end="00:46:19.861" style="s1"><span style="s2">バチカン条約<br />破棄していいんじゃないスか</span></p> 
   <p begin="00:46:20.195" end="00:46:22.780" style="s1"><span style="s2">（ミサト）そうよね<br />一国のエヴァ保有数を<span style="s7">―</span></span></p> 
   <p begin="00:46:22.906" end="00:46:26.409" style="s1"><span style="s2">３体までに制限されると<br />稼働機体の余裕ないもの</span></p> 
   <p begin="00:46:26.743" end="00:46:30.038" style="s1"><span style="s2">（伊吹）今だって<br />初号機優先での修復作業です</span></p> 
   <p begin="00:46:30.246" end="00:46:33.041" style="s1"><span style="s2">予備パーツも全て使って<br />やりくりしてますから<span style="s7">―</span></span></p> 
   <p begin="00:46:33.124" end="00:46:36.211" style="s1"><span style="s2">零号機の修復は<br />メドもたたない状況です</span></p> 
   <p begin="00:46:36.544" end="00:46:39.464" style="s1"><span style="s2">（リツコ）条約には<br />各国のエゴが絡んでいるもの…</span></p> 
   <p begin="00:46:39.756" end="00:46:41.424" style="s1"><span style="s2">改正すら まず無理ね</span></p> 
   <p begin="00:46:41.925" end="00:46:44.260" style="s1"><span style="s2">（リツコ）おまけに５号機を失った<br />ユーロとロシアが<span style="s7">―</span></span></p> 
   <p begin="00:46:44.552" end="00:46:47.597" style="s1"><span style="s2">アジアを巻き込んで<br />あれこれ主張してるみたいだし</span></p> 
   <p begin="00:46:47.805" end="00:46:50.433" style="s1"><span style="s2">政治が絡むと<br />何かと面倒ね</span></p> 
   <p begin="00:46:51.059" end="00:46:54.229" style="s1"><span style="s2">（伊吹）人類を守る前に<br />することが多過ぎですよ</span></p> 
   <p begin="00:46:56.105" end="00:47:00.902" style="s1"><span style="s2">（飛行機の通過音）</span></p> 
   <p begin="00:47:01.110" end="00:47:03.071" region="縦右">（<span style="s4"><span style="s5">落下傘</span><span style="s6">パラシュート</span></span>のはためく音）</p> 
   <p begin="00:47:03.071" end="00:47:04.614" region="縦右">（<span style="s4"><span style="s5">落下傘</span><span style="s6">パラシュート</span></span>のはためく音）</p> 
   <p begin="00:47:03.071" end="00:47:04.614" style="s1"><span style="s2">どいて どいてーっ</span></p> 
   <p begin="00:47:04.614" end="00:47:05.073" style="s1"><span style="s2">どいて どいてーっ</span></p> 
   <p begin="00:47:05.156" end="00:47:06.157" style="s1"><span style="s2">わああ</span></p> 
   <p begin="00:47:06.241" end="00:47:07.242" style="s1"><span style="s2">どわぁああっと！</span></p> 
   <p begin="00:47:09.118" end="00:47:12.914" style="s1"><span style="s2">痛ったぁ…痛たたた…</span></p> 
   <p begin="00:47:13.456" end="00:47:14.457" style="s1"><span style="s2">…あ！</span></p> 
   <p begin="00:47:14.582" end="00:47:16.459" style="s1"><span style="s2">（シンジ）むぐぐぅ…</span></p> 
   <p begin="00:47:16.543" end="00:47:18.294" style="s1"><span style="s2">ぶはぁーっ</span></p> 
   <p begin="00:47:18.378" end="00:47:19.379" style="s1"><span style="s2">あっ！</span></p> 
   <p begin="00:47:19.462" end="00:47:22.840" style="s1"><span style="s2">ああっ… ん？</span></p> 
   <p begin="00:47:23.841" end="00:47:25.927" style="s1"><span style="s2">メガネ… メガネ…</span></p> 
   <p begin="00:47:26.636" end="00:47:27.762" style="s1"><span style="s2">（シンジ）あの…</span></p> 
   <p begin="00:47:28.429" end="00:47:30.431" style="s1"><span style="s2">ああごめん 大丈夫？</span></p> 
   <p begin="00:47:30.723" end="00:47:31.307" style="s1"><span style="s2">（通信機コール音）</span></p> 
   <p begin="00:47:31.307" end="00:47:32.308" style="s1"><span style="s2">（通信機コール音）</span></p> 
   <p begin="00:47:31.307" end="00:47:32.308" region="縦右">お！</p> 
   <p begin="00:47:34.102" end="00:47:35.311" region="縦右">（マリ・英語）</p> 
   <p begin="00:47:35.979" end="00:47:38.898" region="縦右">（マリ・英語）</p> 
   <p begin="00:47:39.774" end="00:47:42.402" region="縦右">（マリ・英語）</p> 
   <p begin="00:47:43.278" end="00:47:47.574" region="縦右">（マリ・英語）</p> 
   <p begin="00:47:48.741" end="00:47:50.827" region="縦右">（マリ・英語）</p> 
   <p begin="00:47:52.036" end="00:47:55.456" region="縦右">（マリ・英語）</p> 
   <p begin="00:48:01.379" end="00:48:03.047" style="s1"><span style="s2">（シンジ）お あ…</span></p> 
   <p begin="00:48:01.379" end="00:48:03.047" region="縦右">（匂いをかぐマリ）</p> 
   <p begin="00:48:03.840" end="00:48:08.177" style="s1"><span style="s2">…君 いい匂い<br />ＬＣＬの香りがする</span></p> 
   <p begin="00:48:08.845" end="00:48:09.846" style="s1"><span style="s2">え？</span></p> 
   <p begin="00:48:10.555" end="00:48:12.849" style="s1"><span style="s2">君 面白いね</span></p> 
   <p begin="00:48:13.182" end="00:48:16.728" style="s1"><span style="s2">じゃ このことは他言無用で<br />ネルフのワンコくん！</span></p> 
   <p begin="00:48:28.531" end="00:48:30.700" style="s1"><span style="s2">（シンジ）あれ？ 変だな…</span></p> 
   <p begin="00:48:34.537" end="00:48:35.913" style="s1"><span style="s2">ひゃっ!!</span></p> 
   <p begin="00:48:36.164" end="00:48:39.500" style="s1"><span style="s2">よっ どうだい？<br />たまにはデートでも</span></p> 
   <p begin="00:48:40.543" end="00:48:42.045" style="s1"><span style="s2">僕 男ですよ</span></p> 
   <p begin="00:48:42.378" end="00:48:45.340" style="s1"><span style="s2">（加持）ノープロブレム<br />（シンジ）わっ…</span></p> 
   <p begin="00:48:45.506" end="00:48:47.759" style="s1"><span style="s2">愛に性別は関係ないさ</span></p> 
   <p begin="00:48:48.343" end="00:48:49.385" style="s1"><span style="s2">ん… はあ…</span></p> 
   <p begin="00:48:49.510" end="00:48:51.387" style="s1"><span style="s2">（シンジの悲鳴）きゃあああ！</span></p> 
   <p begin="00:48:52.013" end="00:48:53.681" style="s1"><span style="s2">冗談だよ</span></p> 
   <p begin="00:48:53.848" end="00:48:54.891" style="s1"><span style="s2">む…</span></p> 
   <p begin="00:48:55.099" end="00:48:56.434" style="s1"><span style="s2">（加持）ほれ</span></p> 
   <p begin="00:49:00.897" end="00:49:04.192" style="s1"><span style="s2">（シンジ）ん… はぁっ<br />ううぅん～</span></p> 
   <p begin="00:49:08.905" end="00:49:11.240" style="s1"><span style="s2">土の… 匂い？</span></p> 
   <p begin="00:49:11.949" end="00:49:14.202" style="s1"><span style="s2">（加持）もうへたばったのかい？<br />（シンジ）ん…</span></p> 
   <p begin="00:49:15.203" end="00:49:17.080" style="s1"><span style="s2">給料分は働いてもらうぞ</span></p> 
   <p begin="00:49:17.538" end="00:49:20.958" style="s1"><span style="s2">給料って？<br />…さっきの缶コーヒー？</span></p> 
   <p begin="00:49:21.584" end="00:49:24.712" style="s1"><span style="s2">はぁ… デートって言ってたのに</span></p> 
   <p begin="00:49:25.546" end="00:49:28.216" style="s1"><span style="s2">加持さんって もっと<br />マジメな人だと思ってました</span></p> 
   <p begin="00:49:28.549" end="00:49:31.886" style="s1"><span style="s2">大人はさ ずるいくらいが<br />丁度いいんだ</span></p> 
   <p begin="00:49:36.224" end="00:49:38.768" style="s1"><span style="s2">これ 確か<br />スイカ ですよね</span></p> 
   <p begin="00:49:38.976" end="00:49:42.230" style="s1"><span style="s2">（加持）ああ かわいいだろ<br />オレの趣味さ</span></p> 
   <p begin="00:49:42.939" end="00:49:46.484" style="s1"><span style="s2">（加持）何かを作る<br />何かを育てるってのはイイぞ</span></p> 
   <p begin="00:49:46.984" end="00:49:51.072" style="s1"><span style="s2">（加持）色んなことが見えるし<br />わかってくる たのしいこととかな</span></p> 
   <p begin="00:49:52.657" end="00:49:54.575" style="s1"><span style="s2">（シンジ）<br />つらいこともでしょ</span></p> 
   <p begin="00:49:55.118" end="00:49:56.911" style="s1"><span style="s2">（加持）つらいのは 嫌いか？</span></p> 
   <p begin="00:49:57.787" end="00:49:59.497" style="s1"><span style="s2">（シンジ）好きじゃないです</span></p> 
   <p begin="00:49:59.789" end="00:50:01.582" style="s1"><span style="s2">（加持）<br />たのしいこと 見つけたかい？</span></p> 
   <p begin="00:50:04.335" end="00:50:06.587" style="s1"><span style="s2">（加持）それもいいさ けど…</span></p> 
   <p begin="00:50:06.671" end="00:50:08.923" style="s1"><span style="s2">つらいことを<br />知ってる人間のほうが<span style="s7">―</span></span></p> 
   <p begin="00:50:09.006" end="00:50:13.594" style="s1"><span style="s2">それだけ人にやさしく出来る<br />それは 弱さとは違うからな</span></p> 
   <p begin="00:50:15.513" end="00:50:17.348" style="s1"><span style="s2">（加持）葛城は 好きかい？</span></p> 
   <p begin="00:50:17.473" end="00:50:18.850" style="s1"><span style="s2">え？</span></p> 
   <p begin="00:50:20.351" end="00:50:24.981" style="s1"><span style="s2">ミサトさん？ いや あの<br />…嫌いじゃないです</span></p> 
   <p begin="00:50:25.857" end="00:50:28.151" style="s1"><span style="s2">葛城を 守ってくれ</span></p> 
   <p begin="00:50:29.944" end="00:50:34.866" style="s1"><span style="s2">それはオレに出来ない<br />君にしか出来ないことだ</span></p> 
   <p begin="00:50:36.367" end="00:50:37.410" style="s1"><span style="s2">（加持）…頼む</span></p> 
   <p begin="00:50:42.665" end="00:50:51.716" style="s1"><span style="s2">（シンクに水が流れる音）</span></p> 
   <p begin="00:51:07.648" end="00:51:08.983" style="s1"><span style="s2">…おはよう</span></p> 
   <p begin="00:51:09.859" end="00:51:10.985" style="s1"><span style="s2">綾波！</span></p> 
   <p begin="00:51:11.068" end="00:51:14.363" style="s1"><span style="s2">（ケンスケ）…あいさつ？<br />（トウジ）あの綾波が？</span></p> 
   <p begin="00:51:16.532" end="00:51:18.534" style="s1"><span style="s2">綾波 もういいの？</span></p> 
   <p begin="00:51:19.035" end="00:51:21.037" style="s1"><span style="s2">ええ 今日は平気</span></p> 
   <p begin="00:51:21.120" end="00:51:23.915" style="s1"><span style="s2">どうしたの？　その手</span></p> 
   <p begin="00:51:25.374" end="00:51:28.544" style="s1"><span style="s2">さっき<br />赤木博士が巻いてくれたの</span></p> 
   <p begin="00:51:28.920" end="00:51:30.171" style="s1"><span style="s2">何してたの？</span></p> 
   <p begin="00:51:30.546" end="00:51:35.009" style="s1"><span style="s2">…ヒミツ もう少し<br />うまくなったら話す</span></p> 
   <p begin="00:51:35.384" end="00:51:39.597" style="s1"><span style="s2">（始業チャイム）</span></p> 
   <p begin="00:51:40.139" end="00:51:41.140" style="s1"><span style="s2">…むぅ</span></p> 
   <p begin="00:51:45.895" end="00:51:48.731" style="s1"><span style="s2">（ミサト）変わったわね レイ<br />（リツコ）そうね</span></p> 
   <p begin="00:51:48.856" end="00:51:50.942" style="s1"><span style="s2">（リツコ）<br />あの娘がヒトのために<br />何かするなんて<span style="s7">―</span></span></p> 
   <p begin="00:51:51.234" end="00:51:54.612" style="s1"><span style="s2">考えられない行為ね<br />何が原因かしら</span></p> 
   <p begin="00:51:54.904" end="00:51:56.531" style="s1"><span style="s2">愛 …じゃないの？</span></p> 
   <p begin="00:51:56.614" end="00:51:59.075" style="s1"><span style="s2">まさか ありえないわ</span></p> 
   <p begin="00:52:00.034" end="00:52:01.536" style="s1"><span style="s2">（アスカ）ズズッ…</span></p> 
   <p begin="00:52:01.619" end="00:52:03.204" style="s1"><span style="s2">んむぅ～</span></p> 
   <p begin="00:52:03.621" end="00:52:06.958" style="s1"><span style="s2">バカシンジだと もう少し<br />薄味のほうがいいのかなぁ</span></p> 
   <p begin="00:52:07.542" end="00:52:09.085" style="s1"><span style="s2">（ミサト）たっだいまー</span></p> 
   <p begin="00:52:09.377" end="00:52:11.963" style="s1"><span style="s2">あれ ミサト？<br />早かったわね</span></p> 
   <p begin="00:52:12.129" end="00:52:14.590" style="s1"><span style="s2">（ミサト）ええ<br />すぐ本部へとんぼ返り</span></p> 
   <p begin="00:52:14.757" end="00:52:16.634" style="s1"><span style="s2">（ミサト）<br />風呂と着替えに帰っただけよ！</span></p> 
   <p begin="00:52:18.302" end="00:52:20.137" style="s1"><span style="s2">お？ おお～</span></p> 
   <p begin="00:52:20.638" end="00:52:22.807" style="s1"><span style="s2">まぁ～ これはこれは</span></p> 
   <p begin="00:52:22.932" end="00:52:25.601" style="s1"><span style="s2">アスカもシンちゃんに<br />料理ごちそうするの？</span></p> 
   <p begin="00:52:25.810" end="00:52:27.895" style="s1"><span style="s2">うっ!! 違うわ！</span></p> 
   <p begin="00:52:27.979" end="00:52:30.147" style="s1"><span style="s2">え と 女の子<br />…そう ヒカリよ！</span></p> 
   <p begin="00:52:30.273" end="00:52:34.068" style="s1"><span style="s2">うぷぷ レイといいアスカといい<br />急に色気づいちゃって</span></p> 
   <p begin="00:52:34.318" end="00:52:36.612" style="s1"><span style="s2">（アスカ）何よ！<br />エコヒイキといっしょにしないで</span></p> 
   <p begin="00:52:36.779" end="00:52:40.950" style="s1"><span style="s2">そうね レイにはもっと<br />遠大な計画があるようだし</span></p> 
   <p begin="00:52:41.158" end="00:52:42.326" style="s1"><span style="s2">何 それ？</span></p> 
   <p begin="00:52:42.451" end="00:52:44.829" style="s1"><span style="s2">ああ 碇司令と<br />シンちゃんをくっつける</span></p> 
   <p begin="00:52:44.954" end="00:52:47.623" style="s1"><span style="s2">キューピットになりたい<br />みたい… よ</span></p> 
   <p begin="00:52:48.291" end="00:52:52.086" style="s1"><span style="s2">（ミサト）<br />手作り料理で みんなと食事会<br />という作戦らしいわ</span></p> 
   <p begin="00:52:52.169" end="00:52:53.170" style="s1"><span style="s2">（ミサト）ストレートな分</span></p> 
   <p begin="00:52:53.254" end="00:52:54.964" style="s1"><span style="s2">（ミサト）これは効くわよん<br />（アスカ）あ…</span></p> 
   <p begin="00:52:55.464" end="00:52:58.301" style="s1"><span style="s2">（ミサト）<br />ホント あの親子を<br />仲良くさせるのは<span style="s7">―</span></span></p> 
   <p begin="00:52:58.426" end="00:52:59.844" style="s1"><span style="s2">骨が折れるわね</span></p> 
   <p begin="00:52:59.969" end="00:53:02.346" style="s1"><span style="s2">あの女が<br />バカシンジのために？</span></p> 
   <p begin="00:53:02.430" end="00:53:05.349" style="s1"><span style="s2">サプライズなんだから<br />シンちゃんにバラしちゃだめよ</span></p> 
   <p begin="00:53:05.641" end="00:53:09.645" style="s1"><span style="s2">っぐっ！ 話すわけないでしょ！<br />この私が</span></p> 
   <p begin="00:53:28.164" end="00:53:32.418" style="s1"><span style="s2">（交錯する指示と警報音）</span></p> 
   <p begin="00:53:32.710" end="00:53:34.003" style="s1"><span style="s2">（ミサト）消滅？!</span></p> 
   <p begin="00:53:34.503" end="00:53:37.381" style="s1"><span style="s2">エヴァ４号機と<br />第２支部が消滅したの？</span></p> 
   <p begin="00:53:38.049" end="00:53:40.343" style="s1"><span style="s2">（青葉）Ｔプラス10<br />グラウンドゼロのデータです</span></p> 
   <p begin="00:53:42.219" end="00:53:43.220" style="s1"><span style="s2">（ミサト）ひどいわね</span></p> 
   <p begin="00:53:43.471" end="00:53:46.724" style="s1"><span style="s2">Ａ.Ｔ.フィールドの崩壊が<br />衛星から確認出来ますが…</span></p> 
   <p begin="00:53:46.849" end="00:53:48.184" style="s1"><span style="s2">詳細は不明です</span></p> 
   <p begin="00:53:48.392" end="00:53:53.022" style="s1"><span style="s2">やはり４号機が爆心か<br />うちのエヴァ 大丈夫でしょうね？</span></p> 
   <p begin="00:53:53.189" end="00:53:54.732" style="s1"><span style="s2">４号機は…</span></p> 
   <p begin="00:53:55.566" end="00:53:56.901" style="s1"><span style="s2">エヴァ４号機は</span></p> 
   <p begin="00:53:57.068" end="00:54:00.529" style="s1"><span style="s2">稼働時間問題を解決する<br />新型内蔵主機の<span style="s7">―</span></span></p> 
   <p begin="00:54:00.696" end="00:54:02.198" style="s1"><span style="s2">テストベッドだった</span></p> 
   <p begin="00:54:02.573" end="00:54:03.908" style="s1"><span style="s2">…らしいわ</span></p> 
   <p begin="00:54:04.033" end="00:54:06.035" style="s1"><span style="s2">北米ネルフの開発情報は</span></p> 
   <p begin="00:54:06.202" end="00:54:09.080" style="s1"><span style="s2">赤木先輩にも<br />十分に開示されていないんです</span></p> 
   <p begin="00:54:09.705" end="00:54:11.082" style="s1"><span style="s2">知っているのは…</span></p> 
   <p begin="00:54:11.374" end="00:54:12.667" style="s1"><span style="s2">エヴァ４号機</span></p> 
   <p begin="00:54:13.417" end="00:54:17.505" style="s1"><span style="s2">（冬月）<br />次世代型開発データ収得が<br />目的の実験機だ</span></p> 
   <p begin="00:54:17.588" end="00:54:21.092" style="s1"><span style="s2">（冬月）<br />何が起こってもおかしくはない<br />しかし…</span></p> 
   <p begin="00:54:21.842" end="00:54:23.052" style="s1"><span style="s2">ふー</span></p> 
   <p begin="00:54:24.512" end="00:54:26.263" style="s1"><span style="s2">（加持）本当に事故なのか？</span></p> 
   <p begin="00:54:51.914" end="00:54:54.875" style="s1"><span style="s2">（雷鳴）</span></p> 
   <p begin="00:54:56.877" end="00:54:59.088" style="s1"><span style="s2">（トウジ）<br />おばちゃん これ３つや</span></p> 
   <p begin="00:55:01.924" end="00:55:04.760" style="s1"><span style="s2">めずらしいな<br />トウジのおごりなんてさ</span></p> 
   <p begin="00:55:04.927" end="00:55:06.804" style="s1"><span style="s2">ワイも まじめなシンジが</span></p> 
   <p begin="00:55:06.929" end="00:55:09.598" style="s1"><span style="s2">買い食いつきおうてくれるとは<br />思わんかったわ</span></p> 
   <p begin="00:55:09.932" end="00:55:13.978" style="s1"><span style="s2">妹さんの調子 よくなったって<br />素直に言えばいいのに</span></p> 
   <p begin="00:55:14.103" end="00:55:16.439" style="s1"><span style="s2">うるさいわい！ 余計なこと<br />言わんでもええんじゃ アホ！</span></p> 
   <p begin="00:55:16.564" end="00:55:17.565" style="s1"><span style="s2">は…</span></p> 
   <p begin="00:55:22.445" end="00:55:24.572" style="s1"><span style="s2">（ケンスケ）なあ 碇<br />（シンジ）ん？</span></p> 
   <p begin="00:55:24.655" end="00:55:26.949" style="s1"><span style="s2">（ケンスケ）３号機<br />日本に来るんだって？</span></p> 
   <p begin="00:55:27.116" end="00:55:29.160" style="s1"><span style="s2">（シンジ）そうなの？<br />僕 聞いてないよ</span></p> 
   <p begin="00:55:29.618" end="00:55:31.620" style="s1"><span style="s2">（ケンスケ）<br />いきなり 起動実験込みで<span style="s7">―</span></span></p> 
   <p begin="00:55:31.746" end="00:55:34.248" style="s1"><span style="s2">米国から<br />押し付けられたってウワサだ</span></p> 
   <p begin="00:55:34.331" end="00:55:37.460" style="s1"><span style="s2">まっ 末端の搭乗者は<br />知らなくていい情報なんだろ</span></p> 
   <p begin="00:55:37.585" end="00:55:39.462" style="s1"><span style="s2">なぁ 誰が乗るのかなぁ？</span></p> 
   <p begin="00:55:39.962" end="00:55:42.089" style="s1"><span style="s2">知らないよ 聞いてないから</span></p> 
   <p begin="00:55:43.174" end="00:55:46.969" style="s1"><span style="s2">（ケンスケ）<br />いいなあ パイロット<br />オレにしてくんないかなぁ</span></p> 
   <p begin="00:55:47.344" end="00:55:48.888" style="s1"><span style="s2">（シンジ）僕に言われても</span></p> 
   <p begin="00:55:49.096" end="00:55:49.263" region="縦右">（シンジ）ミサトさんに<br />頼んでみて…</p> 
   <p begin="00:55:49.263" end="00:55:50.639" region="縦右">（シンジ）ミサトさんに<br />頼んでみて…</p> 
   <p begin="00:55:49.263" end="00:55:50.639" style="s1"><span style="s2">ん…<br />ちっ ハズレかいな</span></p> 
   <p begin="00:55:50.639" end="00:55:51.974" style="s1"><span style="s2">ん…<br />ちっ ハズレかいな</span></p> 
   <p begin="00:56:03.611" end="00:56:07.323" style="s1"><span style="s2">（キール）先に<br />エヴァンゲリオン５号機が失われ…</span></p> 
   <p begin="00:56:07.823" end="00:56:10.659" style="s1"><span style="s2">（ゼーレ04）<br />今 同４号機も失われた</span></p> 
   <p begin="00:56:11.035" end="00:56:15.331" style="s1"><span style="s2">（ゲンドウ）両機の喪失は<br />計画遂行に支障をきたしますが</span></p> 
   <p begin="00:56:15.498" end="00:56:18.667" style="s1"><span style="s2">（ゼーレ05）修正の範囲内だ<br />問題はなかろう</span></p> 
   <p begin="00:56:19.001" end="00:56:20.169" style="s1"><span style="s2">（ゼーレ03）エヴァ３号機は<span style="s7">―</span></span></p> 
   <p begin="00:56:20.294" end="00:56:23.339" style="s1"><span style="s2">米国政府が是非にと<br />君へ差し出した</span></p> 
   <p begin="00:56:23.547" end="00:56:26.217" style="s1"><span style="s2">君の国の政府も協力的だ</span></p> 
   <p begin="00:56:26.383" end="00:56:29.887" style="s1"><span style="s2">（ゼーレ06）最新鋭機だ<br />主戦力に足るだろう</span></p> 
   <p begin="00:56:30.012" end="00:56:33.015" style="s1"><span style="s2">（ゲンドウ）使徒殲滅は<br />現在も遂行中です</span></p> 
   <p begin="00:56:33.182" end="00:56:36.143" style="s1"><span style="s2">（ゲンドウ）試験前の機体は<br />信頼に足りません</span></p> 
   <p begin="00:56:36.227" end="00:56:40.314" style="s1"><span style="s2">（ゲンドウ）<br />零号機修復の追加補正予算を<br />承認いただければ…</span></p> 
   <p begin="00:56:40.397" end="00:56:43.359" style="s1"><span style="s2">（ゼーレ03）試作品の役割は<br />もはや終わりつつある</span></p> 
   <p begin="00:56:43.526" end="00:56:44.860" style="s1"><span style="s2">（ゼーレ03）<br />必要はあるまい</span></p> 
   <p begin="00:56:45.069" end="00:56:48.531" style="s1"><span style="s2">（ゼーレ06）左様<br />優先すべき事柄は他にある</span></p> 
   <p begin="00:56:48.864" end="00:56:52.076" style="s1"><span style="s2">（キール）<br />我らの望む真のエヴァンゲリオン</span></p> 
   <p begin="00:56:52.201" end="00:56:56.872" style="s1"><span style="s2">その誕生とリリスの復活をもって<br />契約の時となる</span></p> 
   <p begin="00:56:57.039" end="00:57:00.501" style="s1"><span style="s2">それまでに 必要な儀式は<br />執り行わねばならん</span></p> 
   <p begin="00:57:01.168" end="00:57:03.712" style="s1"><span style="s2">人類補完計画のために</span></p> 
   <p begin="00:57:03.921" end="00:57:08.384" style="s1"><span style="s2">（ゲンドウ）わかっております<br />全てはゼーレのシナリオ通りに</span></p> 
   <p begin="00:57:11.720" end="00:57:13.347" style="s1"><span style="s2">（ゲンドウ）<br />真のエヴァンゲリオン…</span></p> 
   <p begin="00:57:13.430" end="00:57:14.682" style="s1"><span style="s2">（照明切り替え音）</span></p> 
   <p begin="00:57:14.765" end="00:57:17.351" style="s1"><span style="s2">その完成までの露払いが</span></p> 
   <p begin="00:57:17.434" end="00:57:21.147" style="s1"><span style="s2">初号機を含む<br />現機体の務めというわけだ</span></p> 
   <p begin="00:57:21.230" end="00:57:23.732" style="s1"><span style="s2">（冬月）<br />それがあのMark.06なのか？</span></p> 
   <p begin="00:57:24.108" end="00:57:29.238" style="s1"><span style="s2">偽りの神ではなく ついに<br />本物の神を創ろうというわけか</span></p> 
   <p begin="00:57:29.738" end="00:57:33.576" style="s1"><span style="s2">ああ<br />初号機の覚醒を急がねばならん</span></p> 
   <p begin="00:57:40.291" end="00:57:43.294" style="s1"><span style="s2">（アスカ）<br />なんであたしの２号機が<br />封印されちゃうのよ？</span></p> 
   <p begin="00:57:43.460" end="00:57:48.215" style="s1"><span style="s2">（リツコ）<br />バチカン条約 知ってるでしょ<br />３号機との引き換え条件よ</span></p> 
   <p begin="00:57:48.424" end="00:57:51.093" style="s1"><span style="s2">修理中の零号機にすれば<br />いいじゃない！</span></p> 
   <p begin="00:57:51.260" end="00:57:54.930" style="s1"><span style="s2">（伊吹）２号機のパスは<br />今でもユーロが保有しているの</span></p> 
   <p begin="00:57:55.055" end="00:57:57.266" style="s1"><span style="s2">（伊吹）私たちには<br />どうにも出来ないのよ</span></p> 
   <p begin="00:57:57.433" end="00:57:59.643" style="s1"><span style="s2">（リツコ）<br />現在はパイロットも白紙</span></p> 
   <p begin="00:57:59.768" end="00:58:02.980" style="s1"><span style="s2">（リツコ）<br />ユーロから再通知があるまでは<br />おとなしくしてなさい</span></p> 
   <p begin="00:58:03.480" end="00:58:05.816" style="s1"><span style="s2">私以外 誰も乗れないのに…</span></p> 
   <p begin="00:58:05.983" end="00:58:07.776" style="s1"><span style="s2">エヴァは実戦兵器よ</span></p> 
   <p begin="00:58:08.068" end="00:58:10.571" style="s1"><span style="s2">（リツコ）全てに<br />バックアップを用意しているわ</span></p> 
   <p begin="00:58:10.654" end="00:58:12.615" style="s1"><span style="s2">（リツコ）操縦者も含めてね</span></p> 
   <p begin="00:58:12.781" end="00:58:14.283" style="s1"><span style="s2">そんな…</span></p> 
   <p begin="00:58:15.451" end="00:58:19.371" style="s1"><span style="s2">（アスカ）私の<br />世界で唯一の居場所なのに…</span></p> 
   <p begin="00:58:19.496" end="00:58:20.998" style="s1"><span style="s2">（エレベーター到着ベル）</span></p> 
   <p begin="00:58:22.166" end="00:58:23.417" style="s1"><span style="s2">あ…</span></p> 
   <p begin="00:58:24.168" end="00:58:25.252" style="s1"><span style="s2">んっ</span></p> 
   <p begin="00:58:40.142" end="00:58:41.352" style="s1"><span style="s2">（鼻をすする音）</span></p> 
   <p begin="00:58:42.853" end="00:58:45.189" style="s1"><span style="s2">エヴァは… 自分の心の鏡</span></p> 
   <p begin="00:58:45.314" end="00:58:46.315" style="s1"><span style="s2">何ですって？</span></p> 
   <p begin="00:58:46.523" end="00:58:48.525" style="s1"><span style="s2">（レイ）エヴァに頼らなくていい</span></p> 
   <p begin="00:58:48.692" end="00:58:51.362" style="s1"><span style="s2">（レイ）あなたには<br />エヴァに乗らない幸せがある</span></p> 
   <p begin="00:58:51.528" end="00:58:54.573" style="s1"><span style="s2">えっらそうなこと言わないでっ！<br />エコヒイキのくせに！</span></p> 
   <p begin="00:58:57.201" end="00:58:58.869" style="s1"><span style="s2">私が天才だったから</span></p> 
   <p begin="00:58:58.994" end="00:59:01.205" style="s1"><span style="s2">自分の力で<br />パイロットに選ばれたのよ！</span></p> 
   <p begin="00:59:01.497" end="00:59:03.707" style="s1"><span style="s2">コネで乗ってる<br />あんたたちとは違うの！</span></p> 
   <p begin="00:59:03.999" end="00:59:06.377" style="s1"><span style="s2">（レイ）<br />私はつながっているだけ</span></p> 
   <p begin="00:59:06.835" end="00:59:09.672" style="s1"><span style="s2">（レイ）エヴァでしか<br />ヒトとつながらないだけ</span></p> 
   <p begin="00:59:09.838" end="00:59:11.048" style="s1"><span style="s2">うるさい！ あんた<span style="s7">―</span></span></p> 
   <p begin="00:59:11.173" end="00:59:14.051" style="s1"><span style="s2">碇司令の言うことは何でも聞く<br />お澄まし人形だから</span></p> 
   <p begin="00:59:14.176" end="00:59:15.886" style="s1"><span style="s2">ヒイキされてるだけでしょ！</span></p> 
   <p begin="00:59:16.220" end="00:59:17.596" style="s1"><span style="s2">（レイ）私は人形じゃない</span></p> 
   <p begin="00:59:17.721" end="00:59:21.016" style="s1"><span style="s2">人形よっ！<br />少しは自分を 知りなさいよ！</span></p> 
   <p begin="00:59:21.684" end="00:59:22.685" style="s1"><span style="s2">う！</span></p> 
   <p begin="00:59:31.735" end="00:59:34.905" style="s1"><span style="s2">ふん<br />人形のくせに生意気ね</span></p> 
   <p begin="00:59:42.079" end="00:59:45.541" style="s1"><span style="s2">ひとつだけ聞くわ<br />あのバカをどう思ってるの？</span></p> 
   <p begin="00:59:45.833" end="00:59:46.834" style="s1"><span style="s2">バカ？</span></p> 
   <p begin="00:59:46.917" end="00:59:49.044" style="s1"><span style="s2">バカといえば<br />バカシンジでしょ</span></p> 
   <p begin="00:59:49.378" end="00:59:50.504" style="s1"><span style="s2">碇君？</span></p> 
   <p begin="00:59:51.088" end="00:59:52.214" style="s1"><span style="s2">どうなの？</span></p> 
   <p begin="00:59:53.048" end="00:59:54.717" style="s1"><span style="s2">よく わからない…</span></p> 
   <p begin="00:59:54.883" end="00:59:58.095" style="s1"><span style="s2">これだから日本人は<br />ハッキリしなさいよ！</span></p> 
   <p begin="00:59:58.595" end="01:00:03.934" style="s1"><span style="s2">わからない ただ 碇君と<br />いっしょにいると ポカポカする</span></p> 
   <p begin="01:00:04.601" end="01:00:08.105" style="s1"><span style="s2">私も 碇君にポカポカして欲しい</span></p> 
   <p begin="01:00:08.772" end="01:00:13.736" style="s1"><span style="s2">碇司令と仲良くなって<br />ポカポカして欲しいと 思う</span></p> 
   <p begin="01:00:14.611" end="01:00:16.030" style="s1"><span style="s2">わかった…</span></p> 
   <p begin="01:00:21.201" end="01:00:24.121" style="s1"><span style="s2">ほんと<br />つくづくウルトラバカね！</span></p> 
   <p begin="01:00:24.413" end="01:00:26.749" style="s1"><span style="s2">それって<br />好きってことじゃん</span></p> 
   <p begin="01:00:28.292" end="01:00:34.298" style="s1"><span style="s2">んんーっ！<br />楽しみだな 食事会…</span></p> 
   <p begin="01:00:35.132" end="01:00:38.427" style="s1"><span style="s2">けど<br />綾波の料理って大丈夫かな</span></p> 
   <p begin="01:00:41.930" end="01:00:44.558" style="s1"><span style="s2">父さんも 来ればいいのに</span></p> 
   <p begin="01:00:45.267" end="01:00:49.438" style="s1"><span style="s2">（アナウンス）<br />第７ケイジにおける<br />ダミーシステムの第１回無人単独…</span></p> 
   <p begin="01:00:49.521" end="01:00:52.441" style="s1"><span style="s2">（ミサト）<br />あれが… ダミーシステム</span></p> 
   <p begin="01:00:52.608" end="01:00:55.110" style="s1"><span style="s2">（日向）あくまで<br />パイロット補助との名目ですが</span></p> 
   <p begin="01:00:55.277" end="01:00:57.321" style="s1"><span style="s2">（日向）<br />単独での自律制御だけでなく<span style="s7">―</span></span></p> 
   <p begin="01:00:57.488" end="01:01:00.157" style="s1"><span style="s2">無人状態での<br />Ａ.Ｔ.フィールド発生まで可能</span></p> 
   <p begin="01:01:00.491" end="01:01:03.994" style="s1"><span style="s2">子供に操縦させるよりは<br />人道的だそうです</span></p> 
   <p begin="01:01:07.790" end="01:01:08.624" region="縦右">（机を叩く音）</p> 
   <p begin="01:01:08.624" end="01:01:08.791" region="縦右">（机を叩く音）</p> 
   <p begin="01:01:08.624" end="01:01:08.791" style="s1"><span style="s2">あの新型の<br />ダミーシステムってやつ</span></p> 
   <p begin="01:01:08.791" end="01:01:11.168" style="s1"><span style="s2">あの新型の<br />ダミーシステムってやつ</span></p> 
   <p begin="01:01:11.460" end="01:01:14.129" style="s1"><span style="s2">何か いけ好かないんだけどー</span></p> 
   <p begin="01:01:14.588" end="01:01:17.674" style="s1"><span style="s2">ゴルゴダベースからの<br />厳封直送品だからな</span></p> 
   <p begin="01:01:17.966" end="01:01:19.635" style="s1"><span style="s2">得体は知れないままだ</span></p> 
   <p begin="01:01:20.928" end="01:01:23.931" style="s1"><span style="s2">そんな危なっかしいもんに<br />エヴァをあずけるなんて</span></p> 
   <p begin="01:01:24.098" end="01:01:25.140" style="s1"><span style="s2">気が知れないわ</span></p> 
   <p begin="01:01:25.516" end="01:01:29.019" style="s1"><span style="s2">人間だから あのエヴァを<br />まかせておけるってことか</span></p> 
   <p begin="01:01:29.978" end="01:01:32.940" style="s1"><span style="s2">（加持）信用されているな<br />シンジくんは いや…</span></p> 
   <p begin="01:01:33.148" end="01:01:35.317" style="s1"><span style="s2">シンジくんだからこそか</span></p> 
   <p begin="01:01:35.651" end="01:01:36.652" style="s1"><span style="s2">それより</span></p> 
   <p begin="01:01:37.152" end="01:01:40.197" style="s1"><span style="s2">ゼーレとかいう<br />うちの上層組織の情報…</span></p> 
   <p begin="01:01:40.531" end="01:01:41.990" style="s1"><span style="s2">もらえないかしら</span></p> 
   <p begin="01:01:43.325" end="01:01:45.869" style="s1"><span style="s2">（加持）例の計画を<br />探りたいのならやめておけ</span></p> 
   <p begin="01:01:46.120" end="01:01:49.665" style="s1"><span style="s2">そうもいかないわ<br />人類補完計画</span></p> 
   <p begin="01:01:49.832" end="01:01:52.000" style="s1"><span style="s2">ネルフは裏で<br />何をしようとしてるの？</span></p> 
   <p begin="01:01:52.501" end="01:01:54.002" style="s1"><span style="s2">それは…</span></p> 
   <p begin="01:01:56.839" end="01:01:59.007" style="s1"><span style="s2">（加持）<br />オレも知りたいところさ</span></p> 
   <p begin="01:02:01.468" end="01:02:05.889" style="s1"><span style="s2">久かたぶりの食事だってのに<br />仕事の話ばっかりだな</span></p> 
   <p begin="01:02:06.390" end="01:02:08.517" style="s1"><span style="s2">（ミサト）<br />学生時代とは違うわよ</span></p> 
   <p begin="01:02:09.184" end="01:02:12.688" style="s1"><span style="s2">色んなことを知ったし<br />背負ってしまった</span></p> 
   <p begin="01:02:12.855" end="01:02:16.316" style="s1"><span style="s2">お互い自分のことだけ<br />考えているわけにはいかないか</span></p> 
   <p begin="01:02:16.692" end="01:02:18.235" style="s1"><span style="s2">シンジ君たちは</span></p> 
   <p begin="01:02:18.360" end="01:02:21.029" style="s1"><span style="s2">もっと大きなモノを<br />背負わされてるし</span></p> 
   <p begin="01:02:21.196" end="01:02:24.324" style="s1"><span style="s2">（加持）<br />ああ… 子供には重すぎるよ</span></p> 
   <p begin="01:02:24.575" end="01:02:27.661" style="s1"><span style="s2">（加持）だが<br />俺達はそこに頼るしかない</span></p> 
   <p begin="01:02:28.162" end="01:02:32.249" region="縦右">（ケータイ着信音）</p> 
   <p begin="01:02:32.249" end="01:02:33.750" region="縦右">（ケータイ着信音）</p> 
   <p begin="01:02:32.249" end="01:02:33.750" style="s1"><span style="s2">（ミサト）はぁ～</span></p> 
   <p begin="01:02:34.042" end="01:02:35.085" style="s1"><span style="s2">（ミサト）はい</span></p> 
   <p begin="01:02:35.836" end="01:02:40.048" style="s1"><span style="s2">（ミサト）ええ わかってるわ<br />日付変更までには結論出すわよ</span></p> 
   <p begin="01:02:41.508" end="01:02:42.926" style="s1"><span style="s2">（加持）リッちゃんか？<br />（ミサト）そう</span></p> 
   <p begin="01:02:43.051" end="01:02:45.846" style="s1"><span style="s2">３号機テストパイロットの件で<br />矢の催促</span></p> 
   <p begin="01:02:46.180" end="01:02:48.223" style="s1"><span style="s2">（加持）<br />人選は君の責任だからな</span></p> 
   <p begin="01:02:48.515" end="01:02:50.559" style="s1"><span style="s2">それはそうなんだけど</span></p> 
   <p begin="01:02:50.893" end="01:02:53.896" style="s1"><span style="s2">３号機到着の<br />予定がずれちゃって…</span></p> 
   <p begin="01:02:54.938" end="01:02:57.024" style="s1"><span style="s2">よりにもよって<br />この日なのよね</span></p> 
   <p begin="01:02:57.399" end="01:03:00.402" style="s1"><span style="s2">３号機起動実験の<br />予定日って…</span></p> 
   <p begin="01:03:01.361" end="01:03:03.572" style="s1"><span style="s2">エコヒイキの約束の日じゃない</span></p> 
   <p begin="01:03:08.535" end="01:03:10.078" style="s1"><span style="s2">よっ！ と</span></p> 
   <p begin="01:03:11.246" end="01:03:13.123" style="s1"><span style="s2">（ケータイ操作音）</span></p> 
   <p begin="01:03:13.749" end="01:03:14.875" style="s1"><span style="s2">はぁ…</span></p> 
   <p begin="01:03:31.141" end="01:03:33.393" style="s1"><span style="s2">（リツコ）<br />そう アスカに決定ね</span></p> 
   <p begin="01:03:34.603" end="01:03:37.648" style="s1"><span style="s2">（リツコ）<br />ええ 私は最後の便で<br />松代に向かうわ</span></p> 
   <p begin="01:03:38.232" end="01:03:39.775" style="s1"><span style="s2">（リツコ）<br />あとはお願いね マヤ</span></p> 
   <p begin="01:03:39.900" end="01:03:41.443" style="s1"><span style="s2">（伊吹）ハイ！ せんぱい</span></p> 
   <p begin="01:03:42.069" end="01:03:43.946" style="s1"><span style="s2">（レイ）あの… 赤木博士</span></p> 
   <p begin="01:03:44.488" end="01:03:45.489" style="s1"><span style="s2">あ？</span></p> 
   <p begin="01:03:46.448" end="01:03:48.825" style="s1"><span style="s2">（レイ）<br />２番目の娘に伝えたいことが…</span></p> 
   <p begin="01:03:49.910" end="01:03:51.578" style="s1"><span style="s2">お願いします</span></p> 
   <p begin="01:04:02.464" end="01:04:05.092" style="s1"><span style="s2">（留守電アナウンス）１件の<br />新しいメッセージがあります</span></p> 
   <p begin="01:04:05.592" end="01:04:07.386" style="s1"><span style="s2">１番目のメッセージです</span></p> 
   <p begin="01:04:07.469" end="01:04:08.804" style="s1"><span style="s2">（確認音）</span></p> 
   <p begin="01:04:09.137" end="01:04:11.807" style="s1"><span style="s2">（リツコ）<br />はい レイ 話していいわよ</span></p> 
   <p begin="01:04:14.434" end="01:04:15.644" style="s1"><span style="s2">ふぅ…</span></p> 
   <p begin="01:04:17.145" end="01:04:18.188" style="s1"><span style="s2">ん？</span></p> 
   <p begin="01:04:21.942" end="01:04:24.194" style="s1"><span style="s2">んんんっ… ちっ…</span></p> 
   <p begin="01:04:24.319" end="01:04:26.196" style="s1"><span style="s2">（レイ）…ありがとう<br />（アスカ）あ…</span></p> 
   <p begin="01:04:28.365" end="01:04:28.865" region="縦右">（ケータイ操作音）</p> 
   <p begin="01:04:28.865" end="01:04:29.366" region="縦右">（ケータイ操作音）</p> 
   <p begin="01:04:28.865" end="01:04:29.366" style="s1"><span style="s2">（アスカ）<br />ふんっ！バッカじゃないの<br />私がエヴァに乗りたいだけなのに</span></p> 
   <p begin="01:04:29.366" end="01:04:32.786" style="s1"><span style="s2">（アスカ）<br />ふんっ！バッカじゃないの<br />私がエヴァに乗りたいだけなのに</span></p> 
   <p begin="01:04:37.541" end="01:04:41.670" style="s1"><span style="s2">（アスカ）<br />３号機 私が気に入ったら<br />赤く塗り替えてよね</span></p> 
   <p begin="01:04:45.215" end="01:04:47.968" style="s1"><span style="s2">（ヒカリ）おはよう 相田くん<br />（ケンスケ）ウイィィーッス</span></p> 
   <p begin="01:04:48.135" end="01:04:49.469" style="s1"><span style="s2">あれ？ トウジは</span></p> 
   <p begin="01:04:49.636" end="01:04:54.474" style="s1"><span style="s2">今日は小田原の病院<br />妹さん 退院するんだって</span></p> 
   <p begin="01:04:55.183" end="01:04:56.810" style="s1"><span style="s2">え　あ そっか</span></p> 
   <p begin="01:04:57.144" end="01:04:58.395" style="s1"><span style="s2">（ケンスケ）トウジから伝言</span></p> 
   <p begin="01:04:58.645" end="01:05:03.400" style="s1"><span style="s2">（ケンスケ）“もう気にすんなや<br />妹も感謝しとる” だってさ</span></p> 
   <p begin="01:05:05.027" end="01:05:07.029" style="s1"><span style="s2">碇 ホントによかったな</span></p> 
   <p begin="01:05:07.988" end="01:05:09.072" style="s1"><span style="s2">うん</span></p> 
   <p begin="01:05:09.323" end="01:05:13.660" style="s1"><span style="s2">今日は綾波に<br />お呼ばれなんだろ</span></p> 
   <p begin="01:05:13.910" end="01:05:16.496" style="s1"><span style="s2">（ケンスケ）<br />ホントうらやましいよ！</span></p> 
   <p begin="01:05:13.910" end="01:05:16.496" region="縦右">（シンジ）<br />うわっ！ くるし…</p> 
   <p begin="01:05:16.580" end="01:05:17.748" style="s1"><span style="s2">（二人）うわぁ…</span></p> 
   <p begin="01:05:25.047" end="01:05:28.884" style="s1"><span style="s2">（アナウンス）<br />エヴァ３号機 有人起動試験<br />統括責任者到着</span></p> 
   <p begin="01:05:29.009" end="01:05:31.011" style="s1"><span style="s2">現在 主管制室に移動中</span></p> 
   <p begin="01:05:31.094" end="01:05:33.221" style="s1"><span style="s2">（アナウンス）<br />地上仮設ケイジ 拘束システムの<br />チェック完了 問題なし</span></p> 
   <p begin="01:05:33.347" end="01:05:35.349" style="s1"><span style="s2">（アナウンス）<br />アンビリカルケーブル<br />接続作業開始</span></p> 
   <p begin="01:05:37.559" end="01:05:39.061" style="s1"><span style="s2">（アナウンス）<br />コネクタの接続を確認</span></p> 
   <p begin="01:05:39.186" end="01:05:42.898" style="s1"><span style="s2">（アナウンス）<br />主電源切り換え終了<br />内部電圧は規定値をクリア</span></p> 
   <p begin="01:05:44.191" end="01:05:46.610" style="s1"><span style="s2">（アナウンス）<br />エントリープラグ<br />挿入位置で固定完了</span></p> 
   <p begin="01:05:46.735" end="01:05:49.905" style="s1"><span style="s2">（アナウンス）<br />リスト1350までをチェック<br />問題なし</span></p> 
   <p begin="01:05:50.030" end="01:05:52.074" style="s1"><span style="s2">了解 カウントダウンを再開</span></p> 
   <p begin="01:05:52.157" end="01:05:55.369" style="s1"><span style="s2">（アナウンス）<br />カウントダウンを再開<br />地上作業員は総員退避</span></p> 
   <p begin="01:05:55.452" end="01:05:59.873" style="s1"><span style="s2">（アナウンス）<br />テストパイロットの医学検査終了<br />現在 移動隔離室にて待機中</span></p> 
   <p begin="01:06:00.040" end="01:06:02.542" style="s1"><span style="s2">あとはリツコに引き継いで<br />問題なさそうね</span></p> 
   <p begin="01:06:02.709" end="01:06:04.127" region="縦右">（ケータイ着信音）</p> 
   <p begin="01:06:04.127" end="01:06:05.212" region="縦右">（ケータイ着信音）</p> 
   <p begin="01:06:04.127" end="01:06:05.212" style="s1"><span style="s2">（ミサト）ん？</span></p> 
   <p begin="01:06:05.212" end="01:06:06.254" region="縦右">（ケータイ着信音）</p> 
   <p begin="01:06:06.588" end="01:06:09.049" style="s1"><span style="s2">守秘回線？ アスカから？</span></p> 
   <p begin="01:06:12.052" end="01:06:14.262" style="s1"><span style="s2">（ミサト）<br />どうしたのアスカ 本番前に</span></p> 
   <p begin="01:06:14.638" end="01:06:17.933" style="s1"><span style="s2">（アスカ）なんだか<br />ミサトと二人で話がしたくってさ</span></p> 
   <p begin="01:06:18.809" end="01:06:21.144" style="s1"><span style="s2">そう… 今日のこと</span></p> 
   <p begin="01:06:21.269" end="01:06:24.147" style="s1"><span style="s2">改めてお礼を言うわ<br />ありがとう</span></p> 
   <p begin="01:06:27.442" end="01:06:29.152" style="s1"><span style="s2">礼はいいわ</span></p> 
   <p begin="01:06:30.445" end="01:06:33.323" style="s1"><span style="s2">愚民を助けるのは<br />エリートの義務ってだけよ</span></p> 
   <p begin="01:06:34.116" end="01:06:36.910" style="s1"><span style="s2">（アスカ）元々<br />みんなで食事ってのが苦手だし</span></p> 
   <p begin="01:06:37.411" end="01:06:40.914" style="s1"><span style="s2">他人と合わせて<br />楽しいフリをするのも疲れるし</span></p> 
   <p begin="01:06:41.248" end="01:06:43.625" style="s1"><span style="s2">他人の幸せを見るのが<br />イヤだったし</span></p> 
   <p begin="01:06:44.292" end="01:06:46.420" style="s1"><span style="s2">私はエヴァに乗れれば<br />よかったんだし</span></p> 
   <p begin="01:06:46.962" end="01:06:51.133" style="s1"><span style="s2">（アスカ）<br />元々一人が好きなんだし<br />馴れ合いの友達はいらなかったし</span></p> 
   <p begin="01:06:51.800" end="01:06:54.845" style="s1"><span style="s2">私をちゃんと見てくれる人は<br />初めからいないし</span></p> 
   <p begin="01:06:55.303" end="01:06:59.433" style="s1"><span style="s2">戦績のトップスコアさえあれば<br />ネルフで一人でも食べていけるしね</span></p> 
   <p begin="01:07:00.809" end="01:07:04.980" style="s1"><span style="s2">（アスカ）<br />でも最近 他人といるのもいいな<br />って思うこともあったんだ</span></p> 
   <p begin="01:07:05.856" end="01:07:07.774" style="s1"><span style="s2">私には似合わないけど</span></p> 
   <p begin="01:07:07.941" end="01:07:09.276" style="s1"><span style="s2">（ミサト）そんなことないわよ</span></p> 
   <p begin="01:07:09.985" end="01:07:11.486" style="s1"><span style="s2">（ミサト）アスカは優しいから…</span></p> 
   <p begin="01:07:12.821" end="01:07:15.490" style="s1"><span style="s2">（アスカ）<br />こんな話 ミサトが初めて</span></p> 
   <p begin="01:07:15.782" end="01:07:19.953" style="s1"><span style="s2">なんだか楽になったわ<br />誰かと話すって心地いいのね</span></p> 
   <p begin="01:07:20.454" end="01:07:21.621" style="s1"><span style="s2">知らなかった…</span></p> 
   <p begin="01:07:22.164" end="01:07:25.167" style="s1"><span style="s2">（ミサト）この世界は<br />あなたの知らない面白いことで<span style="s7">―</span></span></p> 
   <p begin="01:07:25.292" end="01:07:28.336" style="s1"><span style="s2">満ち満ちているわよ<br />たのしみなさい</span></p> 
   <p begin="01:07:29.838" end="01:07:34.134" style="s1"><span style="s2">うん そうね ありがとうミサト</span></p> 
   <p begin="01:07:35.135" end="01:07:37.846" style="s1"><span style="s2">ところでさ<br />赤いのはいいんだけど</span></p> 
   <p begin="01:07:37.971" end="01:07:42.809" style="s1"><span style="s2">このテスト用プラグスーツって<br />見えすぎじゃない？</span></p> 
   <p begin="01:07:43.143" end="01:07:44.478" style="s1"><span style="s2">（オペレーター）<br />エントリー スタート</span></p> 
   <p begin="01:07:44.561" end="01:07:49.316" style="s1"><span style="s2">（オペレーター）<br />ＬＣＬ電荷 圧力正常値<br />第１励起状態を維持</span></p> 
   <p begin="01:07:49.483" end="01:07:52.986" style="s1"><span style="s2">（オペレーター）<br />プラグセンサー 問題なし<br />検査数値は誤差範囲内</span></p> 
   <p begin="01:07:53.320" end="01:07:57.866" style="s1"><span style="s2">（リツコ）<br />了解 作業をフェイズ２へ移行<br />第２次接続開始</span></p> 
   <p begin="01:07:58.325" end="01:08:01.703" region="縦右">そっか… 私 笑えるんだ</p> 
   <p begin="01:08:02.037" end="01:08:03.330" region="縦右">（水音）</p> 
   <p begin="01:08:03.413" end="01:08:04.414" region="縦右">あ？</p> 
   <p begin="01:08:07.709" end="01:08:08.877" style="s1"><span style="s2">あ あ… ああ？</span></p> 
   <p begin="01:08:08.877" end="01:08:09.920" style="s1"><span style="s2">あ あ… ああ？</span></p> 
   <p begin="01:08:08.877" end="01:08:09.920" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:09.920" end="01:08:10.337" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:10.337" end="01:08:11.379" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:10.337" end="01:08:11.379" style="s1"><span style="s2">あ…</span></p> 
   <p begin="01:08:11.379" end="01:08:13.089" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:13.089" end="01:08:14.090" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:13.089" end="01:08:14.090" style="s1"><span style="s2">うっ！</span></p> 
   <p begin="01:08:14.090" end="01:08:16.176" region="縦右">（多くの子供の笑い声）</p> 
   <p begin="01:08:16.176" end="01:08:17.219" style="s1"><span style="s2">ああっ！</span></p> 
   <p begin="01:08:18.220" end="01:08:21.848" style="s1"><span style="s2">（オペレーター）<br />プラグ深度100をオーバー！<br />精神汚染濃度も危険域に突入！</span></p> 
   <p begin="01:08:22.057" end="01:08:23.058" style="s1"><span style="s2">（ミサト）何故 急に？</span></p> 
   <p begin="01:08:23.183" end="01:08:24.935" style="s1"><span style="s2">（オペレーター）<br />パイロット安全深度を越えます</span></p> 
   <p begin="01:08:25.060" end="01:08:28.271" style="s1"><span style="s2">引き止めて！ このままでは<br />搭乗員がヒトでなくなってしまう！</span></p> 
   <p begin="01:08:28.396" end="01:08:30.023" style="s1"><span style="s2">実験中止！　回路切断！</span></p> 
   <p begin="01:08:30.774" end="01:08:33.235" style="s1"><span style="s2">（オペレーター）だめです<br />体内に高エネルギー反応</span></p> 
   <p begin="01:08:34.277" end="01:08:35.278" style="s1"><span style="s2">まさか</span></p> 
   <p begin="01:08:36.071" end="01:08:37.072" style="s1"><span style="s2">使徒？!</span></p> 
   <p begin="01:08:38.031" end="01:08:39.699" style="s1"><span style="s2">（咆哮）</span></p> 
   <p begin="01:08:44.079" end="01:08:44.955" style="s1"><span style="s2">え？</span></p> 
   <p begin="01:08:44.955" end="01:08:45.080" style="s1"><span style="s2">え？</span></p> 
   <p begin="01:08:44.955" end="01:08:45.080" region="縦右">（タイヤが鳴る音）</p> 
   <p begin="01:08:45.080" end="01:08:49.709" region="縦右">（タイヤが鳴る音）</p> 
   <p begin="01:08:50.794" end="01:08:52.921" style="s1"><span style="s2">（シンジ）松代で爆発事故？</span></p> 
   <p begin="01:09:00.762" end="01:09:02.639" style="s1"><span style="s2">（冬月）被害状況は？<br />（青葉）不明です！</span></p> 
   <p begin="01:09:02.764" end="01:09:06.101" style="s1"><span style="s2">（青葉）<br />仮設ケイジが爆心地の模様<br />地上管理施設の倒壊を確認</span></p> 
   <p begin="01:09:06.476" end="01:09:09.062" style="s1"><span style="s2">（冬月）救助 及び<br />第３部隊を直ちに派遣</span></p> 
   <p begin="01:09:09.396" end="01:09:11.022" style="s1"><span style="s2">（冬月）<br />戦自が介入する前に</span></p> 
   <p begin="01:09:11.106" end="01:09:12.440" style="s1"><span style="s2">（冬月）全て処理しろ<br />（青葉）了解</span></p> 
   <p begin="01:09:12.774" end="01:09:15.610" style="s1"><span style="s2">事故現場南西に<br />未確認移動物体を発見</span></p> 
   <p begin="01:09:15.735" end="01:09:18.446" style="s1"><span style="s2">パターンオレンジ<br />使徒とは確認出来ません</span></p> 
   <p begin="01:09:19.406" end="01:09:21.116" style="s1"><span style="s2">第一種戦闘配置</span></p> 
   <p begin="01:09:21.199" end="01:09:22.242" style="s1"><span style="s2">碇…</span></p> 
   <p begin="01:09:22.325" end="01:09:24.786" style="s1"><span style="s2">総員 第一種戦闘配置だ</span></p> 
   <p begin="01:09:24.953" end="01:09:27.122" style="s1"><span style="s2">（ゲンドウ）<br />修復中の零号機は待機</span></p> 
   <p begin="01:09:27.289" end="01:09:30.792" style="s1"><span style="s2">初号機はダミープラグに換装後<br />ただちに出撃させろ</span></p> 
   <p begin="01:09:34.504" end="01:09:37.424" style="s1"><span style="s2">（無線）第５戦車中隊<br />18号防衛線に展開終了</span></p> 
   <p begin="01:09:37.507" end="01:09:41.303" style="s1"><span style="s2">（無線）<br />主電源延長ケーブルの接続作業は<br />あと２分で完了予定</span></p> 
   <p begin="01:09:41.469" end="01:09:43.305" style="s1"><span style="s2">（無線）<br />支援機動打撃部隊の<br />配置完了</span></p> 
   <p begin="01:09:43.471" end="01:09:46.474" style="s1"><span style="s2">（シンジ）あの…<br />ミサトさんやアスカたちは？</span></p> 
   <p begin="01:09:46.808" end="01:09:50.520" style="s1"><span style="s2">（青葉）現在 全力を挙げて<br />救出作業中だ 心配ない</span></p> 
   <p begin="01:09:51.104" end="01:09:54.608" style="s1"><span style="s2">でも… 他のエヴァも<br />ミサトさんもいなくて</span></p> 
   <p begin="01:09:54.691" end="01:09:56.693" style="s1"><span style="s2">僕一人じゃ<br />どうしようもないですよ</span></p> 
   <p begin="01:09:57.611" end="01:10:02.198" style="s1"><span style="s2">作戦系統に問題はない 今は<br />碇司令が直接指揮を取ってるよ</span></p> 
   <p begin="01:10:02.282" end="01:10:03.658" style="s1"><span style="s2">父さんが？</span></p> 
   <p begin="01:10:03.825" end="01:10:07.037" style="s1"><span style="s2">（青葉）<br />東御付近で映像を捉えました<br />主モニターにまわします</span></p> 
   <p begin="01:10:07.162" end="01:10:08.788" style="s1"><span style="s2">（映像信号切替え音）</span></p> 
   <p begin="01:10:10.415" end="01:10:12.542" style="s1"><span style="s2">（どよめく一同）</span></p> 
   <p begin="01:10:12.667" end="01:10:14.002" style="s1"><span style="s2">（冬月）やはり これか…</span></p> 
   <p begin="01:10:14.169" end="01:10:18.173" style="s1"><span style="s2">（ゲンドウ）<br />活動停止信号を発信<br />エントリープラグを強制射出</span></p> 
   <p begin="01:10:18.548" end="01:10:20.675" style="s1"><span style="s2">（射出装置音）</span></p> 
   <p begin="01:10:21.009" end="01:10:25.180" style="s1"><span style="s2">（伊吹）<br />だめです！ 停止信号及び<br />プラグ排出コード認識しません</span></p> 
   <p begin="01:10:25.263" end="01:10:28.308" style="s1"><span style="s2">（青葉）<br />エントリープラグ周辺に<br />コアらしき浸食部位を確認</span></p> 
   <p begin="01:10:28.516" end="01:10:30.185" style="s1"><span style="s2">（日向）<br />分析パターンでました</span></p> 
   <p begin="01:10:30.352" end="01:10:31.353" style="s1"><span style="s2">…青です</span></p> 
   <p begin="01:10:31.853" end="01:10:35.649" style="s1"><span style="s2">（ゲンドウ）<br />エヴァンゲリオン３号機は<br />現時刻をもって<span style="s4"><span style="s5">破棄</span><span style="s9">はき</span></span></span></p> 
   <p begin="01:10:35.732" end="01:10:38.526" style="s1"><span style="s2">監視対象物を<br />第９使徒と識別する</span></p> 
   <p begin="01:10:39.194" end="01:10:40.862" style="s1"><span style="s2">（無線）<br />目標接近</span></p> 
   <p begin="01:10:41.196" end="01:10:42.864" style="s1"><span style="s2">（無線）<br />地対地迎撃戦 用意</span></p> 
   <p begin="01:10:42.989" end="01:10:44.532" style="s1"><span style="s2">（無線）<br />阻止部隊 攻撃開始</span></p> 
   <p begin="01:10:46.034" end="01:10:47.869" style="s1"><span style="s2">え!？ まさか…</span></p> 
   <p begin="01:10:48.036" end="01:10:50.080" style="s1"><span style="s2">（シンジ）使徒!？<br />これが使徒ですか!？</span></p> 
   <p begin="01:10:50.205" end="01:10:52.332" style="s1"><span style="s2">（ゲンドウ）そうだ 目標だ</span></p> 
   <p begin="01:10:52.540" end="01:10:55.377" style="s1"><span style="s2">目標って これは…</span></p> 
   <p begin="01:10:56.211" end="01:10:58.046" style="s1"><span style="s2">エヴァじゃないか!？</span></p> 
   <p begin="01:10:59.923" end="01:11:01.257" region="縦右">そんな…</p> 
   <p begin="01:11:01.383" end="01:11:04.719" region="縦右" style="s3">（ゲンドウ）<br />目標は接近中だ<br />お前が倒せ</p> 
   <p begin="01:11:04.886" end="01:11:07.847" region="縦右">でも…<br />目標っていったって</p> 
   <p begin="01:11:12.602" end="01:11:14.562" style="s1"><span style="s2">アスカが乗ってるんじゃないの？</span></p> 
   <p begin="01:11:18.566" end="01:11:19.693" style="s1"><span style="s2">アスカが…</span></p> 
   <p begin="01:11:19.859" end="01:11:21.903" style="s1"><span style="s2">（３号機）グオォォ…</span></p> 
   <p begin="01:11:29.911" end="01:11:32.122" style="s1"><span style="s2">（３号機）グオオオオオオ</span></p> 
   <p begin="01:11:43.258" end="01:11:44.926" style="s1"><span style="s2">クソッ あっ！</span></p> 
   <p begin="01:11:45.760" end="01:11:48.430" style="s1"><span style="s2">エントリープラグ…<br />やっぱり乗ってるんだ</span></p> 
   <p begin="01:11:59.107" end="01:12:00.942" style="s1"><span style="s2">うううっ</span></p> 
   <p begin="01:12:16.624" end="01:12:18.793" style="s1"><span style="s2">（３号機）グオオオ グルルル</span></p> 
   <p begin="01:12:24.674" end="01:12:27.010" style="s1"><span style="s2">（オペレーター）<br />装甲部<span style="s4"><span style="s5">頸椎</span><span style="s9">けいつい</span></span>付近に浸食発生</span></p> 
   <p begin="01:12:27.135" end="01:12:29.512" style="s1"><span style="s2">第6200層までの汚染を確認</span></p> 
   <p begin="01:12:29.804" end="01:12:32.640" style="s1"><span style="s2">やはり 浸食タイプか…<br />やっかいだな</span></p> 
   <p begin="01:12:33.183" end="01:12:35.101" style="s1"><span style="s2">（オペレーター）<br />初号機Ａ.Ｔ.フィールド不安定</span></p> 
   <p begin="01:12:35.185" end="01:12:38.938" style="s1"><span style="s2">生命維持に支障発生<br />これ以上はパイロットが危険です！</span></p> 
   <p begin="01:12:39.314" end="01:12:42.484" style="s1"><span style="s2">いかん！ 神経接続を<br />28％にカットだ</span></p> 
   <p begin="01:12:42.776" end="01:12:44.486" style="s1"><span style="s2">（ゲンドウ）待て<br />（冬月）しかし 碇</span></p> 
   <p begin="01:12:44.611" end="01:12:46.488" style="s1"><span style="s2">このままではパイロットが死ぬぞ</span></p> 
   <p begin="01:12:46.654" end="01:12:48.823" style="s1"><span style="s2">シンジ 何故戦わない</span></p> 
   <p begin="01:12:48.948" end="01:12:50.033" style="s1"><span style="s2">だって…</span></p> 
   <p begin="01:12:50.158" end="01:12:52.619" style="s1"><span style="s2">アスカが乗ってるんだよ！<br />父さん！</span></p> 
   <p begin="01:12:52.786" end="01:12:56.331" style="s1"><span style="s2">かまわん そいつは使徒だ！<br />我々の敵だ!!</span></p> 
   <p begin="01:12:56.539" end="01:12:58.666" style="s1"><span style="s2">でも… 出来ないよ！</span></p> 
   <p begin="01:12:59.000" end="01:13:01.044" style="s1"><span style="s2">人殺しなんて出来ないよ!!</span></p> 
   <p begin="01:13:01.169" end="01:13:02.378" style="s1"><span style="s2">おまえが死ぬぞ!!</span></p> 
   <p begin="01:13:02.504" end="01:13:05.673" style="s1"><span style="s2">いいよ！<br />アスカを殺すよりはいい!!</span></p> 
   <p begin="01:13:06.299" end="01:13:10.053" style="s1"><span style="s2">かまわん！ パイロットと初号機の<br />シンクロを全面カットだ</span></p> 
   <p begin="01:13:10.303" end="01:13:11.846" style="s1"><span style="s2">（冬月）碇？<br />（伊吹）カットですか？</span></p> 
   <p begin="01:13:11.971" end="01:13:15.016" style="s1"><span style="s2">（ゲンドウ）そうだ！ 制御を<br />ダミーシステムに切り換えろ</span></p> 
   <p begin="01:13:15.141" end="01:13:18.394" style="s1"><span style="s2">しかし… ダミーシステムには<br />まだ問題も多く</span></p> 
   <p begin="01:13:18.686" end="01:13:20.563" style="s1"><span style="s2">赤木博士の指示もなく…</span></p> 
   <p begin="01:13:20.688" end="01:13:24.025" style="s1"><span style="s2">今のパイロットよりは役に立つ<br />やれ！</span></p> 
   <p begin="01:13:24.484" end="01:13:25.485" style="s1"><span style="s2">はい</span></p> 
   <p begin="01:13:25.568" end="01:13:27.654" style="s1"><span style="s2">ん… あ！</span></p> 
   <p begin="01:13:25.568" end="01:13:27.654" region="縦右">（動力が停止する音）</p> 
   <p begin="01:13:27.737" end="01:13:30.573" style="s1"><span style="s2">はっ… はっ… はっ…</span></p> 
   <p begin="01:13:30.698" end="01:13:34.869" style="s1"><span style="s2">（ディスクが回転する音）</span></p> 
   <p begin="01:13:35.036" end="01:13:36.371" style="s1"><span style="s2">はっ！</span></p> 
   <p begin="01:13:46.047" end="01:13:47.674" style="s1"><span style="s2">（ロック音）</span></p> 
   <p begin="01:13:48.716" end="01:13:51.052" style="s1"><span style="s2">なんだこれ？ …あっ</span></p> 
   <p begin="01:13:52.929" end="01:13:56.808" style="s1"><span style="s2">（ノイズが満ちる）</span></p> 
   <p begin="01:13:56.808" end="01:13:57.892" style="s1"><span style="s2">（ノイズが満ちる）</span></p> 
   <p begin="01:13:56.808" end="01:13:57.892" region="縦右">（シンジ）<span style="s10">!!</span></p> 
   <p begin="01:13:58.393" end="01:13:59.769" style="s1"><span style="s2">何をしてるんだ？ 父さん!!</span></p> 
   <p begin="01:14:00.228" end="01:14:02.689" style="s1"><span style="s2">（伊吹）<br />主管制システム 切り替え終了</span></p> 
   <p begin="01:14:02.772" end="01:14:06.067" style="s1"><span style="s2">（アナウンス）全神経回路<br />ダミーシステムへの直結完了</span></p> 
   <p begin="01:14:06.151" end="01:14:09.988" style="s1"><span style="s2">（アナウンス）<br />ダミーシステムでの稼働限界時間<br />最大208秒です</span></p> 
