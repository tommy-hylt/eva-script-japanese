<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:version="2" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xml:lang="fr-FR">
 <head>
  <styling>
   <style xml:id="AmazonDefaultStyle" tts:fontFamily="monospace" tts:color="white" tts:fontSize="1c"></style>
  </styling>
  <layout>
   <region xml:id="AmazonDefaultRegion" tts:extent="80% 15%" tts:origin="10% 80%" tts:displayAlign="after" tts:textAlign="center"></region>
  </layout>
 </head>
 <body>
  <div>
   <p begin="00:00:39.874" end="00:00:41.292" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[waves crashing]</p>
   <p begin="00:00:52.261" end="00:00:53.637" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[birds cawing]</p>
   <p begin="00:01:08.694" end="00:01:10.654" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Why did it have to show up<br />right now?</p>
   <p begin="00:01:10.738" end="00:01:11.989" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ugh] Just my luck!</p>
   <p begin="00:01:13.073" end="00:01:13.783" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="00:01:14.992" end="00:01:15.659" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="00:01:16.494" end="00:01:19.914" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female voice] <span tts:fontStyle="italic">We're sorry,</span><br /><span tts:fontStyle="italic">regular phone service has been suspended,</span></p>
   <p begin="00:01:19.997" end="00:01:22.583" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">due to a state of special emergency.</span></p>
   <p begin="00:01:22.666" end="00:01:24.043" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji sighs] That sucks.</p>
   <p begin="00:01:24.919" end="00:01:26.504" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Plus I can't get a signal, here.</p>
   <p begin="00:01:26.587" end="00:01:28.547" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And the buses and trains<br />are all shut down.</p>
   <p begin="00:01:32.718" end="00:01:34.470" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I guess I won't meet her, after all.</p>
   <p begin="00:01:35.721" end="00:01:38.182" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll never make it.<br />Might as well go to a shelter.</p>
   <p begin="00:01:40.392" end="00:01:41.685" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[birds fly off]</p>
   <p begin="00:01:45.481" end="00:01:46.524" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing sound]</p>
   <p begin="00:01:48.025" end="00:01:49.068" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[wind]</p>
   <p begin="00:01:51.654" end="00:01:53.364" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="00:01:57.368" end="00:01:58.619" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing sounds]</p>
   <p begin="00:01:59.954" end="00:02:01.539" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[thudding]</p>
   <p begin="00:02:04.792" end="00:02:05.918" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:02:07.628" end="00:02:08.337" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh!</p>
   <p begin="00:02:09.129" end="00:02:10.673" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosions]</p>
   <p begin="00:02:13.717" end="00:02:16.178" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[pilot] All missiles have hit the target!</p>
   <p begin="00:02:16.262" end="00:02:17.137" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:02:19.348" end="00:02:21.517" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing sounds, broken glass]</p>
   <p begin="00:02:24.854" end="00:02:25.563" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Huh!</p>
   <p begin="00:02:28.816" end="00:02:29.900" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[car tyres screeching]</p>
   <p begin="00:02:34.655" end="00:02:36.073" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Good morning. Sorry I'm late.</p>
   <p begin="00:02:36.156" end="00:02:37.032" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:02:51.922" end="00:02:54.008" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Target remains unfazed.</p>
   <p begin="00:02:54.091" end="00:02:56.844" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It is continuing to advance<br />toward Tokyo three.</p>
   <p begin="00:02:56.927" end="00:02:59.179" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Air units ineffective</span><br /><span tts:fontStyle="italic">in stopping the target.</span></p>
   <p begin="00:02:59.263" end="00:03:03.267" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is total war. Deploy all units of<br />the reserve fourth Division immediately.</p>
   <p begin="00:03:03.350" end="00:03:04.768" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Send in everything we have.</p>
   <p begin="00:03:04.852" end="00:03:06.520" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We need to crush that target at all costs.</p>
   <p begin="00:03:06.604" end="00:03:07.938" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosions]</p>
   <p begin="00:03:28.250" end="00:03:30.753" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This makes no sense!<br />We got multiple direct hits!</p>
   <p begin="00:03:30.836" end="00:03:33.422" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A whole armored battalion<br />turned to scrap metal.</p>
   <p begin="00:03:33.505" end="00:03:36.550" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Neither guided missiles nor heavy shells<br />are making a dent on the enemy.</p>
   <p begin="00:03:36.926" end="00:03:40.012" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damn it! We need far more powerful weapons<br />against that thing!</p>
   <p begin="00:03:40.095" end="00:03:42.348" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Fuyutsuki] Is it because<br />it's protected by an A.T. Field?</p>
   <p begin="00:03:42.848" end="00:03:45.601" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Yes. Conventional weapons<br />are useless against the angels.</p>
   <p begin="00:03:45.684" end="00:03:47.019" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[bleeping]</p>
   <p begin="00:03:47.102" end="00:03:47.770" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[card beeps]</p>
   <p begin="00:03:49.188" end="00:03:52.149" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Affirmative, Sir. Yes, Sir.<br />We'll deploy it according to plan.</p>
   <p begin="00:03:52.232" end="00:03:53.400" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[bleeping]</p>
   <p begin="00:03:55.903" end="00:03:56.487" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="00:03:56.570" end="00:03:59.823" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hey wait a minute! Please tell me<br />they're not planning to use an N-two mine!</p>
   <p begin="00:03:59.907" end="00:04:01.033" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Get down!</p>
   <p begin="00:04:02.242" end="00:04:03.619" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="00:04:15.089" end="00:04:16.215" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[both react]</p>
   <p begin="00:04:20.511" end="00:04:21.136" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We won!</p>
   <p begin="00:04:21.595" end="00:04:22.429" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Well, then! It seems</p>
   <p begin="00:04:22.513" end="00:04:25.057" region="AmazonDefaultRegion" style="AmazonDefaultStyle">we won't be requiring<br />your services this time.</p>
   <p begin="00:04:25.140" end="00:04:25.808" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[shock wave]</p>
   <p begin="00:04:26.809" end="00:04:28.769" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- [Misato] Are you alright?<br />- [Shinji] Ugh!</p>
   <p begin="00:04:28.852" end="00:04:31.105" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] I swallowed some sand,<br />but I'm okay.</p>
   <p begin="00:04:31.188" end="00:04:33.190" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's good to hear. Now...</p>
   <p begin="00:04:33.941" end="00:04:36.110" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Push on three... Three!</p>
   <p begin="00:04:36.193" end="00:04:37.194" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="00:04:37.945" end="00:04:39.863" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[heaving]</p>
   <p begin="00:04:41.240" end="00:04:42.032" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="00:04:44.576" end="00:04:47.204" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I couldn't have done it without you.<br />Thanks a lot for your help.</p>
   <p begin="00:04:47.287" end="00:04:48.998" region="AmazonDefaultRegion" style="AmazonDefaultStyle">My pleasure. I should thank you,</p>
   <p begin="00:04:49.081" end="00:04:50.124" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Miss Katsuragi.</p>
   <p begin="00:04:50.582" end="00:04:52.376" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You can call me... Misato.</p>
   <p begin="00:04:53.085" end="00:04:55.713" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's nice to meet you, Shinji Ikari.</p>
   <p begin="00:04:56.046" end="00:04:56.755" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thanks, you too.</p>
   <p begin="00:04:57.339" end="00:05:00.134" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- [Officer A] Current status?<br />- [Officer B] You saw that explosion.</p>
   <p begin="00:05:00.217" end="00:05:01.135" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It must’ve been obliterated.</p>
   <p begin="00:05:01.218" end="00:05:02.720" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Visual feed is back online.</p>
   <p begin="00:05:03.887" end="00:05:04.680" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh!</p>
   <p begin="00:05:04.763" end="00:05:05.764" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crunching sounds]</p>
   <p begin="00:05:09.309" end="00:05:10.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[rumbling]</p>
   <p begin="00:05:15.441" end="00:05:17.484" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That was our most powerful weapon.</p>
   <p begin="00:05:18.277" end="00:05:20.654" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[groans] I can't believe it.</p>
   <p begin="00:05:20.738" end="00:05:21.697" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damn monster!</p>
   <p begin="00:05:22.197" end="00:05:23.115" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[car engine]</p>
   <p begin="00:05:24.366" end="00:05:26.869" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Thank goodness,<br />my little car is still moving!</p>
   <p begin="00:05:26.952" end="00:05:28.829" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I still have twelve months<br />to pay on my loan.</p>
   <p begin="00:05:28.912" end="00:05:31.540" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Would have sucked so bad<br />if they had totaled it! [laughs]</p>
   <p begin="00:05:31.623" end="00:05:33.917" region="AmazonDefaultRegion" style="AmazonDefaultStyle">By the way,<br />I booked us an express transport.</p>
   <p begin="00:05:34.001" end="00:05:36.003" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So! We should make it on time.</p>
   <p begin="00:05:37.212" end="00:05:39.798" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Feel free to ask me questions.<br />You must have a lot.</p>
   <p begin="00:05:40.215" end="00:05:41.383" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Mh, okay.</p>
   <p begin="00:05:41.842" end="00:05:44.178" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I’m the one doing all the talking,<br />so come on now.</p>
   <p begin="00:05:44.261" end="00:05:45.971" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh. Yeah. I'm sorry.</p>
   <p begin="00:05:46.430" end="00:05:49.141" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, I didn't mean it that way, Shinji.<br />It's just that...</p>
   <p begin="00:05:49.224" end="00:05:51.602" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I bet you have<br />a bunch of questions about all this.</p>
   <p begin="00:05:51.685" end="00:05:55.230" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Between that big monster<br />and my invitation, you must be curious.</p>
   <p begin="00:05:55.314" end="00:05:57.316" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I am... but...</p>
   <p begin="00:05:57.399" end="00:05:59.985" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I assumed you wouldn't give me<br />an answer even if I asked.</p>
   <p begin="00:06:01.361" end="00:06:03.864" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You think through these things<br />quite a bit for your age.</p>
   <p begin="00:06:03.947" end="00:06:05.282" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You should be more carefree!</p>
   <p begin="00:06:05.365" end="00:06:06.450" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh.</p>
   <p begin="00:06:08.285" end="00:06:11.705" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Please, ma'am... Look, I am only trying<br />to follow my teacher's advice.</p>
   <p begin="00:06:12.664" end="00:06:15.626" region="AmazonDefaultRegion" style="AmazonDefaultStyle">OK. Well... Moving on.</p>
   <p begin="00:06:16.293" end="00:06:19.588" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That big thing back there is a mysterious<br />enemy creature we call an ‘angel’.</p>
   <p begin="00:06:19.671" end="00:06:20.589" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[helicopter sounds]</p>
   <p begin="00:06:26.011" end="00:06:27.137" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Fuyutsuki] The fourth angel.</p>
   <p begin="00:06:27.221" end="00:06:30.307" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It has a remarkable ability<br />to regenerate itself.</p>
   <p begin="00:06:30.390" end="00:06:33.769" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It is an independent life-form,<br />fully complete unto itself.</p>
   <p begin="00:06:33.852" end="00:06:34.603" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's not surprising.</p>
   <p begin="00:06:35.229" end="00:06:37.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">They are the ones that ate<br />from the "Tree of Life"...</p>
   <p begin="00:06:37.856" end="00:06:40.984" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes. And so, it's here to destroy us.</p>
   <p begin="00:06:41.068" end="00:06:42.569" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We, of the "Tree of Knowledge".</p>
   <p begin="00:06:43.153" end="00:06:45.364" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Attention,</span><br /><span tts:fontStyle="italic">automatic doors now closing.</span></p>
   <p begin="00:06:45.447" end="00:06:46.990" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Stand clear of the closing doors.</span></p>
   <p begin="00:06:47.866" end="00:06:49.409" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Special Government Agency,</p>
   <p begin="00:06:49.493" end="00:06:50.369" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- NERV?<br />- Yeah.</p>
   <p begin="00:06:50.452" end="00:06:52.371" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's a secret department of the UN.</p>
   <p begin="00:06:53.330" end="00:06:54.915" region="AmazonDefaultRegion" style="AmazonDefaultStyle">My father works here, doesn't he?</p>
   <p begin="00:06:54.998" end="00:06:57.459" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's right. Do you know<br />what your father's job is at NERV?</p>
   <p begin="00:06:59.419" end="00:07:00.838" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[bell rings]</p>
   <p begin="00:07:02.005" end="00:07:05.926" region="AmazonDefaultRegion" style="AmazonDefaultStyle">My teacher once told me that my father has<br />a very important job protecting humanity.</p>
   <p begin="00:07:08.303" end="00:07:11.306" region="AmazonDefaultRegion" style="AmazonDefaultStyle">As of this very moment, we are giving you<br />command of this operation.</p>
   <p begin="00:07:11.932" end="00:07:14.893" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- So, let's see what you can do!<br />- Very good sir.</p>
   <p begin="00:07:14.977" end="00:07:15.894" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ikari,</p>
   <p begin="00:07:15.978" end="00:07:19.022" region="AmazonDefaultRegion" style="AmazonDefaultStyle">it's quite clear that nothing<br />in our arsenal even comes close</p>
   <p begin="00:07:19.106" end="00:07:20.899" region="AmazonDefaultRegion" style="AmazonDefaultStyle">to having an effect on the target.</p>
   <p begin="00:07:21.316" end="00:07:23.193" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Do you think<br />you have a chance of beating it?</p>
   <p begin="00:07:24.153" end="00:07:26.029" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That is the very purpose of NERV.</p>
   <p begin="00:07:27.447" end="00:07:29.324" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So, are you bringing me to my father?</p>
   <p begin="00:07:30.367" end="00:07:31.827" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's right. That's the plan, yes.</p>
   <p begin="00:07:36.206" end="00:07:36.957" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[whispers] Father...</p>
   <p begin="00:07:37.040" end="00:07:38.041" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[train]</p>
   <p begin="00:07:39.459" end="00:07:42.462" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh, by the way! Did your father<br />send you any ID cards?</p>
   <p begin="00:07:42.546" end="00:07:43.297" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Erm...</p>
   <p begin="00:07:43.380" end="00:07:44.631" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh, yeah.</p>
   <p begin="00:07:46.091" end="00:07:47.176" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Here you go.</p>
   <p begin="00:07:47.593" end="00:07:48.302" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thank you.</p>
   <p begin="00:07:50.429" end="00:07:52.139" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Right... Now, take a look at this.</p>
   <p begin="00:07:53.223" end="00:07:54.099" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Welcome to NERV?</p>
   <p begin="00:07:55.517" end="00:07:57.186" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is where my father works?</p>
   <p begin="00:07:57.269" end="00:07:59.146" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Am I supposed<br />to do something here at NERV?</p>
   <p begin="00:08:01.481" end="00:08:03.025" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He sent me this letter.</p>
   <p begin="00:08:03.108" end="00:08:05.402" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He must have had a good reason<br />to ask me to come.</p>
   <p begin="00:08:06.069" end="00:08:08.947" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I wonder what it is. Do you have an idea?</p>
   <p begin="00:08:09.031" end="00:08:10.782" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] So you have issues<br />with your father?</p>
   <p begin="00:08:11.658" end="00:08:13.076" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We have that in common, you and I.</p>
   <p begin="00:08:17.164" end="00:08:18.290" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh! [gasps]</p>
   <p begin="00:08:18.373" end="00:08:19.499" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Look at that!</p>
   <p begin="00:08:20.876" end="00:08:23.086" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- A real Geofront!<br />- That's right.</p>
   <p begin="00:08:23.462" end="00:08:26.632" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're passing above NERV command center.<br />Our secret base.</p>
   <p begin="00:08:27.591" end="00:08:29.718" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The fortress that protects us all.</p>
   <p begin="00:08:29.801" end="00:08:31.428" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Our only hope of rebuilding the world.</p>
   <p begin="00:08:34.640" end="00:08:35.432" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crash]</p>
   <p begin="00:08:35.515" end="00:08:37.059" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So... Wait a second.</p>
   <p begin="00:08:37.142" end="00:08:39.519" region="AmazonDefaultRegion" style="AmazonDefaultStyle">At the station, take the western exit, OK.</p>
   <p begin="00:08:39.603" end="00:08:42.189" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Then go right at the north gate.<br />Which leads us to Road 08.</p>
   <p begin="00:08:44.691" end="00:08:48.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Seriously, are they trying to make it<br />more complicated on purpose?</p>
   <p begin="00:08:48.737" end="00:08:52.199" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Anyhoo... it looks like<br />we're more or less on track.</p>
   <p begin="00:08:52.282" end="00:08:54.493" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hey... Are you lost?</p>
   <p begin="00:08:54.576" end="00:08:56.119" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don't know this place very well.</p>
   <p begin="00:08:56.203" end="00:08:59.289" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Let's keep moving, I'm sure<br />we're going to get there eventually.</p>
   <p begin="00:09:00.082" end="00:09:01.667" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA]<br /><span tts:fontStyle="italic">Stage two cooling cycle complete.</span></p>
   <p begin="00:09:01.750" end="00:09:03.168" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">All crew must exit now.</span></p>
   <p begin="00:09:03.919" end="00:09:06.505" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Have the right arm nerve graft<br />thawed in 3 minutes.</p>
   <p begin="00:09:08.006" end="00:09:10.467" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Remember to collect the apoptosis data.<br />- Roger.</p>
   <p begin="00:09:11.176" end="00:09:13.470" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Dr Akagi, your attention:</span><br /><span tts:fontStyle="italic">Lieutenant colonel</span></p>
   <p begin="00:09:13.553" end="00:09:17.599" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Katsuragi and a young man</span><br /><span tts:fontStyle="italic">have arrived at HQ, by elevator S 36.</span></p>
   <p begin="00:09:17.683" end="00:09:20.811" region="AmazonDefaultRegion" style="AmazonDefaultStyle">She's late again.<br />I really can't believe it.</p>
   <p begin="00:09:22.980" end="00:09:23.855" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[elevator pings]</p>
   <p begin="00:09:26.275" end="00:09:27.442" region="AmazonDefaultRegion" style="AmazonDefaultStyle">How are you, Ritsuko?</p>
   <p begin="00:09:28.527" end="00:09:31.488" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You're late.<br />You should've been here 12 minutes ago.</p>
   <p begin="00:09:31.571" end="00:09:33.240" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Lieutenant Colonel Katsuragi.</p>
   <p begin="00:09:33.657" end="00:09:35.534" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I thought you got lost.</p>
   <p begin="00:09:35.617" end="00:09:37.411" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We have no time, nor manpower to waste.</p>
   <p begin="00:09:37.494" end="00:09:38.537" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[giggles] Sorry.</p>
   <p begin="00:09:40.247" end="00:09:41.039" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh.</p>
   <p begin="00:09:42.374" end="00:09:45.127" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Is this the boy you went to get?<br />- That's him.</p>
   <p begin="00:09:45.210" end="00:09:46.461" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I am Ritsuko Akagi.</p>
   <p begin="00:09:46.545" end="00:09:49.339" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I am the director of Project E,<br />and NERV tech R &amp; D.</p>
   <p begin="00:09:49.423" end="00:09:50.382" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A pleasure.</p>
   <p begin="00:09:50.882" end="00:09:52.134" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Er.. Me too.</p>
   <p begin="00:09:52.217" end="00:09:54.594" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll leave you in charge while I'm gone.</p>
   <p begin="00:09:58.515" end="00:10:00.851" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Father and son,<br />meeting again after three years.</p>
   <p begin="00:10:00.934" end="00:10:03.478" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Man] Sir!<br />The target is on the move again.</p>
   <p begin="00:10:04.187" end="00:10:07.149" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Understood.<br />Order all personnel to battle stations.</p>
   <p begin="00:10:07.232" end="00:10:07.941" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[speed boat on water]</p>
   <p begin="00:10:08.650" end="00:10:12.237" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Shinji Ikari. I have<br />something here that I need to show to you.</p>
   <p begin="00:10:17.701" end="00:10:21.163" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The ultimate weapon<br />created for the ultimate battle.</p>
   <p begin="00:10:22.247" end="00:10:22.914" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="00:10:24.458" end="00:10:26.168" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Behold Shinji.</p>
   <p begin="00:10:26.251" end="00:10:28.587" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The artificial humanoid weapon.</p>
   <p begin="00:10:28.670" end="00:10:31.882" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We call it: Evangelion. This is Unit One.</p>
   <p begin="00:10:32.632" end="00:10:34.760" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Mankind's very last hope.</p>
   <p begin="00:10:35.260" end="00:10:37.387" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So this is my father's work?</p>
   <p begin="00:10:37.471" end="00:10:38.430" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Correct.</p>
   <p begin="00:10:38.513" end="00:10:39.473" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji gasps]</p>
   <p begin="00:10:40.265" end="00:10:41.266" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So. It's been a while.</p>
   <p begin="00:10:42.851" end="00:10:43.643" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Father...</p>
   <p begin="00:10:48.148" end="00:10:49.024" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Launch the Eva.</p>
   <p begin="00:10:49.441" end="00:10:50.609" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What? Right now?</p>
   <p begin="00:10:50.692" end="00:10:53.028" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But Eva Unit Zero<br />is still out of commission!</p>
   <p begin="00:10:54.571" end="00:10:56.907" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Wait. You don’t intend<br />to deploy Unit One, do you?</p>
   <p begin="00:10:56.990" end="00:10:58.617" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's the only option we have.</p>
   <p begin="00:10:59.117" end="00:10:59.910" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs]</p>
   <p begin="00:11:00.494" end="00:11:02.245" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Listen carefully Shinji.<br />- Yes, ma'am?</p>
   <p begin="00:11:02.746" end="00:11:03.914" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You will pilot the Eva.</p>
   <p begin="00:11:03.997" end="00:11:04.664" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh?</p>
   <p begin="00:11:10.045" end="00:11:12.047" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Father... Why did you send for me?</p>
   <p begin="00:11:12.839" end="00:11:14.674" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You already know the reason why.</p>
   <p begin="00:11:14.758" end="00:11:18.512" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So you want me to get inside this thing<br />and fight that monster I just saw?</p>
   <p begin="00:11:18.970" end="00:11:19.679" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That’s correct.</p>
   <p begin="00:11:19.763" end="00:11:21.181" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don't want to do this! No way!</p>
   <p begin="00:11:21.515" end="00:11:22.641" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why are you bringing me here?</p>
   <p begin="00:11:22.724" end="00:11:25.602" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You abandoned me<br />because you didn't need me, right?</p>
   <p begin="00:11:25.685" end="00:11:28.438" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A need arose, so I had you brought here.</p>
   <p begin="00:11:29.022" end="00:11:31.942" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs] But why me, Father?</p>
   <p begin="00:11:32.651" end="00:11:34.778" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Because it would be impossible<br />for anyone else.</p>
   <p begin="00:11:35.362" end="00:11:37.114" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's impossible for me too.</p>
   <p begin="00:11:37.197" end="00:11:39.324" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs]<br />I've never even seen this thing before.</p>
   <p begin="00:11:39.408" end="00:11:40.784" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's no way I can pilot it!</p>
   <p begin="00:11:40.867" end="00:11:42.202" region="AmazonDefaultRegion" style="AmazonDefaultStyle">They'll explain how to do it.</p>
   <p begin="00:11:42.786" end="00:11:46.998" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But... That's...<br />There's no way I can do this!</p>
   <p begin="00:11:47.082" end="00:11:48.875" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can't learn to pilot this thing, Father!</p>
   <p begin="00:11:49.668" end="00:11:52.129" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Stop wasting time. Get in the Eva</p>
   <p begin="00:11:52.212" end="00:11:53.213" region="AmazonDefaultRegion" style="AmazonDefaultStyle">or get out!</p>
   <p begin="00:11:59.052" end="00:11:59.886" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast, explosion]</p>
   <p begin="00:12:04.099" end="00:12:06.393" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Bastard! He must know where we are.</p>
   <p begin="00:12:06.476" end="00:12:07.811" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast, explosion]</p>
   <p begin="00:12:07.894" end="00:12:10.272" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA]<span tts:fontStyle="italic"> Layer 1,</span><br /><span tts:fontStyle="italic">Armor plating number eight destroyed.</span></p>
   <p begin="00:12:10.355" end="00:12:12.649" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Come on, Shinji.<br />There’s not a lot of time.</p>
   <p begin="00:12:12.732" end="00:12:14.359" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Man PA] <span tts:fontStyle="italic">Fire alarm in Sector D.</span></p>
   <p begin="00:12:14.443" end="00:12:16.486" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Initiating emergency closing</span><br /><span tts:fontStyle="italic">of all fire doors.</span></p>
   <p begin="00:12:16.820" end="00:12:17.779" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Please pilot the Eva.</p>
   <p begin="00:12:19.281" end="00:12:22.409" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is crazy! I don't want to be a pilot!</p>
   <p begin="00:12:22.492" end="00:12:23.702" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Come on, I just got here!</p>
   <p begin="00:12:24.828" end="00:12:28.206" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Tell me, then Shinji.<br />What was the purpose of you coming here?</p>
   <p begin="00:12:29.708" end="00:12:32.461" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You mustn't run away.<br />Not from your father.</p>
   <p begin="00:12:32.544" end="00:12:34.087" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And especially, not from yourself.</p>
   <p begin="00:12:34.421" end="00:12:37.048" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, I know! I know...</p>
   <p begin="00:12:37.132" end="00:12:38.800" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But there's no way I can do this!</p>
   <p begin="00:12:45.974" end="00:12:49.436" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Fuyutsuki. Wake up Rei.</p>
   <p begin="00:12:49.519" end="00:12:51.146" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Will she be able to fight?</span></p>
   <p begin="00:12:51.229" end="00:12:53.607" region="AmazonDefaultRegion" style="AmazonDefaultStyle">She's not dead yet.</p>
   <p begin="00:12:53.690" end="00:12:55.025" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Understood. [sighs]</span></p>
   <p begin="00:12:56.776" end="00:12:58.487" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Rei?<br /><span tts:fontStyle="italic">- Yes.</span></p>
   <p begin="00:12:58.570" end="00:13:00.280" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The backup isn't working out.</p>
   <p begin="00:13:00.363" end="00:13:02.157" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- I need you again.<br /><span tts:fontStyle="italic">- Yes.</span></p>
   <p begin="00:13:02.240" end="00:13:03.700" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[piano music]</p>
   <p begin="00:13:04.117" end="00:13:05.702" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Reset Unit One's core system!</p>
   <p begin="00:13:05.785" end="00:13:08.246" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Configure to L00 properties<br />and reactivate.</p>
   <p begin="00:13:08.872" end="00:13:12.209" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] <span tts:fontStyle="italic">Roger. Suspending all</span><br /><span tts:fontStyle="italic">current tasks and initiating reactivation.</span></p>
   <p begin="00:13:12.292" end="00:13:13.835" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Initializing transfer command routine.</span></p>
   <p begin="00:13:13.919" end="00:13:14.753" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I knew it.</p>
   <p begin="00:13:15.962" end="00:13:17.839" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No one wants me.</p>
   <p begin="00:13:18.465" end="00:13:20.217" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Target has breached</span></p>
   <p begin="00:13:20.300" end="00:13:22.719" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">absolute defense perimeter.</span><br /><span tts:fontStyle="italic">Approaching area above HQ.</span></p>
   <p begin="00:13:29.726" end="00:13:31.603" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[piano music]</p>
   <p begin="00:13:34.481" end="00:13:36.816" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei gasping]</p>
   <p begin="00:13:40.195" end="00:13:41.321" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[panting]</p>
   <p begin="00:13:43.740" end="00:13:44.950" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast]</p>
   <p begin="00:13:51.665" end="00:13:52.624" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:13:57.128" end="00:13:58.088" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:13:59.464" end="00:14:00.131" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Are you OK?</p>
   <p begin="00:14:00.715" end="00:14:02.092" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei gasping]</p>
   <p begin="00:14:03.885" end="00:14:06.471" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah! [suffering]</p>
   <p begin="00:14:07.264" end="00:14:08.890" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:14:09.849" end="00:14:10.517" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:14:11.643" end="00:14:13.228" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[in pain]</p>
   <p begin="00:14:14.271" end="00:14:15.105" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasping]</p>
   <p begin="00:14:17.107" end="00:14:19.693" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don’t run away. Don’t run away.</p>
   <p begin="00:14:19.776" end="00:14:22.737" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don’t run away.<br />Don’t run away. Don’t run away.</p>
   <p begin="00:14:23.905" end="00:14:24.739" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Fine, I'll do it.</p>
   <p begin="00:14:25.282" end="00:14:26.491" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll pilot the Eva.</p>
   <p begin="00:14:26.575" end="00:14:28.702" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[liquid gushing]</p>
   <p begin="00:14:29.452" end="00:14:31.079" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Stage 3</span><br /><span tts:fontStyle="italic">cooling cycle complete.</span></p>
   <p begin="00:14:31.162" end="00:14:32.455" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Flywheel rotation shutdown.</span></p>
   <p begin="00:14:32.956" end="00:14:35.125" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">- Disengage flywheel.</span><br /><span tts:fontStyle="italic">- Auxiliary voltage level...</span></p>
   <p begin="00:14:35.208" end="00:14:37.460" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shutdown signal plug extraction complete.</p>
   <p begin="00:14:38.211" end="00:14:40.422" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Shutdown signal plug extraction complete.</span></p>
   <p begin="00:14:40.505" end="00:14:43.383" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Roger. Inserting Entry Plug into Eva one.</p>
   <p begin="00:14:46.636" end="00:14:48.597" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Unlocking spinal conduit system.</p>
   <p begin="00:14:48.680" end="00:14:50.974" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Prepare connection.<br /><span tts:fontStyle="italic">- Probe plug, entry complete.</span></p>
   <p begin="00:14:51.057" end="00:14:54.269" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Monitoring. Psychological corruption level</span><br /><span tts:fontStyle="italic">within operational safe range.</span></p>
   <p begin="00:14:54.352" end="00:14:57.022" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Interior array locked down.</span></p>
   <p begin="00:14:57.105" end="00:14:58.898" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Roger. Connection, level one.</p>
   <p begin="00:15:00.859" end="00:15:02.110" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Flooding Entry Plug interior.</p>
   <p begin="00:15:03.445" end="00:15:06.406" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh, what is it? Huh? Ah!</p>
   <p begin="00:15:07.198" end="00:15:10.243" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Relax, Shinji. It's normal,<br />let the fluid fill your lungs.</p>
   <p begin="00:15:10.327" end="00:15:12.495" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The L.C.L. will bring oxygen<br />into your bloodstream.</p>
   <p begin="00:15:13.204" end="00:15:14.623" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You'll quickly get used to it.</p>
   <p begin="00:15:15.832" end="00:15:17.584" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Main power connection complete.</span></p>
   <p begin="00:15:17.667" end="00:15:18.376" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Roger.</p>
   <p begin="00:15:18.960" end="00:15:21.630" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Initiating Level 2 contact.<br />Connecting interface system.</p>
   <p begin="00:15:24.466" end="00:15:26.468" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A-10 neural connection achieved.</p>
   <p begin="00:15:26.551" end="00:15:29.054" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko]<br />L.C.L: ionization levels, normal.</p>
   <p begin="00:15:29.137" end="00:15:32.641" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Set Japanese as the linguistic norm<br />for cognitive interface.</p>
   <p begin="00:15:32.724" end="00:15:35.060" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Initial contact... all systems nominal.</p>
   <p begin="00:15:35.435" end="00:15:37.312" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Pilot Comm link... established.</p>
   <p begin="00:15:37.395" end="00:15:40.190" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Full process list green, up to line 1405.</p>
   <p begin="00:15:40.273" end="00:15:43.735" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Measuring synapse levels.<br />Synchronization rate at 41.3 %.</p>
   <p begin="00:15:44.444" end="00:15:47.072" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And the boy’s not even wearing<br />a Plugsuit. That's incredible.</p>
   <p begin="00:15:47.155" end="00:15:51.159" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All readings nominal on harmonic levels.<br />No sign of system runaway.</p>
   <p begin="00:15:51.242" end="00:15:52.577" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is going to work!</p>
   <p begin="00:15:53.078" end="00:15:54.287" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Prepare for launch!</p>
   <p begin="00:15:54.996" end="00:15:56.498" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Prepare for launch!</p>
   <p begin="00:15:56.998" end="00:15:58.625" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Release</span><br /><span tts:fontStyle="italic">lockdown bolt number one.</span></p>
   <p begin="00:16:00.752" end="00:16:01.503" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Confirmed.</span></p>
   <p begin="00:16:01.586" end="00:16:03.880" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Initiating retraction</span><br /><span tts:fontStyle="italic">of umbilical bridge.</span></p>
   <p begin="00:16:05.465" end="00:16:07.050" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Release lockdown bolt number two.</span></p>
   <p begin="00:16:09.594" end="00:16:12.055" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Male PA] <span tts:fontStyle="italic">Removing</span><br /><span tts:fontStyle="italic">primary restraining gear frames.</span></p>
   <p begin="00:16:12.138" end="00:16:14.557" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Now removing</span><br /><span tts:fontStyle="italic">secondary restraining gear frames.</span></p>
   <p begin="00:16:18.645" end="00:16:21.815" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Disengaging safety systems</span><br /><span tts:fontStyle="italic">one through fifteen.</span></p>
   <p begin="00:16:21.898" end="00:16:22.982" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Disengagement confirmed.</span></p>
   <p begin="00:16:23.400" end="00:16:25.026" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Unit One is ready for transport.</span></p>
   <p begin="00:16:25.110" end="00:16:27.153" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Male PA] <span tts:fontStyle="italic">Internal power supply</span><br /><span tts:fontStyle="italic">fully charged.</span></p>
   <p begin="00:16:27.237" end="00:16:29.322" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">External power source connector,</span><br /><span tts:fontStyle="italic">status green.</span></p>
   <p begin="00:16:29.948" end="00:16:32.701" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Roger.<br />Moving Eva Unit One to launch bay now.</p>
   <p begin="00:16:33.118" end="00:16:35.870" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Woman PA] <span tts:fontStyle="italic">Maglev rail track displacement,</span><br /><span tts:fontStyle="italic">nominal.</span></p>
   <p begin="00:16:35.954" end="00:16:37.956" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">EM induction system function, nominal.</span></p>
   <p begin="00:16:38.748" end="00:16:41.710" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Transporting Unit One via K-52.</span></p>
   <p begin="00:16:41.793" end="00:16:44.295" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Primarily rail magnetic field adjustment</span><br /><span tts:fontStyle="italic">is complete.</span></p>
   <p begin="00:16:44.921" end="00:16:47.215" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">The Eva has arrived</span><br /><span tts:fontStyle="italic">at the launch hub terminal.</span></p>
   <p begin="00:16:47.298" end="00:16:50.427" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Lift stop position</span><br /><span tts:fontStyle="italic">has been set to elevation point zero.</span></p>
   <p begin="00:16:50.510" end="00:16:52.929" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">All blast doors open</span><br /><span tts:fontStyle="italic">except the final elevator gate.</span></p>
   <p begin="00:16:53.430" end="00:16:55.265" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Launch tube clear.<br />All systems green.</p>
   <p begin="00:16:55.849" end="00:16:58.435" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Pre-launch sequence complete.<br />- Copy that.</p>
   <p begin="00:16:59.519" end="00:17:02.147" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Do we have a GO, commander?<br />- Of course.</p>
   <p begin="00:17:02.230" end="00:17:05.483" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The future of humanity<br />depends on defeating the angels.</p>
   <p begin="00:17:06.192" end="00:17:09.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ikari, are you absolutely sure<br />about doing this?</p>
   <p begin="00:17:10.029" end="00:17:10.613" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hmm.</p>
   <p begin="00:17:10.697" end="00:17:11.489" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Launch Eva!</p>
   <p begin="00:17:11.573" end="00:17:13.032" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast]<br />[triumphant music]</p>
   <p begin="00:17:13.116" end="00:17:13.742" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[strains]</p>
   <p begin="00:17:13.825" end="00:17:14.993" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beeping]</p>
   <p begin="00:17:35.597" end="00:17:36.473" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Ready, Shinji?</p>
   <p begin="00:17:37.474" end="00:17:38.183" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh, yeah.</p>
   <p begin="00:17:38.266" end="00:17:40.894" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Disengage the final safety systems!</p>
   <p begin="00:17:41.311" end="00:17:44.189" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Evangelion Unit One, ready for battle!</p>
   <p begin="00:17:47.442" end="00:17:50.779" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Listen, Shinji.<br />I want you to just focus on walking.</p>
   <p begin="00:17:51.863" end="00:17:52.822" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Walk.</p>
   <p begin="00:18:00.872" end="00:18:01.706" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's walking!</p>
   <p begin="00:18:05.001" end="00:18:05.919" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just walk.</p>
   <p begin="00:18:14.886" end="00:18:16.054" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[effort] [strain]</p>
   <p begin="00:18:16.137" end="00:18:17.472" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, Stay focused!</p>
   <p begin="00:18:18.348" end="00:18:20.683" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And get up! Come on, quickly!</p>
   <p begin="00:18:25.605" end="00:18:26.731" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[strain]</p>
   <p begin="00:18:31.569" end="00:18:32.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:18:32.445" end="00:18:33.780" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Just stay calm, Shinji!</p>
   <p begin="00:18:33.863" end="00:18:35.657" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It feels like your arm is hurt. It's not.</p>
   <p begin="00:18:38.535" end="00:18:41.246" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- What about the Eva's defense systems?<br />- Signal is inactive!</p>
   <p begin="00:18:41.329" end="00:18:43.081" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- No A.T. field projection!<br />- It isn't working!</p>
   <p begin="00:18:47.168" end="00:18:48.795" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damage to left forearm!</p>
   <p begin="00:18:51.297" end="00:18:52.674" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji! Break away!</p>
   <p begin="00:18:56.511" end="00:18:57.303" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Argh!</p>
   <p begin="00:18:58.972" end="00:19:00.515" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Fracture in front section of the cranium!</p>
   <p begin="00:19:00.598" end="00:19:02.016" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The armor won't hold much longer.</p>
   <p begin="00:19:12.861" end="00:19:15.905" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Major skull damage.<br />Severity unknown!</p>
   <p begin="00:19:16.406" end="00:19:17.282" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Give me a sit-rep.</p>
   <p begin="00:19:17.365" end="00:19:19.951" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Synchrograph inverting.<br />Neural pulse flow reversing!</p>
   <p begin="00:19:20.034" end="00:19:22.537" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Shut down circuits. Block the flow!<br />- I can't!</p>
   <p begin="00:19:22.620" end="00:19:24.664" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eva's not receiving our shutdown signals.</p>
   <p begin="00:19:24.747" end="00:19:27.542" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Sitrep on the pilot!<br />- Biometrics are down. Condition unknown!</p>
   <p begin="00:19:27.625" end="00:19:29.419" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Unit One complete system failure!</p>
   <p begin="00:19:29.502" end="00:19:30.253" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Misato!</p>
   <p begin="00:19:31.212" end="00:19:32.255" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damn. That's it.</p>
   <p begin="00:19:32.338" end="00:19:35.133" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Abort operation.<br />Pilot recovery has top priority!</p>
   <p begin="00:19:35.216" end="00:19:36.634" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Emergency plug ejection, now!</p>
   <p begin="00:19:36.718" end="00:19:38.928" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can't eject.<br />System's not responding to command.</p>
   <p begin="00:19:39.012" end="00:19:40.263" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What? Not responding?</p>
   <p begin="00:19:47.770" end="00:19:49.856" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">- We have lost control of Unit One.</span><br />- Impossible!</p>
   <p begin="00:19:49.939" end="00:19:51.691" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's no way it should be operational!</p>
   <p begin="00:19:52.317" end="00:19:54.235" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Is it going...<br />- It’s going berserk!</p>
   <p begin="00:19:56.404" end="00:19:57.822" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[whirring]</p>
   <p begin="00:20:14.923" end="00:20:15.632" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah. We've won.</p>
   <p begin="00:20:21.804" end="00:20:22.764" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A.T. Field, activated!</p>
   <p begin="00:20:23.640" end="00:20:25.683" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's hopeless.<br />Unless you breach its A.T. Field...</p>
   <p begin="00:20:25.767" end="00:20:27.268" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You can't even touch an angel.</p>
   <p begin="00:20:34.317" end="00:20:36.069" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- [Aoba] Left arm restored!<br />- Incredible!</p>
   <p begin="00:20:39.948" end="00:20:42.033" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Unit one is generating its own A.T. field.</p>
   <p begin="00:20:42.617" end="00:20:44.243" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Angel phase space is being neutralized!</p>
   <p begin="00:20:44.327" end="00:20:46.371" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, it’s not.<br />It’s being outright corroded.</p>
   <p begin="00:20:51.042" end="00:20:53.753" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It ripped through the angel's A.T. field<br />like it was paper.</p>
   <p begin="00:21:50.143" end="00:21:51.019" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Where's the Eva?</p>
   <p begin="00:22:04.365" end="00:22:05.283" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's the real Eva.</p>
   <p begin="00:22:06.075" end="00:22:07.201" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Its true nature.</p>
   <p begin="00:22:15.251" end="00:22:17.378" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Yui] Have you decided on a name?</p>
   <p begin="00:22:17.462" end="00:22:19.464" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Shinji if it's a boy.</p>
   <p begin="00:22:19.547" end="00:22:21.382" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei if it's a girl.</p>
   <p begin="00:22:21.466" end="00:22:24.552" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Yui] Shinji. Rei.</p>
   <p begin="00:22:24.635" end="00:22:26.220" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[laughs]</p>
   <p begin="00:22:26.304" end="00:22:29.807" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji. Shinji.</p>
   <p begin="00:22:30.558" end="00:22:32.477" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami.</p>
   <p begin="00:22:32.560" end="00:22:34.729" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji.</p>
   <p begin="00:22:34.812" end="00:22:36.522" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei.</p>
   <p begin="00:22:36.606" end="00:22:39.233" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei. Ikari.</p>
   <p begin="00:22:39.942" end="00:22:42.695" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No. Rei.</p>
   <p begin="00:22:43.362" end="00:22:44.947" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei Ayanami.</p>
   <p begin="00:22:45.031" end="00:22:45.948" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei.</p>
   <p begin="00:22:46.032" end="00:22:46.991" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji gasps]</p>
   <p begin="00:23:07.678" end="00:23:09.222" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I’ve never seen this ceiling before...</p>
   <p begin="00:23:16.395" end="00:23:19.607" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 1] The attack of the fourth angel<br />and its destruction.</p>
   <p begin="00:23:20.358" end="00:23:24.862" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The requisition of the Third Child<br />and the first activation of Eva Unit One.</p>
   <p begin="00:23:25.571" end="00:23:27.323" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Everything is proceeding<br />according to plan.</p>
   <p begin="00:23:27.740" end="00:23:31.536" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 4] The enormous cost of repairing<br />Unit One was not part of the plan.</p>
   <p begin="00:23:31.619" end="00:23:35.581" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 5] That's a trivial issue compared<br />to repairing the grounded Unit Zero.</p>
   <p begin="00:23:36.374" end="00:23:39.043" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] We've completed<br />the recovery operation of the Eva.</p>
   <p begin="00:23:39.127" end="00:23:41.754" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Unit One is currently secured<br />within Cage Number Six.</p>
   <p begin="00:23:41.838" end="00:23:44.549" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Inspection is scheduled to begin<br />today at ten o'clock.</p>
   <p begin="00:23:44.632" end="00:23:46.968" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Any data on the rampage<br />in the black box?</p>
   <p begin="00:23:47.051" end="00:23:49.971" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] It's completely blank.<br />Apparently, it didn't record anything.</p>
   <p begin="00:23:50.054" end="00:23:52.265" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] It means<br />we're clueless about what happened.</p>
   <p begin="00:23:52.348" end="00:23:54.058" region="AmazonDefaultRegion" style="AmazonDefaultStyle">As for the Eva's reliability as a weapon,</p>
   <p begin="00:23:54.142" end="00:23:56.435" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can't say I'm overly optimistic.</p>
   <p begin="00:23:56.853" end="00:23:58.688" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 1] It may not be perfect,<br />but that's fine</p>
   <p begin="00:23:58.771" end="00:24:01.357" region="AmazonDefaultRegion" style="AmazonDefaultStyle">as long as it's effective<br />against the coming fifth angel.</p>
   <p begin="00:24:01.983" end="00:24:03.442" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] No need for concern.</p>
   <p begin="00:24:03.526" end="00:24:06.195" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Following<br />the operational deployment of Unit One,</p>
   <p begin="00:24:06.279" end="00:24:09.532" region="AmazonDefaultRegion" style="AmazonDefaultStyle">field testing of Unit Two and its pilot<br />have begun in Germany.</p>
   <p begin="00:24:09.615" end="00:24:12.702" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 4] Production of Units Three and up<br />must go according to plan.</p>
   <p begin="00:24:13.161" end="00:24:17.290" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 3] Your duty is to make sure NERV<br />and the Evas serve their purpose.</p>
   <p begin="00:24:17.373" end="00:24:19.041" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You know better than to disappoint us.</p>
   <p begin="00:24:19.625" end="00:24:20.459" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[SEELE 6] Agreed.</p>
   <p begin="00:24:20.543" end="00:24:23.671" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Defeating the angels is just<br />a small part of our covenant with Lilith.</p>
   <p begin="00:24:24.297" end="00:24:25.631" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The Human Instrumentality Project.</p>
   <p begin="00:24:26.507" end="00:24:29.635" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The execution of that project<br />is our paramount objective.</p>
   <p begin="00:24:29.719" end="00:24:30.845" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] I am well aware.</p>
   <p begin="00:24:30.928" end="00:24:34.015" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Everything shall proceed<br />according to SEELE's scenario.</p>
   <p begin="00:24:37.101" end="00:24:38.561" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[birds chirping]</p>
   <p begin="00:24:41.606" end="00:24:42.648" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[door clanking]</p>
   <p begin="00:24:56.537" end="00:24:57.705" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[engines whirring]</p>
   <p begin="00:24:58.915" end="00:25:02.543" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] An angel's destruction following<br />its loss of A.T. Field leaves a mark.</p>
   <p begin="00:25:02.627" end="00:25:06.005" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] It's like the lakes of blood<br />in the ancient depictions of hell.</p>
   <p begin="00:25:06.088" end="00:25:09.675" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's creepy, how much it reminds you<br />of the Second Impact, don't you think?</p>
   <p begin="00:25:09.759" end="00:25:11.552" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Our Eva can defeat an angel.</p>
   <p begin="00:25:11.928" end="00:25:15.473" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This should bring humanity the glimmer<br />of hope that everybody craves right now.</p>
   <p begin="00:25:15.556" end="00:25:18.768" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And I just got a message<br />about our young pilot: he finally woke up.</p>
   <p begin="00:25:19.936" end="00:25:21.729" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Announcement for doctor Ugai</span></p>
   <p begin="00:25:21.812" end="00:25:24.440" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">of the Internal Medicine Department One.</span></p>
   <p begin="00:25:24.523" end="00:25:27.235" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Doctor Ugai</span><br /><span tts:fontStyle="italic">of the Internal Medicine Department One.</span></p>
   <p begin="00:25:28.653" end="00:25:32.240" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Please contact Doctor Azuma</span><br /><span tts:fontStyle="italic">of the Surgery Department One.</span></p>
   <p begin="00:25:32.323" end="00:25:35.493" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Doctor Ugai, please contact</span><br /><span tts:fontStyle="italic">doctor Azuma, thank you.</span></p>
   <p begin="00:25:37.578" end="00:25:38.871" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[elevator door pings]</p>
   <p begin="00:25:56.097" end="00:25:57.598" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] He'll be living all alone?</p>
   <p begin="00:25:57.682" end="00:26:01.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Officer] Correct. He's been assigned<br />a room in block six, close to HQ.</p>
   <p begin="00:26:01.769" end="00:26:03.688" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Is there a problem?<br />- No, Sir.</p>
   <p begin="00:26:03.771" end="00:26:06.107" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Will you be OK, Shinji? Are you sure?</p>
   <p begin="00:26:06.190" end="00:26:08.025" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes, it's fine. I don't mind living alone.</p>
   <p begin="00:26:08.818" end="00:26:10.486" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm used to it, you know.</p>
   <p begin="00:26:11.153" end="00:26:11.988" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What did you say?</p>
   <p begin="00:26:12.071" end="00:26:15.157" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's no big deal: I invited Shinji<br />to come live in my apartment.</p>
   <p begin="00:26:15.241" end="00:26:16.993" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I even got permission from the top.</p>
   <p begin="00:26:17.076" end="00:26:18.995" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And don't worry about it,</p>
   <p begin="00:26:19.078" end="00:26:22.039" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I promise I won't mess around with him,<br />I know he's just a kid!</p>
   <p begin="00:26:22.123" end="00:26:25.126" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Of course you won't!</span><br /><span tts:fontStyle="italic">How can you even say things like that?</span></p>
   <p begin="00:26:25.209" end="00:26:28.296" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">- Do you realize...</span><br /><span tts:fontStyle="italic">- </span>Miss researcher has no sense of humor!</p>
   <p begin="00:26:30.840" end="00:26:34.135" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Alright!<br />We're going to celebrate in style tonight.</p>
   <p begin="00:26:34.802" end="00:26:35.553" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Celebrate what?</p>
   <p begin="00:26:35.928" end="00:26:39.098" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The fact that my new roommate<br />has just moved in with me, of course.</p>
   <p begin="00:26:41.892" end="00:26:42.560" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[phone ringing]</p>
   <p begin="00:26:42.643" end="00:26:44.353" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife A] You decided to move away?</p>
   <p begin="00:26:44.437" end="00:26:46.731" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife B] Yes.<br />We never thought this city</p>
   <p begin="00:26:46.814" end="00:26:48.691" region="AmazonDefaultRegion" style="AmazonDefaultStyle">would turn into such a battlefield.</p>
   <p begin="00:26:48.774" end="00:26:50.609" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife A] Well, nobody did!</p>
   <p begin="00:26:50.693" end="00:26:54.822" region="AmazonDefaultRegion" style="AmazonDefaultStyle">My husband actually wants me<br />and our children to evacuate, too.</p>
   <p begin="00:26:54.905" end="00:26:58.784" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I heard that today alone, more than<br />a hundred people gave their moving notice!</p>
   <p begin="00:26:58.868" end="00:27:00.536" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife B] Well, I'm not surprised!</p>
   <p begin="00:27:00.619" end="00:27:02.455" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This city is supposed to be a fortress,</p>
   <p begin="00:27:02.538" end="00:27:05.166" region="AmazonDefaultRegion" style="AmazonDefaultStyle">but how can you count<br />on an organization like NERV?</p>
   <p begin="00:27:05.249" end="00:27:08.336" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife A] I get chills just thinking<br />about what happened yesterday.</p>
   <p begin="00:27:08.419" end="00:27:09.962" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Housewife B] You're right...</p>
   <p begin="00:27:13.424" end="00:27:14.425" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] I hope you don't mind.</p>
   <p begin="00:27:14.925" end="00:27:18.262" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- But we're taking a little detour.<br />- Where are we going?</p>
   <p begin="00:27:18.804" end="00:27:20.598" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll show you something really cool.</p>
   <p begin="00:27:26.854" end="00:27:28.105" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Look at that...</p>
   <p begin="00:27:28.481" end="00:27:30.858" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's a bit too depressing for my taste.</p>
   <p begin="00:27:32.318" end="00:27:32.985" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just a minute.</p>
   <p begin="00:27:33.569" end="00:27:35.279" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[siren wails]</p>
   <p begin="00:27:35.363" end="00:27:36.447" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[trumpets play]</p>
   <p begin="00:28:07.770" end="00:28:08.521" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Incredible!</p>
   <p begin="00:28:09.605" end="00:28:11.148" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The buildings are rising up!</p>
   <p begin="00:28:29.083" end="00:28:32.294" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] This fortress city was built<br />specifically to fight the angels.</p>
   <p begin="00:28:32.878" end="00:28:34.713" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is Tokyo three.</p>
   <p begin="00:28:35.589" end="00:28:36.715" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is our home city.</p>
   <p begin="00:28:39.301" end="00:28:42.847" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And it's the city that you just protected.</p>
   <p begin="00:28:49.603" end="00:28:52.273" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Look! Your stuff<br />has already been delivered!</p>
   <p begin="00:28:52.815" end="00:28:56.861" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You know, it's funny,<br />I actually just moved in here myself.</p>
   <p begin="00:28:57.194" end="00:29:00.489" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Come in! Welcome roomie!<br />- Oh, thank you.</p>
   <p begin="00:29:01.407" end="00:29:02.741" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thank you for having me.</p>
   <p begin="00:29:03.701" end="00:29:06.704" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Relax Shinji. This is your home too, now.</p>
   <p begin="00:29:08.789" end="00:29:09.665" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh...</p>
   <p begin="00:29:13.711" end="00:29:15.546" region="AmazonDefaultRegion" style="AmazonDefaultStyle">OK. I guess I'm home.</p>
   <p begin="00:29:16.255" end="00:29:17.298" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Welcome home, Shinji.</p>
   <p begin="00:29:19.925" end="00:29:21.010" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] So... I know...</p>
   <p begin="00:29:21.093" end="00:29:23.304" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's a little messy,<br />but make yourself at home.</p>
   <p begin="00:29:25.389" end="00:29:27.975" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's what she calls "a little messy"?</p>
   <p begin="00:29:28.642" end="00:29:31.312" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh, hey! Do me a favor!<br />Put the food we bought in the fridge, OK?</p>
   <p begin="00:29:31.645" end="00:29:32.980" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Um, yeah, sure.</p>
   <p begin="00:29:34.106" end="00:29:34.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ice...</p>
   <p begin="00:29:34.857" end="00:29:35.983" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Snacks...</p>
   <p begin="00:29:37.818" end="00:29:39.069" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And beer. That's it?</p>
   <p begin="00:29:40.196" end="00:29:41.947" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What does she do when she's home?</p>
   <p begin="00:29:42.281" end="00:29:43.199" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[ping]</p>
   <p begin="00:29:43.282" end="00:29:45.409" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] That looks amazing.<br />Come on, dig in!</p>
   <p begin="00:29:45.493" end="00:29:46.160" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Yes, amazing.</p>
   <p begin="00:29:46.243" end="00:29:47.119" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gulps]</p>
   <p begin="00:29:51.332" end="00:29:54.710" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah! [laughs]</p>
   <p begin="00:29:55.377" end="00:29:58.214" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Boy, oh boy, I'm telling you,<br />this is what makes life worth living!</p>
   <p begin="00:29:58.297" end="00:29:59.673" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A feast for a king.</p>
   <p begin="00:30:00.841" end="00:30:02.092" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You're not hungry, or what?</p>
   <p begin="00:30:02.176" end="00:30:05.429" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I know it's all microwavable food,<br />but it's pretty good.</p>
   <p begin="00:30:05.513" end="00:30:09.016" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, It's just... It's just that I'm not<br />used to that kind of food, that's all.</p>
   <p begin="00:30:09.099" end="00:30:10.309" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hold on a sec!</p>
   <p begin="00:30:10.392" end="00:30:12.394" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don't like picky eaters!</p>
   <p begin="00:30:12.478" end="00:30:14.146" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, sorry... I didn't mean it like that.</p>
   <p begin="00:30:15.564" end="00:30:16.440" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Not at all...</p>
   <p begin="00:30:17.399" end="00:30:19.276" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- This is fun, isn't it?<br />- Uh...</p>
   <p begin="00:30:19.360" end="00:30:21.403" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just you and me,<br />sharing meals and conversation.</p>
   <p begin="00:30:22.404" end="00:30:24.323" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh... Yes...</p>
   <p begin="00:30:24.406" end="00:30:25.491" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Great!</p>
   <p begin="00:30:25.574" end="00:30:27.701" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Well, this is going to be<br />your home from now on.</p>
   <p begin="00:30:28.035" end="00:30:30.329" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So get comfy, roomie,<br />you need to chill out!</p>
   <p begin="00:30:31.121" end="00:30:32.289" region="AmazonDefaultRegion" style="AmazonDefaultStyle">(uh) Yes, ma'am.</p>
   <p begin="00:30:32.373" end="00:30:36.126" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh! Yes ma'am! No ma'am!<br />Stop being so uptight!</p>
   <p begin="00:30:36.210" end="00:30:39.838" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You're a fine young man!<br />Grow a spine! Be bold and confident!</p>
   <p begin="00:30:39.922" end="00:30:42.675" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Yeah, okay.<br />- Fine, whatever.</p>
   <p begin="00:30:43.509" end="00:30:46.428" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why don't you go take a nice bath? Relax!</p>
   <p begin="00:30:46.512" end="00:30:47.972" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It’s just what you need right now!</p>
   <p begin="00:30:48.347" end="00:30:50.099" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A bath to wash your life and begin anew.</p>
   <p begin="00:30:55.938" end="00:30:58.148" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Aaah!</p>
   <p begin="00:30:58.732" end="00:31:01.110" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Mi... Mi... Mi... Miss Misato, help!!</p>
   <p begin="00:31:02.027" end="00:31:05.864" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- What's wrong?<br />-The... There's... This... Thing...</p>
   <p begin="00:31:05.948" end="00:31:07.116" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I mean...</p>
   <p begin="00:31:07.741" end="00:31:08.659" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh, him, yeah!</p>
   <p begin="00:31:09.285" end="00:31:11.287" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He's a hot spring penguin.<br />It's a type of bird.</p>
   <p begin="00:31:11.370" end="00:31:12.204" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[bird caws]</p>
   <p begin="00:31:19.920" end="00:31:21.755" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I've never seen a bird like that before!</p>
   <p begin="00:31:21.839" end="00:31:24.592" region="AmazonDefaultRegion" style="AmazonDefaultStyle">They were common 15 years ago.<br />But there aren't many left, now.</p>
   <p begin="00:31:24.675" end="00:31:26.218" region="AmazonDefaultRegion" style="AmazonDefaultStyle">His name is Pen Pen.</p>
   <p begin="00:31:26.302" end="00:31:27.803" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I came across him one day</p>
   <p begin="00:31:27.886" end="00:31:29.763" region="AmazonDefaultRegion" style="AmazonDefaultStyle">and now he's my roommate.</p>
   <p begin="00:31:30.723" end="00:31:32.683" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't you think<br />you should throw something on?</p>
   <p begin="00:31:33.767" end="00:31:34.560" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Huh?</p>
   <p begin="00:31:35.519" end="00:31:36.604" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Woah!</p>
   <p begin="00:31:38.939" end="00:31:42.401" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Maybe I laid it on too thick</span><br /><span tts:fontStyle="italic">by acting so confident.</span></p>
   <p begin="00:31:42.484" end="00:31:44.361" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">He might see right through it.</span></p>
   <p begin="00:31:46.238" end="00:31:47.740" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] <span tts:fontStyle="italic">Misato Katsuragi.</span></p>
   <p begin="00:31:49.450" end="00:31:51.577" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">She seems nice enough.</span></p>
   <p begin="00:31:51.660" end="00:31:53.370" region="AmazonDefaultRegion" style="AmazonDefaultStyle">A bath to wash your life and begin anew.</p>
   <p begin="00:31:54.330" end="00:31:58.208" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But... For me, taking a bath<br />often brings back bad memories.</p>
   <p begin="00:31:59.918" end="00:32:01.629" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] May I ask how Rei's doing?</p>
   <p begin="00:32:03.839" end="00:32:06.800" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I understand you visited her today<br />at the hospital.</p>
   <p begin="00:32:07.676" end="00:32:08.552" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] That's irrelevant.</p>
   <p begin="00:32:08.927" end="00:32:12.681" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Getting Unit Zero back into operational<br />condition is far more important.</p>
   <p begin="00:32:12.765" end="00:32:14.683" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] What about your son, sir?</p>
   <p begin="00:32:14.767" end="00:32:16.935" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I imagine<br />he must be feeling quite distraught.</p>
   <p begin="00:32:17.603" end="00:32:18.896" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Leave him be.</p>
   <p begin="00:32:18.979" end="00:32:22.483" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That'll give us an excuse<br />to bring Unit Zero back to active duty.</p>
   <p begin="00:32:22.566" end="00:32:25.361" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Then we'll go ahead<br />with Katsuragi's suggestion.</p>
   <p begin="00:32:40.334" end="00:32:44.588" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] <span tts:fontStyle="italic">The third child gets chosen</span><br /><span tts:fontStyle="italic">suddenly, and without any prior reports.</span></p>
   <p begin="00:32:45.089" end="00:32:47.925" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Then an angel attacks,</span><br /><span tts:fontStyle="italic">minutes after his arrival here.</span></p>
   <p begin="00:32:48.592" end="00:32:52.554" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Commander Ikari</span><br /><span tts:fontStyle="italic">recruits his own child into NERV.</span></p>
   <p begin="00:32:52.638" end="00:32:56.392" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No way that can be a coincidence. Strange.</span></p>
   <p begin="00:32:56.767" end="00:32:59.645" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I've worked so hard</span><br /><span tts:fontStyle="italic">towards defeating the angels.</span></p>
   <p begin="00:33:00.938" end="00:33:02.481" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I should be much happier right now.</p>
   <p begin="00:33:05.651" end="00:33:07.653" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] <span tts:fontStyle="italic">Another ceiling</span><br /><span tts:fontStyle="italic">I've never seen before.</span></p>
   <p begin="00:33:08.904" end="00:33:13.867" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No surprise. There's absolutely</span><br /><span tts:fontStyle="italic">nothing familiar about this city.</span></p>
   <p begin="00:33:13.951" end="00:33:15.911" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] This is your home too, now.</p>
   <p begin="00:33:17.746" end="00:33:19.289" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] <span tts:fontStyle="italic">What am I doing here?</span></p>
   <p begin="00:33:29.633" end="00:33:30.467" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs]</p>
   <p begin="00:33:33.971" end="00:33:35.723" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, excuse me a sec.</p>
   <p begin="00:33:39.893" end="00:33:42.229" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's something<br />that I should've told you:</p>
   <p begin="00:33:42.604" end="00:33:45.524" region="AmazonDefaultRegion" style="AmazonDefaultStyle">people will thank you<br />and praise you for what you did today.</p>
   <p begin="00:33:46.275" end="00:33:47.568" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You should be proud.</p>
   <p begin="00:33:48.152" end="00:33:49.528" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Good night, Shinji.</p>
   <p begin="00:33:50.529" end="00:33:51.613" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Keep it up, okay?</p>
   <p begin="00:33:52.406" end="00:33:53.073" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[punch]</p>
   <p begin="00:33:53.157" end="00:33:53.824" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="00:33:59.121" end="00:34:00.789" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] Hey, I'm sorry, newbie.</p>
   <p begin="00:34:00.873" end="00:34:03.041" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But I just had to straight up deck you.</p>
   <p begin="00:34:03.125" end="00:34:04.710" region="AmazonDefaultRegion" style="AmazonDefaultStyle">At least once, to get even with you.</p>
   <p begin="00:34:06.211" end="00:34:07.421" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] It's not personal.</p>
   <p begin="00:34:07.504" end="00:34:10.632" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He blames you because his little sister<br />was injured during the last battle.</p>
   <p begin="00:34:11.633" end="00:34:13.343" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just try to see it his way.</p>
   <p begin="00:34:13.844" end="00:34:15.262" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's so unfair.</p>
   <p begin="00:34:15.345" end="00:34:17.765" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's not like I pilot that thing<br />because I want to.</p>
   <p begin="00:34:19.933" end="00:34:21.518" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] Hugh!</p>
   <p begin="00:34:24.396" end="00:34:25.022" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[growling]</p>
   <p begin="00:34:37.284" end="00:34:40.579" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] So much for people<br />thanking me for what I did.</p>
   <p begin="00:34:40.662" end="00:34:44.249" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why do I have to get beat up<br />just for being an Eva pilot?</p>
   <p begin="00:34:50.130" end="00:34:52.174" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- [Ritsuko] Listen, Shinji.<br />- [Shinji] Yes.</p>
   <p begin="00:34:52.257" end="00:34:55.427" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Every angel<br />has a component that we call the core.</p>
   <p begin="00:34:56.804" end="00:34:58.680" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The only way to defeat an angel in battle</p>
   <p begin="00:34:58.764" end="00:35:01.099" region="AmazonDefaultRegion" style="AmazonDefaultStyle">is to destroy that core.</p>
   <p begin="00:35:02.643" end="00:35:04.061" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's what we'll practice today.</p>
   <p begin="00:35:04.436" end="00:35:06.063" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the core and pull the trigger.</p>
   <p begin="00:35:06.688" end="00:35:07.898" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:35:09.775" end="00:35:12.820" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You need to repeat it again and again<br />to make it second nature.</p>
   <p begin="00:35:12.903" end="00:35:13.570" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Yes.</p>
   <p begin="00:35:19.243" end="00:35:20.035" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Good job, Shinji.</p>
   <p begin="00:35:20.536" end="00:35:23.664" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Keep practicing in induction mode.<br />- Yes.</p>
   <p begin="00:35:30.420" end="00:35:33.757" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm amazed Shinji would be willing<br />to go through with this so obediently.</p>
   <p begin="00:35:33.841" end="00:35:37.010" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Perhaps following<br />other people's instructions is how Shinji</p>
   <p begin="00:35:37.094" end="00:35:38.554" region="AmazonDefaultRegion" style="AmazonDefaultStyle">makes life easier for himself.</p>
   <p begin="00:35:40.639" end="00:35:43.225" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core<br />and pull the trigger.</p>
   <p begin="00:35:44.434" end="00:35:47.187" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core<br />and pull the trigger.</p>
   <p begin="00:35:47.855" end="00:35:51.108" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core<br />and pull the trigger.</p>
   <p begin="00:35:51.191" end="00:35:52.818" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core...</p>
   <p begin="00:35:55.946" end="00:35:58.073" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] I heard Shinji<br />got bullied by a classmate</p>
   <p begin="00:35:58.156" end="00:36:00.534" region="AmazonDefaultRegion" style="AmazonDefaultStyle">on his very first day of school.</p>
   <p begin="00:36:00.617" end="00:36:02.703" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I thought he had<br />an appropriate security detail.</p>
   <p begin="00:36:02.786" end="00:36:05.831" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] He does. The Covert Ops Division<br />is keeping close watch.</p>
   <p begin="00:36:05.914" end="00:36:07.749" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He was never in any real danger.</p>
   <p begin="00:36:07.833" end="00:36:09.042" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We believe it's best for him</p>
   <p begin="00:36:09.126" end="00:36:12.045" region="AmazonDefaultRegion" style="AmazonDefaultStyle">if we give him<br />as much privacy as possible.</p>
   <p begin="00:36:12.129" end="00:36:13.505" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But he lives in your apartment.</p>
   <p begin="00:36:13.589" end="00:36:16.174" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So making sure<br />he's operational is part of your job.</p>
   <p begin="00:36:16.258" end="00:36:18.135" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Makes things trickier.</p>
   <p begin="00:36:18.218" end="00:36:21.013" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He's much more of a sensitive boy<br />than I ever expected.</p>
   <p begin="00:36:21.346" end="00:36:22.890" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Already having second thoughts?</p>
   <p begin="00:36:22.973" end="00:36:25.559" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Weren't you the one<br />who was excited about the whole thing?</p>
   <p begin="00:36:25.642" end="00:36:27.019" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Give me a freaking break.</p>
   <p begin="00:36:31.899" end="00:36:35.485" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] But yes... You might be right...</p>
   <p begin="00:36:35.569" end="00:36:38.780" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji might be the sort of person<br />who has a hard time making friends.</p>
   <p begin="00:36:40.032" end="00:36:43.076" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Ever heard of the hedgehog's dilemma?<br />- Hedgehog?</p>
   <p begin="00:36:43.160" end="00:36:45.329" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Those things with all the spikes?</p>
   <p begin="00:36:45.412" end="00:36:46.413" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Imagine hedgehogs</p>
   <p begin="00:36:46.496" end="00:36:49.458" region="AmazonDefaultRegion" style="AmazonDefaultStyle">in winter trying to get close<br />to one another, to share warmth.</p>
   <p begin="00:36:50.208" end="00:36:53.086" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The closer they get,<br />the more they end up hurting each other.</p>
   <p begin="00:36:54.963" end="00:36:57.424" region="AmazonDefaultRegion" style="AmazonDefaultStyle">People are like that, too.</p>
   <p begin="00:36:57.716" end="00:37:01.219" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I think part of Shinji is afraid of<br />that pain, and that makes him withdrawn.</p>
   <p begin="00:37:01.845" end="00:37:03.347" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He'll outgrow it.</p>
   <p begin="00:37:06.058" end="00:37:07.267" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[girl giggling]</p>
   <p begin="00:37:08.435" end="00:37:10.729" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] He'll figure it out eventually.</p>
   <p begin="00:37:11.813" end="00:37:13.982" region="AmazonDefaultRegion" style="AmazonDefaultStyle">As you get older, you try</p>
   <p begin="00:37:14.066" end="00:37:16.777" region="AmazonDefaultRegion" style="AmazonDefaultStyle">again and again,<br />and through trial and error,</p>
   <p begin="00:37:16.860" end="00:37:20.405" region="AmazonDefaultRegion" style="AmazonDefaultStyle">after a while, you get a feel<br />for what the right distance is.</p>
   <p begin="00:37:22.658" end="00:37:23.700" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I certainly hope so.</p>
   <p begin="00:37:25.410" end="00:37:29.247" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] What’s it going to take to get<br />the budget approved to upgrade the B Wing?</p>
   <p begin="00:37:29.331" end="00:37:30.248" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's so Spartan here!</p>
   <p begin="00:37:30.332" end="00:37:33.585" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] They're prioritizing<br />Eva repairs and weapons production.</p>
   <p begin="00:37:33.669" end="00:37:35.420" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Maybe they're broke.</p>
   <p begin="00:37:35.504" end="00:37:37.339" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] But we're freezing our buns off!</p>
   <p begin="00:37:47.474" end="00:37:50.227" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We got an emergency call.<br />I'm going. Meet me there.</p>
   <p begin="00:38:04.783" end="00:38:06.410" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Direct visual on inbound object.</p>
   <p begin="00:38:06.493" end="00:38:08.620" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Female PA] <span tts:fontStyle="italic">E747 confirms inbound object.</span></p>
   <p begin="00:38:08.704" end="00:38:12.124" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Pattern recognition system: blue.<br />This must be the fifth angel.</p>
   <p begin="00:38:12.499" end="00:38:14.501" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Everyone! Battle stations. Condition One.</p>
   <p begin="00:38:14.584" end="00:38:17.295" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Roger!<br />Ready ground to air intercept.</p>
   <p begin="00:38:17.379" end="00:38:20.549" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Female PA] <span tts:fontStyle="italic">Initiating deployment</span><br /><span tts:fontStyle="italic">of Tokyo 3 into combat configuration.</span></p>
   <p begin="00:38:20.632" end="00:38:21.717" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[siren wailing]</p>
   <p begin="00:38:22.968" end="00:38:24.511" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Retracting central block structures.</span></p>
   <p begin="00:39:17.481" end="00:39:19.524" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA]<br /><span tts:fontStyle="italic">Retraction of buildings complete</span></p>
   <p begin="00:39:19.608" end="00:39:21.568" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">in central blocks</span><br /><span tts:fontStyle="italic">and wards one through seven.</span></p>
   <p begin="00:39:21.651" end="00:39:23.945" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Government and agencies<br />have been notified.</p>
   <p begin="00:39:24.029" end="00:39:26.073" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Target approaching,</span><br /><span tts:fontStyle="italic">course unchanged.</span></p>
   <p begin="00:39:26.156" end="00:39:29.159" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Current air defense systems</span><br /><span tts:fontStyle="italic">operating at 48% capacity.</span></p>
   <p begin="00:39:29.242" end="00:39:31.828" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Status of noncombatant personnel<br />and civilians?</p>
   <p begin="00:39:31.912" end="00:39:34.581" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Emergency evacuation complete,<br />shelters locked down.</p>
   <p begin="00:39:35.791" end="00:39:37.209" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Students in grades 1 to 9,</span></p>
   <p begin="00:39:37.292" end="00:39:40.087" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">please remain with your class,</span><br /><span tts:fontStyle="italic">under teacher supervision.</span></p>
   <p begin="00:39:42.881" end="00:39:44.007" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] Damn, this again!</p>
   <p begin="00:39:44.091" end="00:39:46.468" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Still nothing but text scrolling across?</p>
   <p begin="00:39:46.551" end="00:39:48.762" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yeah,<br />it's a complete news blackout, as usual.</p>
   <p begin="00:39:48.845" end="00:39:51.056" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Stupid government<br />wants to keep us in the dark.</p>
   <p begin="00:39:51.139" end="00:39:53.350" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I feel like we're missing<br />a once in a life time event!</p>
   <p begin="00:39:53.433" end="00:39:54.434" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:40:02.025" end="00:40:03.193" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What a waste of taxpayer money.</p>
   <p begin="00:40:03.276" end="00:40:06.988" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Some people get uncomfortable unless<br />they burn through ammo at times like this.</p>
   <p begin="00:40:08.073" end="00:40:10.867" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The government called, they're asking<br />to launch the Evangelion now.</p>
   <p begin="00:40:10.951" end="00:40:12.035" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Annoying bunch of jerks.</p>
   <p begin="00:40:12.452" end="00:40:14.204" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We don't need them<br />to tell us when to launch.</p>
   <p begin="00:40:14.996" end="00:40:16.581" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Begin Entry Plug checklist.</span></p>
   <p begin="00:40:16.915" end="00:40:18.291" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Pressure clamps, unlocked.</span></p>
   <p begin="00:40:18.375" end="00:40:19.543" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Ionizing L.C.L.</p>
   <p begin="00:40:19.626" end="00:40:22.796" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] <span tts:fontStyle="italic">Father's not even watching me.</span><br /><span tts:fontStyle="italic">Why am I doing this?</span></p>
   <p begin="00:40:23.588" end="00:40:25.799" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">My only reward is people hating me!</span></p>
   <p begin="00:40:26.508" end="00:40:27.592" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crash]</p>
   <p begin="00:40:29.469" end="00:40:32.556" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hey, Tohji, can I talk to you in private<br />for just a minute or two?</p>
   <p begin="00:40:32.639" end="00:40:35.308" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Why? What's up?<br />- Come on, please?</p>
   <p begin="00:40:35.392" end="00:40:36.601" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Alright, alright, sure.</p>
   <p begin="00:40:36.977" end="00:40:38.061" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hikari] She forgot he was there!</p>
   <p begin="00:40:38.145" end="00:40:40.021" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Hey, Class Rep?<br />- What is it?</p>
   <p begin="00:40:40.105" end="00:40:42.274" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're going to the bathroom.<br />We need to take a leak.</p>
   <p begin="00:40:42.357" end="00:40:44.985" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh. You couldn't have done that<br />before you got here?</p>
   <p begin="00:40:45.861" end="00:40:47.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] So... what's up?</p>
   <p begin="00:40:47.445" end="00:40:50.157" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] I want to see what's it like<br />at least once before I die.</p>
   <p begin="00:40:50.240" end="00:40:53.076" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- You mean the battle?<br />- This is the real deal!</p>
   <p begin="00:40:53.160" end="00:40:56.204" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And there's no way to know<br />when the enemy will come next...</p>
   <p begin="00:40:56.288" end="00:40:58.790" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Come on, Kensuke, what is it with you?</p>
   <p begin="00:40:58.874" end="00:41:02.586" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Please, it might be our only chance!<br />Pretty please!</p>
   <p begin="00:41:02.669" end="00:41:05.046" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just help me unlock the doors.</p>
   <p begin="00:41:05.130" end="00:41:06.256" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Okay, okay.</p>
   <p begin="00:41:06.548" end="00:41:08.258" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You don’t know when to stop sometimes.</p>
   <p begin="00:41:08.341" end="00:41:09.801" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You just got to do your thing!</p>
   <p begin="00:41:09.885" end="00:41:10.969" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke chuckles]</p>
   <p begin="00:41:11.052" end="00:41:11.845" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="00:41:11.928" end="00:41:13.555" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, launch imminent.</p>
   <p begin="00:41:13.638" end="00:41:15.974" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Are you ready?<br />- Yes.</p>
   <p begin="00:41:16.057" end="00:41:20.729" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Remember: a burst with the Gatling gun<br />while neutralizing the angel’s A.T. Field.</p>
   <p begin="00:41:20.812" end="00:41:23.648" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Just repeat your training. All right?<br />- Yes.</p>
   <p begin="00:41:23.732" end="00:41:24.482" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And launch!</p>
   <p begin="00:41:24.566" end="00:41:25.567" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[triumphant music]</p>
   <p begin="00:41:39.372" end="00:41:42.959" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh yeah! Seeing this<br />makes it worth the risk of suspension!</p>
   <p begin="00:41:43.043" end="00:41:44.294" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And look: here comes our guy.</p>
   <p begin="00:41:50.926" end="00:41:51.760" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There he is!</p>
   <p begin="00:41:54.137" end="00:41:56.389" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core<br />and pull the trigger.</p>
   <p begin="00:41:56.473" end="00:41:59.142" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the angel's core<br />and pull the trigger. Yes, ma'am.</p>
   <p begin="00:42:03.355" end="00:42:04.231" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="00:42:07.400" end="00:42:09.444" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What an idiot!<br />Now he can't see a freaking thing!</p>
   <p begin="00:42:09.527" end="00:42:10.445" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="00:42:12.739" end="00:42:13.865" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing]</p>
   <p begin="00:42:16.993" end="00:42:17.911" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[panting]</p>
   <p begin="00:42:24.209" end="00:42:26.378" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What the hell?<br />He's already lost the battle?!</p>
   <p begin="00:42:26.461" end="00:42:27.212" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He's not done yet.</p>
   <p begin="00:42:27.295" end="00:42:28.463" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Sending up a spare rifle!</p>
   <p begin="00:42:30.257" end="00:42:31.383" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Go on, grab it!</p>
   <p begin="00:42:31.466" end="00:42:34.261" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- [Shinji crying]<br />- [Misato] Shinji? Shinji?</p>
   <p begin="00:42:35.303" end="00:42:36.388" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] Oh boy...</p>
   <p begin="00:42:36.805" end="00:42:39.057" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Maybe he's still shook up<br />from your beating.</p>
   <p begin="00:42:39.140" end="00:42:40.267" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What? Just shut up!</p>
   <p begin="00:42:40.350" end="00:42:41.434" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[suspenseful music]</p>
   <p begin="00:42:45.897" end="00:42:46.439" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasping]</p>
   <p begin="00:43:00.370" end="00:43:01.830" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Umbilical cable severed!</p>
   <p begin="00:43:01.913" end="00:43:03.748" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Eva has switched<br />to internal power.</p>
   <p begin="00:43:03.832" end="00:43:06.459" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Operational time limit:<br />4 minutes, 53 seconds.</p>
   <p begin="00:43:07.752" end="00:43:08.586" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[effort]</p>
   <p begin="00:43:11.756" end="00:43:13.925" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] It's coming right at us!<br />[Both scream]</p>
   <p begin="00:43:17.804" end="00:43:20.432" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, are you alright? Shinji!?</p>
   <p begin="00:43:20.515" end="00:43:21.308" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damage report!</p>
   <p begin="00:43:21.391" end="00:43:23.226" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Damage minimal. He's OK!</p>
   <p begin="00:43:26.354" end="00:43:27.689" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[boys panicking]</p>
   <p begin="00:43:32.527" end="00:43:35.488" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Two of Shinji's classmates are there!<br />- What are they doing?</p>
   <p begin="00:43:44.080" end="00:43:45.874" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why isn't he fighting the monster?</p>
   <p begin="00:43:45.957" end="00:43:49.377" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I think maybe because we're here?<br />He's afraid he'll squash us if he moves!</p>
   <p begin="00:43:49.836" end="00:43:51.129" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Unit One operational limit:</p>
   <p begin="00:43:51.838" end="00:43:53.465" region="AmazonDefaultRegion" style="AmazonDefaultStyle">three minutes, 28 seconds.</p>
   <p begin="00:43:53.548" end="00:43:55.884" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Contact surface overheating. Damage 58 %.</p>
   <p begin="00:43:58.720" end="00:44:00.055" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="00:44:00.680" end="00:44:03.516" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, let those two<br />inside your cockpit!</p>
   <p begin="00:44:03.600" end="00:44:05.769" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Return to base<br />after you've retrieved them.</p>
   <p begin="00:44:05.852" end="00:44:06.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We'll start over.</p>
   <p begin="00:44:10.648" end="00:44:11.941" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You two! Get in! Now!</p>
   <p begin="00:44:12.984" end="00:44:14.652" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[splash]</p>
   <p begin="00:44:14.736" end="00:44:16.321" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] Is this water?</p>
   <p begin="00:44:16.404" end="00:44:18.198" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] My camera! It's not waterproof!</p>
   <p begin="00:44:22.202" end="00:44:25.330" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Contact surface meltdown<br />reaching the third protective coat.</p>
   <p begin="00:44:32.962" end="00:44:34.381" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Now's your chance! Retreat!</p>
   <p begin="00:44:38.968" end="00:44:40.720" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Use Recovery Route 34.</p>
   <p begin="00:44:40.804" end="00:44:42.097" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Fall back to...<br />- Newbie, listen!</p>
   <p begin="00:44:42.180" end="00:44:43.473" region="AmazonDefaultRegion" style="AmazonDefaultStyle">She's telling you to fall back!</p>
   <p begin="00:44:43.556" end="00:44:45.642" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't run away! Don't run away.</p>
   <p begin="00:44:46.643" end="00:44:47.394" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't run away!</p>
   <p begin="00:44:51.147" end="00:44:52.440" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Progressive knife deployed!</p>
   <p begin="00:44:54.943" end="00:44:57.987" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Shinji, obey my order!<br />I said fall back! Shinji!</p>
   <p begin="00:44:58.738" end="00:44:59.614" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Aaaah!</p>
   <p begin="00:45:03.993" end="00:45:04.828" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What an idiot!</p>
   <p begin="00:45:09.124" end="00:45:10.166" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh!</p>
   <p begin="00:45:12.335" end="00:45:13.420" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Aaaah!</p>
   <p begin="00:45:16.881" end="00:45:17.715" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[screaming]</p>
   <p begin="00:45:21.886" end="00:45:22.971" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[screaming]</p>
   <p begin="00:45:24.264" end="00:45:26.015" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Unit One operational limit critical!</p>
   <p begin="00:45:26.599" end="00:45:28.351" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thirty seconds! Twenty-eight...</p>
   <p begin="00:45:28.977" end="00:45:30.311" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Twenty-seven... Twenty-six...</p>
   <p begin="00:45:31.104" end="00:45:33.314" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Twenty-five...<br />Twenty-four... Twenty-three...</p>
   <p begin="00:45:33.773" end="00:45:34.858" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Twenty-two...</p>
   <p begin="00:45:38.361" end="00:45:41.739" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thirteen... Twelve... Eleven... Ten...</p>
   <p begin="00:45:42.323" end="00:45:43.616" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Nine... Eight...</p>
   <p begin="00:45:43.700" end="00:45:44.659" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Seven...</p>
   <p begin="00:45:45.243" end="00:45:46.786" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Six... Five...</p>
   <p begin="00:45:46.870" end="00:45:47.745" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Four...</p>
   <p begin="00:45:47.829" end="00:45:48.746" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Three...</p>
   <p begin="00:45:49.289" end="00:45:50.748" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Two... One...</p>
   <p begin="00:45:59.632" end="00:46:01.801" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Eva Unit One<br />has completely shut down.</p>
   <p begin="00:46:01.885" end="00:46:03.887" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Target<br />has completely disintegrated.</p>
   <p begin="00:46:05.221" end="00:46:06.097" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji heaving]</p>
   <p begin="00:46:06.973" end="00:46:07.849" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[panting]</p>
   <p begin="00:46:09.392" end="00:46:10.310" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji crying]</p>
   <p begin="00:46:11.144" end="00:46:12.145" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji crying]</p>
   <p begin="00:46:13.271" end="00:46:14.814" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji crying]</p>
   <p begin="00:46:16.608" end="00:46:17.734" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji crying]</p>
   <p begin="00:46:17.817" end="00:46:19.068" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[raining]</p>
   <p begin="00:46:43.885" end="00:46:45.762" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Care to tell me why you ignored my orders?</p>
   <p begin="00:46:46.804" end="00:46:47.764" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm sorry.</p>
   <p begin="00:46:48.348" end="00:46:50.600" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You're aware<br />that I am your superior officer?</p>
   <p begin="00:46:50.975" end="00:46:51.893" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes, ma'am.</p>
   <p begin="00:46:51.976" end="00:46:55.146" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It is your duty<br />to fully adhere to the orders I give.</p>
   <p begin="00:46:55.522" end="00:46:57.565" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Do you understand?<br />- Yes, ma'am.</p>
   <p begin="00:46:58.066" end="00:47:00.026" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Make sure this doesn't happen again.</p>
   <p begin="00:47:00.777" end="00:47:01.528" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes, ma'am.</p>
   <p begin="00:47:02.904" end="00:47:04.572" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Is any of this getting through to you?</p>
   <p begin="00:47:05.156" end="00:47:07.242" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes. I understand, Miss Misato.</p>
   <p begin="00:47:09.202" end="00:47:11.037" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But why does any of it matter anyway?</p>
   <p begin="00:47:12.080" end="00:47:15.124" region="AmazonDefaultRegion" style="AmazonDefaultStyle">After all, when you say fight, I fight.<br />Isn’t that what you want from me?</p>
   <p begin="00:47:15.625" end="00:47:16.292" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato humphs]</p>
   <p begin="00:47:17.293" end="00:47:18.253" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[effort]</p>
   <p begin="00:47:25.009" end="00:47:27.053" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs]</p>
   <p begin="00:47:28.304" end="00:47:31.808" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I've had enough of this.<br />Go home and get some rest.</p>
   <p begin="00:47:41.693" end="00:47:42.652" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[door opening]</p>
   <p begin="00:47:55.582" end="00:47:57.709" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Next stop Nagao-touge,</span><br /><span tts:fontStyle="italic">Nagao-touge.</span></p>
   <p begin="00:47:58.960" end="00:48:00.670" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Please exit on the right hand side.</span></p>
   <p begin="00:48:29.824" end="00:48:31.326" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[street atmosphere]</p>
   <p begin="00:48:45.256" end="00:48:48.051" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He’s avoiding me. What a jerk.</p>
   <p begin="00:48:49.093" end="00:48:49.802" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[cat meows]</p>
   <p begin="00:48:59.937" end="00:49:00.938" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[string music]</p>
   <p begin="00:49:38.059" end="00:49:39.977" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Teacher] Ikari? Shinji Ikari?</p>
   <p begin="00:49:40.937" end="00:49:44.107" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Missing school already?<br />He just transferred in, a few days ago.</p>
   <p begin="00:49:44.190" end="00:49:46.234" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Nevermind. All right,</p>
   <p begin="00:49:46.317" end="00:49:48.194" region="AmazonDefaultRegion" style="AmazonDefaultStyle">time for a pop quiz on last week’s lesson!</p>
   <p begin="00:49:48.277" end="00:49:49.821" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[students react]</p>
   <p begin="00:50:28.484" end="00:50:30.403" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] OK... I've had enough of this.</p>
   <p begin="00:50:31.404" end="00:50:33.614" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You can take me back to Miss Misato, now!</p>
   <p begin="00:50:54.844" end="00:50:57.221" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] So, Shinji,<br />how was your little outing?</p>
   <p begin="00:50:57.305" end="00:50:58.639" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Did it calm your nerves?</p>
   <p begin="00:51:02.852" end="00:51:06.397" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Not really.<br />Nothing matters. I don't care.</p>
   <p begin="00:51:07.732" end="00:51:09.859" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I have no freedom, anyway.</p>
   <p begin="00:51:11.778" end="00:51:14.989" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All that's left for me<br />is to pilot the Eva, right?</p>
   <p begin="00:51:15.072" end="00:51:17.366" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's the only reason<br />my father brought me here.</p>
   <p begin="00:51:18.409" end="00:51:21.287" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's fine. I'll do it.</p>
   <p begin="00:51:21.370" end="00:51:23.998" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just as long as that makes<br />everyone else happy.</p>
   <p begin="00:51:24.624" end="00:51:27.502" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Forget about everyone else.<br />What about you?</p>
   <p begin="00:51:27.585" end="00:51:30.254" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Well I, for one,<br />know I can't do this.</p>
   <p begin="00:51:30.338" end="00:51:32.632" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And I'm sure everybody knows that as well.</p>
   <p begin="00:51:32.715" end="00:51:35.927" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But what can I do? Ayanami's hurt<br />and father wants me to be the one...</p>
   <p begin="00:51:36.010" end="00:51:39.347" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's enough, Shinji!<br />Who cares, what others think!</p>
   <p begin="00:51:39.430" end="00:51:43.559" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You need to decide for yourself<br />if you want to pilot the Eva or not.</p>
   <p begin="00:51:43.643" end="00:51:45.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And if you don't, you are free to go.</p>
   <p begin="00:51:45.770" end="00:51:47.480" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The choice is yours.</p>
   <p begin="00:51:47.563" end="00:51:49.190" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's all up to you.</p>
   <p begin="00:51:54.362" end="00:51:58.533" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Fuyutsuki] Apparently your son behaved<br />exactly the way we had anticipated.</p>
   <p begin="00:51:58.950" end="00:52:02.453" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Yes, he did. Now, I just<br />have to push him a little closer to Rei.</p>
   <p begin="00:52:03.371" end="00:52:05.790" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Everything is proceeding<br />according to plan.</p>
   <p begin="00:52:05.873" end="00:52:08.584" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Fuyutsuki] A scenario all laid out<br />fourteen years ago.</p>
   <p begin="00:52:08.668" end="00:52:09.544" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Children</p>
   <p begin="00:52:09.627" end="00:52:11.128" region="AmazonDefaultRegion" style="AmazonDefaultStyle">with predetermined fates.</p>
   <p begin="00:52:12.505" end="00:52:13.881" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's rather cruel, I must say.</p>
   <p begin="00:52:17.969" end="00:52:18.928" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[insects singing]</p>
   <p begin="00:52:20.847" end="00:52:23.349" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] Come on, just do it!<br />And don't hold back, OK?</p>
   <p begin="00:52:24.308" end="00:52:26.853" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We've got to settle this.<br />Got to even the score.</p>
   <p begin="00:52:26.936" end="00:52:30.022" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] Sorry. He's big on scores<br />and that kind of thing. Play along.</p>
   <p begin="00:52:30.106" end="00:52:30.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[punch]</p>
   <p begin="00:52:31.148" end="00:52:32.024" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[effort]</p>
   <p begin="00:52:37.280" end="00:52:39.198" region="AmazonDefaultRegion" style="AmazonDefaultStyle">OK, so now we're even.</p>
   <p begin="00:52:39.282" end="00:52:41.576" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Sorry about punching you<br />in the face, Ikari.</p>
   <p begin="00:52:52.879" end="00:52:53.963" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[chattering]</p>
   <p begin="00:52:54.589" end="00:52:56.257" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yeah, go Kayoko!</p>
   <p begin="00:52:56.340" end="00:52:58.050" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[girl] You owe us a pizza if you lose!</p>
   <p begin="00:53:12.523" end="00:53:13.900" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Rei Ayanami, fourteen.</p>
   <p begin="00:53:14.984" end="00:53:18.112" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The first child approved<br />by the Marduk Institute.</p>
   <p begin="00:53:19.405" end="00:53:20.781" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The first girl.</p>
   <p begin="00:53:20.865" end="00:53:25.286" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The designated pilot of the Evangelion<br />experimental prototype, Unit Zero.</p>
   <p begin="00:53:25.369" end="00:53:29.123" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All records of her previous life<br />have been erased.</p>
   <p begin="00:53:29.206" end="00:53:32.585" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Rei Ayanami.<br />And to save Ayanami, my father.</p>
   <p begin="00:53:33.210" end="00:53:35.004" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Critical error<br />in activation system.</p>
   <p begin="00:53:35.087" end="00:53:37.048" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Multiple critical errors...</span></p>
   <p begin="00:53:37.131" end="00:53:39.008" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Autonomous rejection</span><br /><span tts:fontStyle="italic">by central nervous system.</span></p>
   <p begin="00:53:39.091" end="00:53:40.843" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Neural pulse flow reversing!</span></p>
   <p begin="00:53:40.927" end="00:53:43.471" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Neural pulse flow reversing!<br />I can't stop it!</p>
   <p begin="00:53:43.554" end="00:53:45.598" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We lost the direct camera feed!</p>
   <p begin="00:53:45.681" end="00:53:48.601" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Entry Plug malfunction.<br />The interior array is being pulled in!</p>
   <p begin="00:53:48.684" end="00:53:52.355" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Abort contact process. Emergency<br />shutdown of circuits one through six.</p>
   <p begin="00:53:52.438" end="00:53:54.482" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Command fail!<br />System is unresponsive!</p>
   <p begin="00:53:55.775" end="00:53:57.526" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We have lost control of Unit Zero!</p>
   <p begin="00:53:57.610" end="00:53:59.820" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Abort the experiment. Shutdown power now.</p>
   <p begin="00:53:59.904" end="00:54:00.821" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Yes, sir.</p>
   <p begin="00:54:00.905" end="00:54:02.114" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sirens and alarms]</p>
   <p begin="00:54:06.452" end="00:54:09.246" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Power cut.<br />Unit Zero on internal power.</p>
   <p begin="00:54:09.330" end="00:54:10.915" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] 35 seconds to system shutdown.</p>
   <p begin="00:54:10.998" end="00:54:13.209" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Man PA] <span tts:fontStyle="italic">Automatic fail-safe system</span><br /><span tts:fontStyle="italic">not activating.</span></p>
   <p begin="00:54:19.715" end="00:54:21.133" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Sir, get back! It's dangerous!</p>
   <p begin="00:54:23.386" end="00:54:25.137" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Pilot emergency ejection system engaged!</p>
   <p begin="00:54:25.221" end="00:54:26.097" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No!</p>
   <p begin="00:54:32.812" end="00:54:34.021" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Release bakelite!</p>
   <p begin="00:54:35.648" end="00:54:36.190" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei! No!</p>
   <p begin="00:54:40.152" end="00:54:42.363" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Total system shutdown<br />in ten seconds.</p>
   <p begin="00:54:43.239" end="00:54:46.075" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eight... Seven... Six...</p>
   <p begin="00:54:46.158" end="00:54:50.705" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Five... Four... Three... Two... One...</p>
   <p begin="00:54:53.290" end="00:54:55.334" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eva inactive. Full system shutdown.</p>
   <p begin="00:54:57.503" end="00:54:59.171" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="00:55:00.172" end="00:55:01.841" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[grunts]</p>
   <p begin="00:55:08.764" end="00:55:10.641" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei... Are you alright?</p>
   <p begin="00:55:11.559" end="00:55:12.226" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei!</p>
   <p begin="00:55:12.309" end="00:55:14.228" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei pants]</p>
   <p begin="00:55:16.981" end="00:55:17.982" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I see. That's good.</p>
   <p begin="00:55:18.065" end="00:55:19.108" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[piano music]</p>
   <p begin="00:55:23.863" end="00:55:25.990" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] It's hard to believe<br />it really happened.</p>
   <p begin="00:55:26.073" end="00:55:28.743" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] The incident was erased<br />from the official records,</p>
   <p begin="00:55:28.826" end="00:55:29.994" region="AmazonDefaultRegion" style="AmazonDefaultStyle">but it's all true.</p>
   <p begin="00:55:30.494" end="00:55:33.998" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] If Unit Zero went berserk,<br />why rush it back into active duty?</p>
   <p begin="00:55:34.373" end="00:55:37.501" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] The angels have returned.<br />We're going to need all hands on deck.</p>
   <p begin="00:55:37.877" end="00:55:40.337" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Well, sure,<br />I know you're right, but...</p>
   <p begin="00:55:40.421" end="00:55:42.548" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko ] We're being careful.</p>
   <p begin="00:55:42.631" end="00:55:45.593" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We've completed<br />all the re-activation tests on Rei.</p>
   <p begin="00:55:45.676" end="00:55:47.553" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Unit Zero itself is operational.</p>
   <p begin="00:55:49.013" end="00:55:51.974" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Once neural calibration is complete...</p>
   <p begin="00:55:52.058" end="00:55:54.518" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] They'll be thrown<br />back onto the battlefield, right?</p>
   <p begin="00:55:58.981" end="00:56:03.235" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I wonder why Ayanami is always alone.</p>
   <p begin="00:56:03.319" end="00:56:05.780" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Level three</span><br /><span tts:fontStyle="italic">cooling cycle of Eva Unit One.</span></p>
   <p begin="00:56:05.863" end="00:56:08.365" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Cage Six, shut down systems</span><br /><span tts:fontStyle="italic">up to phase three.</span></p>
   <p begin="00:56:08.449" end="00:56:11.952" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">T minus one-fifty until Unit Zero</span><br /><span tts:fontStyle="italic">conductive systems restart and testing.</span></p>
   <p begin="00:56:12.036" end="00:56:13.412" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Synchronization test complete.</span></p>
   <p begin="00:56:13.496" end="00:56:16.415" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No abnormal results.</span><br /><span tts:fontStyle="italic">No signs of psychological contamination.</span></p>
   <p begin="00:56:17.583" end="00:56:18.834" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Copy Caspar's situational data</span></p>
   <p begin="00:56:18.918" end="00:56:20.419" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">to Melchior. Unit One’s</span></p>
   <p begin="00:56:20.503" end="00:56:21.879" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">plug depth currently...</span></p>
   <p begin="00:56:21.962" end="00:56:23.756" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Begin circulation of CBL.</span></p>
   <p begin="00:56:23.839" end="00:56:25.091" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">All waste water to be directed</span></p>
   <p begin="00:56:25.174" end="00:56:26.967" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">to the Level Two water treatment system.</span></p>
   <p begin="00:56:27.051" end="00:56:28.761" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">...as soon as possible. Priority One.</span></p>
   <p begin="00:56:28.844" end="00:56:31.639" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">T minus 1:50 until Unit Zero</span><br /><span tts:fontStyle="italic">conductive systems restart and testing.</span></p>
   <p begin="00:56:31.722" end="00:56:34.266" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Roger. Routine check 508.</p>
   <p begin="00:56:34.350" end="00:56:36.352" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're done, all systems checked and ready.</p>
   <p begin="00:56:36.435" end="00:56:37.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thank you, Shinji. Good work.</p>
   <p begin="00:56:40.106" end="00:56:40.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] So...</p>
   <p begin="00:56:41.273" end="00:56:42.483" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Do you like living with him?</p>
   <p begin="00:56:42.566" end="00:56:44.276" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] It's OK. I'm getting used to it.</p>
   <p begin="00:56:44.360" end="00:56:45.945" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] You seem a little nervous.</p>
   <p begin="00:56:46.529" end="00:56:49.240" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You shouldn't be, it's not<br />your first time living with a man.</p>
   <p begin="00:56:49.323" end="00:56:52.535" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs] Yeah,<br />but it's not like eight years ago.</p>
   <p begin="00:56:52.618" end="00:56:54.662" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's not<br />a romantic relationship this time.</p>
   <p begin="00:56:54.745" end="00:56:55.913" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I wouldn't be so sure.</p>
   <p begin="00:56:56.580" end="00:56:59.375" region="AmazonDefaultRegion" style="AmazonDefaultStyle">After all, Shinji decided<br />to come back because of you.</p>
   <p begin="00:56:59.458" end="00:57:01.085" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- You're wrong there.<br />- Hmm?</p>
   <p begin="00:57:01.710" end="00:57:03.796" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's not me.<br />It's because his father is here.</p>
   <p begin="00:57:05.548" end="00:57:09.301" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He wants his father to look at him,<br />pat him on the shoulder. Talk to him.</p>
   <p begin="00:57:09.385" end="00:57:12.054" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Give him a few words of praise.<br />Even if it's only a few.</p>
   <p begin="00:57:12.763" end="00:57:15.683" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I think he needs love.<br />Cause only love could ease his loneliness.</p>
   <p begin="00:57:17.226" end="00:57:18.561" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The kid's hung-up on his father.</p>
   <p begin="00:57:19.228" end="00:57:21.021" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just like you, Misato.</p>
   <p begin="00:57:22.565" end="00:57:23.774" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It feels very weird.</p>
   <p begin="00:57:23.858" end="00:57:27.403" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why does commander Ikari want<br />to keep his own son at arm's length?</p>
   <p begin="00:57:27.486" end="00:57:29.488" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He's got no problem talking to Rei.</p>
   <p begin="00:57:29.572" end="00:57:30.823" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Doesn't seem right to me.</p>
   <p begin="00:57:30.906" end="00:57:32.449" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That's how all men are, now.</p>
   <p begin="00:57:32.533" end="00:57:34.827" region="AmazonDefaultRegion" style="AmazonDefaultStyle">They're just<br />completely wrapped up in themselves.</p>
   <p begin="00:57:35.411" end="00:57:38.122" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Right now<br />is not the best time to be a woman.</p>
   <p begin="00:57:39.915" end="00:57:40.875" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Well...</p>
   <p begin="00:57:42.251" end="00:57:44.420" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's late. I need to get back.</p>
   <p begin="00:57:44.503" end="00:57:46.505" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You just live to work, don't you?</p>
   <p begin="00:57:47.590" end="00:57:49.592" region="AmazonDefaultRegion" style="AmazonDefaultStyle">By the way, if you're going home,</p>
   <p begin="00:57:49.675" end="00:57:52.428" region="AmazonDefaultRegion" style="AmazonDefaultStyle">can you bring Shinji<br />his official security access card?</p>
   <p begin="00:57:52.511" end="00:57:54.096" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's a new one for Rei, too.</p>
   <p begin="00:57:54.180" end="00:57:56.223" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I forgot to give it to them earlier.</p>
   <p begin="00:57:56.307" end="00:57:58.058" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Can you ask your roommate<br />to bring it to her?</p>
   <p begin="00:58:00.519" end="00:58:01.729" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yeah, sure.</p>
   <p begin="00:58:04.732" end="00:58:05.691" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Rei Ayanami.</p>
   <p begin="00:58:11.363" end="00:58:13.407" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why was father smiling<br />when he talked to her?</p>
   <p begin="00:58:15.117" end="00:58:16.869" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why won't he smile for me?</p>
   <p begin="00:58:46.982" end="00:58:49.026" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Anybody home?</p>
   <p begin="00:58:52.363" end="00:58:54.907" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hello? It's me, Shinji.</p>
   <p begin="00:58:56.325" end="00:58:58.118" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm coming in, okay?</p>
   <p begin="00:59:34.488" end="00:59:35.698" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Are these hers?</p>
   <p begin="00:59:41.078" end="00:59:41.829" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[curtain draws]</p>
   <p begin="00:59:44.999" end="00:59:45.666" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="00:59:50.379" end="00:59:51.547" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I... Uh...</p>
   <p begin="00:59:54.758" end="00:59:56.302" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I didn't mean to...</p>
   <p begin="00:59:57.761" end="00:59:58.512" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="01:00:29.126" end="01:00:29.877" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Could you move now?</p>
   <p begin="01:00:29.960" end="01:00:30.878" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[stammers]</p>
   <p begin="01:00:32.296" end="01:00:33.255" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh!</p>
   <p begin="01:00:33.339" end="01:00:34.840" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Woah! I...</p>
   <p begin="01:00:39.094" end="01:00:40.346" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh! Uh...</p>
   <p begin="01:00:53.233" end="01:00:53.942" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What is it?</p>
   <p begin="01:00:54.777" end="01:00:56.987" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I... Erm... I'm... I mean...</p>
   <p begin="01:00:58.072" end="01:00:59.448" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I didn't mean...</p>
   <p begin="01:01:03.118" end="01:01:06.872" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I came here because Miss Misato<br />told me to. I was supposed to...</p>
   <p begin="01:01:08.415" end="01:01:10.042" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh right! The card!</p>
   <p begin="01:01:10.125" end="01:01:13.462" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I was supposed to bring you your new card.<br />I didn't know you would be...</p>
   <p begin="01:01:14.254" end="01:01:15.089" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gulps]</p>
   <p begin="01:01:16.256" end="01:01:17.633" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's just...</p>
   <p begin="01:01:17.716" end="01:01:20.052" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh right! Miss Ritsuko<br />said she forgot to give it</p>
   <p begin="01:01:20.135" end="01:01:21.428" region="AmazonDefaultRegion" style="AmazonDefaultStyle">to you.</p>
   <p begin="01:01:26.683" end="01:01:30.020" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Honest.<br />I didn't want to spy or anything...</p>
   <p begin="01:01:30.104" end="01:01:33.107" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I rang the bell. but no one answered.</p>
   <p begin="01:01:33.816" end="01:01:35.859" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And the door was unlocked so...</p>
   <p begin="01:01:36.318" end="01:01:38.821" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[door squeaks and shuts]</p>
   <p begin="01:01:47.788" end="01:01:51.166" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Access to Central Dogma</span><br /><span tts:fontStyle="italic">is currently allowed.</span></p>
   <p begin="01:01:51.250" end="01:01:53.961" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Category three visitors,</span><br /><span tts:fontStyle="italic">please use gate number four.</span></p>
   <p begin="01:01:55.754" end="01:01:56.630" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="01:01:57.881" end="01:02:00.342" region="AmazonDefaultRegion" style="AmazonDefaultStyle">As I said before,<br />they issued you a new card.</p>
   <p begin="01:02:00.426" end="01:02:02.177" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And they told me to bring it to you.</p>
   <p begin="01:02:10.102" end="01:02:13.439" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- I'm sorry for earlier...<br />- Sorry for what?</p>
   <p begin="01:02:17.484" end="01:02:20.779" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hey... Ayanami...<br />Don't you ever get scared?</p>
   <p begin="01:02:20.863" end="01:02:23.365" region="AmazonDefaultRegion" style="AmazonDefaultStyle">About having to pilot<br />the Evangelion again?</p>
   <p begin="01:02:24.908" end="01:02:26.034" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Why would I?</p>
   <p begin="01:02:26.827" end="01:02:29.913" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Well, I heard you got hurt pretty badly<br />during the last test.</p>
   <p begin="01:02:29.997" end="01:02:32.958" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So I was wondering<br />if you're worried or not.</p>
   <p begin="01:02:35.419" end="01:02:39.339" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I see. No. I'm not worried.</p>
   <p begin="01:02:39.423" end="01:02:42.593" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But the Eva could go berserk again.</p>
   <p begin="01:02:42.676" end="01:02:44.219" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And hurt you.</p>
   <p begin="01:02:44.303" end="01:02:46.388" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Or an angel could kill you. And me too.</p>
   <p begin="01:02:47.806" end="01:02:49.892" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Tell me...<br />You're Commander Ikari's son, right?</p>
   <p begin="01:02:50.684" end="01:02:51.351" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hmm.</p>
   <p begin="01:02:51.727" end="01:02:54.646" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't you have faith in him?<br />Don't you trust the work he does?</p>
   <p begin="01:02:55.230" end="01:02:57.649" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No! Of course not.<br />I know what kind of father he is.</p>
   <p begin="01:03:01.695" end="01:03:02.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Erm...</p>
   <p begin="01:03:24.593" end="01:03:27.221" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Warning: target approaching</span><br /><span tts:fontStyle="italic">Odawara Defense Line.</span></p>
   <p begin="01:03:27.304" end="01:03:29.181" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Analysis of target complete.</p>
   <p begin="01:03:29.264" end="01:03:31.266" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Pattern Blue confirmed.<br />Target is an angel.</p>
   <p begin="01:03:31.725" end="01:03:33.852" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It appears to be the sixth angel.</p>
   <p begin="01:03:34.436" end="01:03:37.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I agree. Launch Unit One<br />on intercept course.</p>
   <p begin="01:03:38.482" end="01:03:40.901" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Prep Eva Unit One for launch.</p>
   <p begin="01:03:40.984" end="01:03:42.819" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Re-checking ordnance.</span><br /><span tts:fontStyle="italic">All green.</span></p>
   <p begin="01:03:45.405" end="01:03:47.783" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Target approaching.<br />It's above Lake Ashinoko.</p>
   <p begin="01:03:47.866" end="01:03:49.660" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eva Unit One prepped and ready for launch.</p>
   <p begin="01:03:49.743" end="01:03:50.494" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Launch Eva!</p>
   <p begin="01:03:59.670" end="01:04:01.672" region="AmazonDefaultRegion" style="AmazonDefaultStyle">High energy readings<br />from inside the target!</p>
   <p begin="01:04:01.755" end="01:04:02.464" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What is going on?</p>
   <p begin="01:04:02.548" end="01:04:03.215" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Alert him!</p>
   <p begin="01:04:06.426" end="01:04:07.052" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Take cover!</p>
   <p begin="01:04:27.072" end="01:04:28.407" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Lower synchronization rate!</p>
   <p begin="01:04:28.490" end="01:04:29.575" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Deploy blast shield!</p>
   <p begin="01:04:51.930" end="01:04:55.225" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Cancel mission!<br />Initiate emergency recovery of Unit One!</p>
   <p begin="01:04:55.309" end="01:04:57.227" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] No go!<br />The catapult lift has melted.</p>
   <p begin="01:04:57.311" end="01:04:59.646" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Status of A.T. field?<br />- Deployed at maximum intensity.</p>
   <p begin="01:05:00.230" end="01:05:01.898" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Barely enough<br />to protect the Eva's integrity.</p>
   <p begin="01:05:04.151" end="01:05:05.652" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Aaah!</p>
   <p begin="01:05:07.613" end="01:05:10.741" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji screaming] Help! I can't take it!<br />Let me out! Father, please!</p>
   <p begin="01:05:12.492" end="01:05:14.995" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Cancel operation!<br />Prioritize pilot recovery!</p>
   <p begin="01:05:15.078" end="01:05:16.747" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eject entry point now!</p>
   <p begin="01:05:16.830" end="01:05:17.748" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] Ignore that order.</p>
   <p begin="01:05:19.499" end="01:05:21.168" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Once there's no pilot in the Eva,</p>
   <p begin="01:05:21.251" end="01:05:23.754" region="AmazonDefaultRegion" style="AmazonDefaultStyle">the unit will immediately lose<br />its protective A.T. field.</p>
   <p begin="01:05:24.504" end="01:05:26.340" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Things will go from bad to worse.</p>
   <p begin="01:05:27.466" end="01:05:28.050" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But Shinji...</p>
   <p begin="01:05:31.553" end="01:05:32.888" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[screaming]</p>
   <p begin="01:05:34.931" end="01:05:36.141" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's no other choice...</p>
   <p begin="01:05:36.850" end="01:05:37.976" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Second breastplate layer...</span></p>
   <p begin="01:05:38.060" end="01:05:39.186" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Emergency recovery!</p>
   <p begin="01:05:39.269" end="01:05:40.646" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Blow the explosive bolts!</p>
   <p begin="01:05:41.313" end="01:05:42.314" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="01:06:02.876" end="01:06:04.586" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Target has ceased fire.</p>
   <p begin="01:06:04.670" end="01:06:06.880" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Expedite recovery!<br />Take Unit One to Cage 99.</p>
   <p begin="01:06:06.963" end="01:06:07.756" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Rescuers, stand by!</p>
   <p begin="01:06:07.839" end="01:06:10.050" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Priority One:<br />L.C.L cooling in Entry Plug.</p>
   <p begin="01:06:10.425" end="01:06:12.052" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Pilot is alive! Heart rate, low!</p>
   <p begin="01:06:12.135" end="01:06:14.930" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Increase Plugsuit life support<br />to maximum. Cardiac massage!</p>
   <p begin="01:06:15.013" end="01:06:16.223" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes, ma'am.</p>
   <p begin="01:06:17.182" end="01:06:17.974" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ah!</p>
   <p begin="01:06:18.058" end="01:06:18.934" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beeping]</p>
   <p begin="01:06:19.017" end="01:06:19.976" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Heart rate stabilizing.</p>
   <p begin="01:06:20.060" end="01:06:21.353" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Force eject Entry Plug, now!</p>
   <p begin="01:06:22.562" end="01:06:25.273" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Plug surface temperature</span><br /><span tts:fontStyle="italic">has dropped to 300.</span></p>
   <p begin="01:06:25.357" end="01:06:27.234" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Drain L.C.L from Entry Plug!<br />- Draining!</p>
   <p begin="01:06:28.652" end="01:06:29.820" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Draining L.C.L.</span></p>
   <p begin="01:06:29.903" end="01:06:30.987" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Medical team to pilot!</p>
   <p begin="01:06:36.451" end="01:06:37.577" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[alert]</p>
   <p begin="01:06:56.888" end="01:06:57.889" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[angel singing]</p>
   <p begin="01:07:10.110" end="01:07:12.487" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] The target<br />is hovering directly above us.</p>
   <p begin="01:07:13.071" end="01:07:14.865" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's drilling down toward the Geofront.</p>
   <p begin="01:07:15.240" end="01:07:18.827" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] So this one wants to launch<br />a direct attack on NERV HQ, huh?</p>
   <p begin="01:07:19.411" end="01:07:22.748" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I want a report from<br />all the heads of department in the agency.</p>
   <p begin="01:07:23.039" end="01:07:26.418" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Tac report from the first battle suggest<br />that the enemy automatically engages</p>
   <p begin="01:07:26.501" end="01:07:28.879" region="AmazonDefaultRegion" style="AmazonDefaultStyle">any hostile coming within a certain range.</p>
   <p begin="01:07:28.962" end="01:07:32.340" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So close combat is out of the question<br />because we can't approach it.</p>
   <p begin="01:07:32.424" end="01:07:35.135" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- What do we know about its A.T. field?<br />- Still active.</p>
   <p begin="01:07:35.218" end="01:07:39.431" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Furthermore, its phase pattern is randomly<br />shifting and its exterior shape in flux.</p>
   <p begin="01:07:39.514" end="01:07:41.308" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It'll be very difficult to neutralize.</p>
   <p begin="01:07:41.892" end="01:07:43.310" region="AmazonDefaultRegion" style="AmazonDefaultStyle">According to MAGI calculation,</p>
   <p begin="01:07:43.393" end="01:07:46.605" region="AmazonDefaultRegion" style="AmazonDefaultStyle">in order to breach this A.T. field<br />with airdropped N2 mines,</p>
   <p begin="01:07:46.688" end="01:07:48.857" region="AmazonDefaultRegion" style="AmazonDefaultStyle">the explosion would have to be so powerful</p>
   <p begin="01:07:48.940" end="01:07:52.360" region="AmazonDefaultRegion" style="AmazonDefaultStyle">that NERV HQ would end up being<br />completely obliterated in the process.</p>
   <p begin="01:07:52.444" end="01:07:55.447" region="AmazonDefaultRegion" style="AmazonDefaultStyle">That’s true. MAGI-2 at Matsushiro<br />reached the same conclusion.</p>
   <p begin="01:07:56.323" end="01:07:58.366" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The Japanese government and the UN</p>
   <p begin="01:07:58.450" end="01:08:01.828" region="AmazonDefaultRegion" style="AmazonDefaultStyle">are requesting that NERV HQ<br />should self-destruct to defeat this angel.</p>
   <p begin="01:08:01.912" end="01:08:04.539" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Easy for them to say.<br />They think it’s just our problem.</p>
   <p begin="01:08:05.123" end="01:08:07.375" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't they know<br />we're all doomed if NERV HQ falls?</p>
   <p begin="01:08:07.459" end="01:08:09.669" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But ma’am, the drilling is relentless.</p>
   <p begin="01:08:09.753" end="01:08:11.880" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Two layers of armor plates<br />have been pierced.</p>
   <p begin="01:08:11.963" end="01:08:14.466" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And now it’s boring<br />through the third layer.</p>
   <p begin="01:08:14.549" end="01:08:18.804" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] 22 layers of kakumo type armor belt<br />plating have been installed so far.</p>
   <p begin="01:08:18.887" end="01:08:21.223" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Provided<br />the drilling speed remains constant...</p>
   <p begin="01:08:21.306" end="01:08:24.226" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Estimated time of final breach:<br />6:54 after midnight.</p>
   <p begin="01:08:24.309" end="01:08:26.520" region="AmazonDefaultRegion" style="AmazonDefaultStyle">In less than<br />ten hours and fifteen minutes.</p>
   <p begin="01:08:26.603" end="01:08:29.856" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Unit Zero still needs critical<br />calibrations before it is operational.</p>
   <p begin="01:08:29.940" end="01:08:33.401" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And Unit One won't be able to do much<br />until extensive repairs are complete.</p>
   <p begin="01:08:35.195" end="01:08:37.697" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The outlook appears to be rather bleak.</p>
   <p begin="01:08:37.781" end="01:08:40.033" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're short on both time and resources.</p>
   <p begin="01:08:40.116" end="01:08:42.577" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Maybe we should wave a white flag?</p>
   <p begin="01:08:42.661" end="01:08:45.664" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll think about it.<br />But I just might have an idea.</p>
   <p begin="01:08:45.747" end="01:08:47.666" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Something I want to try before giving up.</p>
   <p begin="01:08:48.458" end="01:08:51.837" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Our Covert Ops has a file<br />on SSDF's secret research, right?</p>
   <p begin="01:08:52.295" end="01:08:52.963" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Uh-huh.</p>
   <p begin="01:08:53.046" end="01:08:53.713" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[aircraft]</p>
   <p begin="01:09:06.935" end="01:09:08.103" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] I have to say.</p>
   <p begin="01:09:08.186" end="01:09:12.357" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is your most reckless plan to date,<br />"Operations Chief Katsuragi".</p>
   <p begin="01:09:12.440" end="01:09:14.609" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Reckless? That's not very nice.</p>
   <p begin="01:09:14.693" end="01:09:16.862" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's doable before our midnight deadline.</p>
   <p begin="01:09:16.945" end="01:09:18.780" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And, anyway,<br />we both know it's our best shot.</p>
   <p begin="01:09:18.864" end="01:09:20.490" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Operation Yashima:</p>
   <p begin="01:09:21.116" end="01:09:22.617" region="AmazonDefaultRegion" style="AmazonDefaultStyle">as the name implies.</p>
   <p begin="01:09:22.701" end="01:09:25.036" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The entirety of Japan<br />will devote its electricity</p>
   <p begin="01:09:25.120" end="01:09:28.790" region="AmazonDefaultRegion" style="AmazonDefaultStyle">to power a self-propelled<br />high-power positron cannon</p>
   <p begin="01:09:28.874" end="01:09:31.418" region="AmazonDefaultRegion" style="AmazonDefaultStyle">you requisitioned from the SSDF.</p>
   <p begin="01:09:33.753" end="01:09:34.671" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Since the cannon</p>
   <p begin="01:09:34.754" end="01:09:36.631" region="AmazonDefaultRegion" style="AmazonDefaultStyle">is not fully operational yet,</p>
   <p begin="01:09:36.715" end="01:09:40.427" region="AmazonDefaultRegion" style="AmazonDefaultStyle">an Eva will execute<br />the high precision targeting.</p>
   <p begin="01:09:40.510" end="01:09:42.304" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Convincing the UN Forces is one thing.</p>
   <p begin="01:09:42.387" end="01:09:45.807" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But the Home Ministry and<br />the Strategic Self Defense Forces as well?</p>
   <p begin="01:09:47.183" end="01:09:49.686" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Well, I called in a few favors.</p>
   <p begin="01:09:53.356" end="01:09:55.859" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] It takes a fox to catch a fox.</p>
   <p begin="01:09:55.942" end="01:09:56.651" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beep]</p>
   <p begin="01:09:56.735" end="01:09:59.321" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Electrical black-out warning:</span><br /><span tts:fontStyle="italic">tonight at midnight,</span></p>
   <p begin="01:09:59.863" end="01:10:02.157" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">power will be cut off</span><br /><span tts:fontStyle="italic">for the entire country.</span></p>
   <p begin="01:10:03.283" end="01:10:05.994" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Thank you</span><br /><span tts:fontStyle="italic">for your cooperation in this matter.</span></p>
   <p begin="01:10:06.077" end="01:10:06.870" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I repeat.</span></p>
   <p begin="01:10:07.329" end="01:10:10.123" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Electrical black-out warning:</span><br /><span tts:fontStyle="italic">tonight at midnight,</span></p>
   <p begin="01:10:10.206" end="01:10:12.667" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">power will be cut off</span><br /><span tts:fontStyle="italic">for the entire country.</span></p>
   <p begin="01:10:12.751" end="01:10:13.418" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I repeat.</span></p>
   <p begin="01:10:13.752" end="01:10:15.503" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] Alright. Let's go.</p>
   <p begin="01:10:17.505" end="01:10:20.592" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Electrical black-out warning:</span><br /><span tts:fontStyle="italic">tonight at midnight...</span></p>
   <p begin="01:10:21.176" end="01:10:22.677" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[siren wailing]</p>
   <p begin="01:10:23.803" end="01:10:26.181" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Electrical black-out warning:</span><br /><span tts:fontStyle="italic">tonight at midnight...</span></p>
   <p begin="01:10:26.806" end="01:10:27.807" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[birds chirping]</p>
   <p begin="01:10:48.244" end="01:10:50.246" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] The angel's drill<br />has breached Armor Plate 7.</p>
   <p begin="01:10:50.330" end="01:10:51.957" region="AmazonDefaultRegion" style="AmazonDefaultStyle">How's our power supply doing?</p>
   <p begin="01:10:52.374" end="01:10:55.460" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female crew] Progression steady.<br />Power will be directly routed through</p>
   <p begin="01:10:55.543" end="01:10:57.087" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shingotenba substation and two backups.</p>
   <p begin="01:10:57.170" end="01:11:01.800" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're currently laying down superconductor<br />power lines toward Shimofutagoyama.</p>
   <p begin="01:11:01.883" end="01:11:03.385" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Estimated time of completion</p>
   <p begin="01:11:03.468" end="01:11:06.972" region="AmazonDefaultRegion" style="AmazonDefaultStyle">and final connection<br />to the main transformer: 22:50 tonight.</p>
   <p begin="01:11:07.472" end="01:11:09.307" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Status report on ordnance preparation?</p>
   <p begin="01:11:09.391" end="01:11:11.351" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[team leader] Assembly<br />proceeding steadily.</p>
   <p begin="01:11:11.434" end="01:11:13.478" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We'll have<br />the weapon operational by 23:00.</p>
   <p begin="01:11:13.812" end="01:11:15.146" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Status report on Eva One?</p>
   <p begin="01:11:15.730" end="01:11:18.483" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Currently undergoing refit<br />to Type G sniper configuration.</p>
   <p begin="01:11:18.942" end="01:11:20.652" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Unit one will be ready in 2 hours.</p>
   <p begin="01:11:20.735" end="01:11:21.903" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Copy that!</p>
   <p begin="01:11:21.987" end="01:11:24.030" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The only thing missing now is the pilot.</p>
   <p begin="01:11:24.656" end="01:11:27.283" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Do you think Shinji will agree<br />to pilot the Eva again?</p>
   <p begin="01:11:31.162" end="01:11:33.331" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Fuyutsuki]<br />So what about Unit One's pilot?</p>
   <p begin="01:11:33.915" end="01:11:37.210" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] The Dummy Plug<br />is not even ready for the trial stage.</p>
   <p begin="01:11:37.293" end="01:11:41.214" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're going to have to make do<br />with the current pilot we have until then.</p>
   <p begin="01:11:41.297" end="01:11:43.550" region="AmazonDefaultRegion" style="AmazonDefaultStyle">If nothing else works,<br />there's always brainwashing.</p>
   <p begin="01:11:43.633" end="01:11:46.511" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] If nothing else works,<br />there's always Rei.</p>
   <p begin="01:11:46.594" end="01:11:48.722" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You want her to pilot Unit One?</p>
   <p begin="01:11:48.805" end="01:11:51.516" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't you think<br />it's a rather dangerous option?</p>
   <p begin="01:11:51.599" end="01:11:53.893" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We must win, no matter what.</p>
   <p begin="01:11:53.977" end="01:11:57.105" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We need to do whatever it takes<br />to defeat eight more angels.</p>
   <p begin="01:11:58.481" end="01:12:00.775" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I suppose everything depends on that.</p>
   <p begin="01:12:09.868" end="01:12:12.203" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I don't want to pilot my Eva anymore.</span></p>
   <p begin="01:12:13.830" end="01:12:15.707" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Everybody assumes success.</span></p>
   <p begin="01:12:15.790" end="01:12:17.876" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">So I hardly ever get praised.</span></p>
   <p begin="01:12:17.959" end="01:12:21.171" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">And if I fail, people hate me. And worst,</span></p>
   <p begin="01:12:21.254" end="01:12:23.923" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I'll just die. What am I doing here?</span></p>
   <p begin="01:12:26.384" end="01:12:28.344" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I came here hoping for change.</span></p>
   <p begin="01:12:28.428" end="01:12:31.181" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I thought things might get better.</span></p>
   <p begin="01:12:31.598" end="01:12:33.433" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I didn't come here to be put through hell.</span></p>
   <p begin="01:12:33.850" end="01:12:37.645" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Is that it? Are you going</span><br /><span tts:fontStyle="italic">to live your life running away from pain?</span></p>
   <p begin="01:12:39.314" end="01:12:42.692" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Me? Live? What for?</span></p>
   <p begin="01:12:43.401" end="01:12:46.279" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I used to wonder</span><br /><span tts:fontStyle="italic">if there was any point in living.</span></p>
   <p begin="01:12:47.906" end="01:12:49.449" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No one wants me.</span></p>
   <p begin="01:12:49.532" end="01:12:51.701" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Not my father. Not Miss Misato.</span></p>
   <p begin="01:12:51.785" end="01:12:54.287" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No one wants me unless I pilot the Eva.</span></p>
   <p begin="01:12:55.497" end="01:12:57.916" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">That's why I have to be the pilot.</span></p>
   <p begin="01:12:58.583" end="01:13:00.794" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Otherwise, I can't stay here.</span></p>
   <p begin="01:13:01.669" end="01:13:02.921" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">That's all I have left.</span></p>
   <p begin="01:13:03.004" end="01:13:05.423" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">But when I pilot the Eva, I end up...</span></p>
   <p begin="01:13:05.507" end="01:13:06.549" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="01:13:09.219" end="01:13:10.512" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This ceiling again...</p>
   <p begin="01:13:12.597" end="01:13:15.016" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Seems like piloting always brings me here.</p>
   <p begin="01:13:19.395" end="01:13:20.438" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami?</p>
   <p begin="01:13:22.357" end="01:13:23.441" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You've been here all this time?</p>
   <p begin="01:13:25.944" end="01:13:26.653" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Listen.</p>
   <p begin="01:13:26.736" end="01:13:31.282" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The timeline for the Operation Yashima<br />set to start at midnight is as follows:</p>
   <p begin="01:13:31.366" end="01:13:35.286" region="AmazonDefaultRegion" style="AmazonDefaultStyle">first, Ayanami and Ikari<br />will report to Terminal two</p>
   <p begin="01:13:35.370" end="01:13:37.372" region="AmazonDefaultRegion" style="AmazonDefaultStyle">at 19:30.</p>
   <p begin="01:13:37.455" end="01:13:42.585" region="AmazonDefaultRegion" style="AmazonDefaultStyle">At 20:00, both pilots<br />will accompany both Units One and Zero.</p>
   <p begin="01:13:42.669" end="01:13:44.754" region="AmazonDefaultRegion" style="AmazonDefaultStyle">At 20:05, we depart.</p>
   <p begin="01:13:44.838" end="01:13:47.674" region="AmazonDefaultRegion" style="AmazonDefaultStyle">At 20:30,<br />we arrive at Futagoyama Fortress two.</p>
   <p begin="01:13:48.508" end="01:13:51.386" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Once there,<br />we are to await further instructions.</p>
   <p begin="01:13:51.469" end="01:13:55.431" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Then, when the clock strikes midnight,<br />Operation Yashima begins.</p>
   <p begin="01:13:56.349" end="01:13:57.142" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Here's your meal.</p>
   <p begin="01:13:59.269" end="01:14:00.979" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No thanks. I don't want it.</p>
   <p begin="01:14:01.563" end="01:14:03.106" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We report in 90 minutes.</p>
   <p begin="01:14:04.149" end="01:14:06.693" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So we have to pilot those things again?</p>
   <p begin="01:14:06.776" end="01:14:07.902" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We do.</p>
   <p begin="01:14:07.986" end="01:14:09.529" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But I don't want to.</p>
   <p begin="01:14:09.612" end="01:14:12.031" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can't go through<br />that kind of hell again.</p>
   <p begin="01:14:12.115" end="01:14:14.325" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's so... So scary.</p>
   <p begin="01:14:14.409" end="01:14:16.703" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But I can even run away.</p>
   <p begin="01:14:16.786" end="01:14:19.247" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei] Are you scared of the Evas?</p>
   <p begin="01:14:19.330" end="01:14:21.416" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Then, just stay and sleep.</p>
   <p begin="01:14:22.000" end="01:14:23.334" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Stay and sleep?</p>
   <p begin="01:14:23.418" end="01:14:25.837" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes. I'll pilot Unit One.</p>
   <p begin="01:14:28.548" end="01:14:29.215" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami!</p>
   <p begin="01:14:30.633" end="01:14:31.551" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Farewell.</p>
   <p begin="01:14:45.023" end="01:14:46.149" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[drill humming]</p>
   <p begin="01:14:47.859" end="01:14:50.278" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Target's drill<br />has breached Armor Plate number 17.</p>
   <p begin="01:14:50.361" end="01:14:53.156" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Estimated time before</span><br /><span tts:fontStyle="italic">final breach: 4 hours 55 minutes.</span></p>
   <p begin="01:14:53.239" end="01:14:57.660" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Nishihakone Shinsen and Minami Tounosawa</span><br /><span tts:fontStyle="italic">link-up via Kakuu Route three, complete.</span></p>
   <p begin="01:14:57.744" end="01:15:02.373" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">50,000 volt standard</span><br /><span tts:fontStyle="italic">installation will begin on schedule.</span></p>
   <p begin="01:15:02.457" end="01:15:03.249" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Stage four...</span></p>
   <p begin="01:15:03.333" end="01:15:06.920" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Transformer Group 28 has arrived</span><br /><span tts:fontStyle="italic">five minutes behind schedule.</span></p>
   <p begin="01:15:07.003" end="01:15:11.549" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Hurry with the shunting of</span><br /><span tts:fontStyle="italic">rolling stock from No. 3 loading platform.</span></p>
   <p begin="01:15:11.633" end="01:15:14.344" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Supervisor,</span><br /><span tts:fontStyle="italic">please expedite link-up.</span></p>
   <p begin="01:15:14.427" end="01:15:19.724" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Roger. Please forward completion report</span><br /><span tts:fontStyle="italic">to power link C&amp;C center.</span></p>
   <p begin="01:15:19.807" end="01:15:22.560" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">4th Electrical Relay</span><br /><span tts:fontStyle="italic">Group’s integrity has been checked.</span></p>
   <p begin="01:15:22.644" end="01:15:24.229" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">All systems green.</span></p>
   <p begin="01:15:24.312" end="01:15:26.189" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">...Stage One power merge circuits...</span></p>
   <p begin="01:15:26.272" end="01:15:30.193" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Ultra-high voltage</span><br /><span tts:fontStyle="italic">superconductor transformer arrays</span></p>
   <p begin="01:15:30.276" end="01:15:31.527" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">checked and certified.</span></p>
   <p begin="01:15:40.119" end="01:15:42.789" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] This is the experimental<br />large-caliber positron cannon?</p>
   <p begin="01:15:43.331" end="01:15:46.459" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Assembling it was a rush job,<br />but in theory, it should work.</p>
   <p begin="01:15:47.168" end="01:15:48.711" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] We'll take care<br />of battle sight zeroing</p>
   <p begin="01:15:48.795" end="01:15:51.047" region="AmazonDefaultRegion" style="AmazonDefaultStyle">by linking it to the Type G components.</p>
   <p begin="01:15:51.130" end="01:15:53.633" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You bet! We're counting on you for that.</p>
   <p begin="01:15:53.716" end="01:15:56.010" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I guess the one thing<br />we can't count on is the pilot.</p>
   <p begin="01:15:56.678" end="01:15:59.222" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But hopefully, Misato can take care of it.</p>
   <p begin="01:16:04.185" end="01:16:07.772" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hey Shinji, you were supposed<br />to report for duty a while ago.</p>
   <p begin="01:16:10.525" end="01:16:13.945" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Apparently, you decided<br />you wanted to remain a pilot, right?</p>
   <p begin="01:16:14.404" end="01:16:17.073" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Then you have to follow through<br />and actually come do your job.</p>
   <p begin="01:16:18.825" end="01:16:21.744" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Piloting the Eva is really scary.</p>
   <p begin="01:16:22.662" end="01:16:24.163" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You people have it easy!</p>
   <p begin="01:16:25.581" end="01:16:28.960" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All you do is stay below in HQ<br />and give out orders.</p>
   <p begin="01:16:29.043" end="01:16:31.504" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm the one out there, doing scary stuff!</p>
   <p begin="01:16:32.130" end="01:16:33.631" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You're all a bunch of hypocrites!</p>
   <p begin="01:16:41.931" end="01:16:43.599" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Come with me for a sec.</p>
   <p begin="01:16:43.683" end="01:16:45.727" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji gasps]</p>
   <p begin="01:16:51.024" end="01:16:51.983" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Fifteen years ago,</p>
   <p begin="01:16:53.151" end="01:16:56.362" region="AmazonDefaultRegion" style="AmazonDefaultStyle">half of humanity died<br />following the Second Impact in Antarctica.</p>
   <p begin="01:16:57.613" end="01:17:00.450" region="AmazonDefaultRegion" style="AmazonDefaultStyle">If we let the angels set off<br />the Third Impact, we're done.</p>
   <p begin="01:17:00.533" end="01:17:02.076" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What's left of humanity will perish.</p>
   <p begin="01:17:02.160" end="01:17:03.786" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No one will survive.</p>
   <p begin="01:17:04.662" end="01:17:06.831" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I know all that.<br />I've heard it over and over again.</p>
   <p begin="01:17:10.835" end="01:17:12.003" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What you don't know</p>
   <p begin="01:17:12.086" end="01:17:16.049" region="AmazonDefaultRegion" style="AmazonDefaultStyle">is that if an angel gets<br />into Level triple E, below NERV HQ,</p>
   <p begin="01:17:17.133" end="01:17:19.802" region="AmazonDefaultRegion" style="AmazonDefaultStyle">this whole place<br />will automatically self-destruct.</p>
   <p begin="01:17:21.346" end="01:17:23.348" region="AmazonDefaultRegion" style="AmazonDefaultStyle">If we have to sacrifice ourselves</p>
   <p begin="01:17:23.431" end="01:17:26.434" region="AmazonDefaultRegion" style="AmazonDefaultStyle">to prevent the Third Impact, we'll do it.</p>
   <p begin="01:17:26.517" end="01:17:28.061" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Everyone who works here</p>
   <p begin="01:17:28.144" end="01:17:30.563" region="AmazonDefaultRegion" style="AmazonDefaultStyle">fully understands and accepts that risk.</p>
   <p begin="01:17:32.065" end="01:17:33.024" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beeping]</p>
   <p begin="01:17:35.109" end="01:17:36.069" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[ping]</p>
   <p begin="01:17:47.080" end="01:17:47.914" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="01:17:49.082" end="01:17:49.832" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can’t believe it.</p>
   <p begin="01:17:52.168" end="01:17:52.960" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It can't be...</p>
   <p begin="01:17:54.170" end="01:17:54.837" region="AmazonDefaultRegion" style="AmazonDefaultStyle">An Eva?</p>
   <p begin="01:17:55.254" end="01:17:59.258" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] It's not.<br />This being brought life to our planet...</p>
   <p begin="01:17:59.342" end="01:18:01.594" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And it could be<br />the agent of its extinction.</p>
   <p begin="01:18:01.677" end="01:18:04.639" region="AmazonDefaultRegion" style="AmazonDefaultStyle">This is the second angel, Lilith.</p>
   <p begin="01:18:04.722" end="01:18:07.225" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Lilith?<br />- Yes.</p>
   <p begin="01:18:07.308" end="01:18:10.645" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes. Some believe<br />it can trigger the Third Impact.</p>
   <p begin="01:18:10.728" end="01:18:12.772" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You need to guard Lilith</p>
   <p begin="01:18:12.855" end="01:18:14.524" region="AmazonDefaultRegion" style="AmazonDefaultStyle">by piloting the Eva.</p>
   <p begin="01:18:14.607" end="01:18:16.651" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You are the only person who can do it.</p>
   <p begin="01:18:17.443" end="01:18:19.987" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji, we are entrusting<br />the future of humanity</p>
   <p begin="01:18:20.071" end="01:18:21.572" region="AmazonDefaultRegion" style="AmazonDefaultStyle">to you and to your Eva.</p>
   <p begin="01:18:22.448" end="01:18:25.993" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All that responsibility.<br />Why does it have to be me?</p>
   <p begin="01:18:26.702" end="01:18:28.329" region="AmazonDefaultRegion" style="AmazonDefaultStyle">There's no specific reason.</p>
   <p begin="01:18:28.413" end="01:18:30.373" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Actually, fate chose you, Shinji.</p>
   <p begin="01:18:31.499" end="01:18:32.792" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But, you know,</p>
   <p begin="01:18:32.875" end="01:18:35.878" region="AmazonDefaultRegion" style="AmazonDefaultStyle">you're not the only one<br />who's putting his life on the line.</p>
   <p begin="01:18:37.296" end="01:18:38.589" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We all are.</p>
   <p begin="01:18:43.136" end="01:18:46.139" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'll do it, Misato. I'll pilot my Eva.</p>
   <p begin="01:18:50.476" end="01:18:51.602" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[humming]</p>
   <p begin="01:19:00.695" end="01:19:04.657" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Right. I will now inform you<br />of your roles in this operation.</p>
   <p begin="01:19:04.740" end="01:19:06.409" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Shinji.<br />- Yes, ma'am.</p>
   <p begin="01:19:06.492" end="01:19:09.370" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- You will be the gunner in Unit One.<br />- Yes, ma'am.</p>
   <p begin="01:19:09.454" end="01:19:11.914" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Rei, you will be in charge of defense<br />in Unit Zero.</p>
   <p begin="01:19:12.623" end="01:19:13.207" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Yes, ma'am.</p>
   <p begin="01:19:13.708" end="01:19:17.044" region="AmazonDefaultRegion" style="AmazonDefaultStyle">To succeed, this operation<br />requires an extreme level of precision.</p>
   <p begin="01:19:17.628" end="01:19:20.548" region="AmazonDefaultRegion" style="AmazonDefaultStyle">For that reason<br />and because Unit Zero needs calibration,</p>
   <p begin="01:19:20.631" end="01:19:23.593" region="AmazonDefaultRegion" style="AmazonDefaultStyle">we chose Unit One as gunner,<br />even though it's not fully repaired.</p>
   <p begin="01:19:23.926" end="01:19:25.595" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So listen carefully, Shinji.</p>
   <p begin="01:19:25.678" end="01:19:27.763" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Positrons are affected by many factors:</p>
   <p begin="01:19:27.847" end="01:19:31.434" region="AmazonDefaultRegion" style="AmazonDefaultStyle">gravity, the rotation of the Earth,<br />its magnetic field.</p>
   <p begin="01:19:31.517" end="01:19:34.061" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You have to take all that into account.</p>
   <p begin="01:19:34.770" end="01:19:37.398" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Target the core<br />and deliver a precise shot in the middle.</p>
   <p begin="01:19:37.482" end="01:19:40.109" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Easy to say,<br />but we can't even see where the core is.</p>
   <p begin="01:19:40.693" end="01:19:45.490" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ritsuko] Don't worry. Part of the angel<br />materializes during its attack phase.</p>
   <p begin="01:19:46.282" end="01:19:48.868" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We believe that's where its core is.</p>
   <p begin="01:19:48.951" end="01:19:51.871" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We will identify the targeting specifics<br />and supply you</p>
   <p begin="01:19:51.954" end="01:19:53.539" region="AmazonDefaultRegion" style="AmazonDefaultStyle">with the firing solution.</p>
   <p begin="01:19:54.332" end="01:19:56.209" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Just follow the instructions on screen.</p>
   <p begin="01:19:56.292" end="01:19:59.712" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Then when the crosshairs<br />line up in the center, you just shoot.</p>
   <p begin="01:20:00.588" end="01:20:02.298" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The machine will do the rest.</p>
   <p begin="01:20:02.882" end="01:20:04.258" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But there's a catch:</p>
   <p begin="01:20:04.342" end="01:20:06.969" region="AmazonDefaultRegion" style="AmazonDefaultStyle">only one location has been set up<br />to receive all the power up</p>
   <p begin="01:20:07.053" end="01:20:09.931" region="AmazonDefaultRegion" style="AmazonDefaultStyle">for the massive electrical discharge.</p>
   <p begin="01:20:10.598" end="01:20:13.643" region="AmazonDefaultRegion" style="AmazonDefaultStyle">For that reason,<br />Unit One's firing position is fixed.</p>
   <p begin="01:20:14.393" end="01:20:16.354" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So retreat will not be an option?</p>
   <p begin="01:20:16.437" end="01:20:18.606" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Correct.<br />- But what...</p>
   <p begin="01:20:18.689" end="01:20:20.650" region="AmazonDefaultRegion" style="AmazonDefaultStyle">What if I miss and the angel shoots back?</p>
   <p begin="01:20:20.733" end="01:20:22.818" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Don't think about that for now.</p>
   <p begin="01:20:22.902" end="01:20:25.571" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Focus on your job<br />and hit the enemy with your first shot.</p>
   <p begin="01:20:26.489" end="01:20:28.699" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So... Hit the target,<br />or we're in big trouble?</p>
   <p begin="01:20:29.534" end="01:20:30.201" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei] So I...</p>
   <p begin="01:20:31.244" end="01:20:33.663" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- I'm supposed to protect Unit One?<br />- Yes.</p>
   <p begin="01:20:34.330" end="01:20:34.997" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Understood.</p>
   <p begin="01:20:35.915" end="01:20:38.334" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] It's time.<br />Get ready, both of you.</p>
   <p begin="01:20:38.417" end="01:20:39.085" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Rei and Shinji] Yes, ma'am.</p>
   <p begin="01:20:48.052" end="01:20:49.178" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] You know...</p>
   <p begin="01:20:51.681" end="01:20:54.350" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You know... we could die tonight.</p>
   <p begin="01:20:56.686" end="01:20:57.395" region="AmazonDefaultRegion" style="AmazonDefaultStyle">No, Shinji.</p>
   <p begin="01:20:58.980" end="01:21:00.189" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You won't die.</p>
   <p begin="01:21:01.691" end="01:21:03.025" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I will protect you.</p>
   <p begin="01:21:09.407" end="01:21:11.826" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don't feel I'm worth protecting.</p>
   <p begin="01:21:12.743" end="01:21:15.288" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Here's a message<br />left with HQ public affairs.</p>
   <p begin="01:21:15.705" end="01:21:16.539" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Oh.</p>
   <p begin="01:21:18.457" end="01:21:19.709" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[soft music]</p>
   <p begin="01:21:21.210" end="01:21:22.086" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[caws]</p>
   <p begin="01:21:22.169" end="01:21:22.962" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beeping]</p>
   <p begin="01:21:23.754" end="01:21:26.424" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Hello? It's me, Tohji Suzuhara.</span></p>
   <p begin="01:21:26.507" end="01:21:28.217" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Ikari... No.</span></p>
   <p begin="01:21:28.301" end="01:21:32.346" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Let me call you Shinji, OK?</span><br /><span tts:fontStyle="italic">Hey Shinji, I'm counting on you.</span></p>
   <p begin="01:21:32.430" end="01:21:34.974" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[shelter atmosphere]</p>
   <p begin="01:21:35.057" end="01:21:36.934" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Hey! It's me, Aida. Ikari...</span></p>
   <p begin="01:21:37.893" end="01:21:39.353" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Go get them.</span></p>
   <p begin="01:21:42.356" end="01:21:43.357" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[string music]</p>
   <p begin="01:22:23.564" end="01:22:26.192" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Tell me, Ayanami.<br />Why do you pilot your Eva?</p>
   <p begin="01:22:28.736" end="01:22:29.737" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Because it's my link.</p>
   <p begin="01:22:30.696" end="01:22:34.450" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- It's your link?<br />- Yes, my link.</p>
   <p begin="01:22:36.285" end="01:22:39.872" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- You mean, to my father?<br />- To everyone.</p>
   <p begin="01:22:40.956" end="01:22:43.292" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You sure are tough, Rei Ayanami.</p>
   <p begin="01:22:45.252" end="01:22:47.421" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's just that... this is all I have.</p>
   <p begin="01:22:49.382" end="01:22:51.801" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's time. Let's go.</p>
   <p begin="01:22:55.429" end="01:22:56.097" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Farewell.</p>
   <p begin="01:22:58.140" end="01:22:59.183" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[siren wailing]</p>
   <p begin="01:23:04.647" end="01:23:10.361" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female TV] <span tts:fontStyle="italic">At the tone, it will be</span><br /><span tts:fontStyle="italic">12 o'clock, midnight. Precisely.</span></p>
   <p begin="01:23:10.444" end="01:23:13.322" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[beeping]</p>
   <p begin="01:23:14.740" end="01:23:16.450" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Midnight, ma'am.<br />- Listen Shinji.</p>
   <p begin="01:23:17.284" end="01:23:21.080" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You chose to get back in the Eva.<br />If for only just that, I am grateful.</p>
   <p begin="01:23:21.706" end="01:23:22.665" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thank you.</p>
   <p begin="01:23:22.748" end="01:23:26.293" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Begin Operation Yashima.<br />Positron cannon, pre-firing sequence.</p>
   <p begin="01:23:26.377" end="01:23:28.003" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Stage One, power connection.</p>
   <p begin="01:23:28.379" end="01:23:32.216" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Roger. Connecting circuits<br />with primary and secondary substations.</p>
   <p begin="01:23:32.299" end="01:23:34.385" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Stage One</span><br /><span tts:fontStyle="italic">power connection circuits engaged.</span></p>
   <p begin="01:23:36.137" end="01:23:40.015" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Increasing frequency modulation capacity</span><br /><span tts:fontStyle="italic">to 65 GigaWatts.</span></p>
   <p begin="01:23:40.599" end="01:23:42.059" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Stage One circuit breaker system</span></p>
   <p begin="01:23:42.143" end="01:23:44.645" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">function optimal. All power stations,</span><br /><span tts:fontStyle="italic">maintain full capacity.</span></p>
   <p begin="01:23:44.729" end="01:23:47.189" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Confirmation: systems ready.</span></p>
   <p begin="01:23:47.273" end="01:23:49.942" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">0.7</span><br /><span tts:fontStyle="italic">to maximum power threshold.</span></p>
   <p begin="01:23:50.025" end="01:23:52.903" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Districts One through 803,<br />enable transmission power lines.</p>
   <p begin="01:23:52.987" end="01:23:56.365" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Voltage stable.</span><br /><span tts:fontStyle="italic">Maintain grid frequency at 50Hz.</span></p>
   <p begin="01:23:56.449" end="01:23:58.033" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Begin stage two power connection.</p>
   <p begin="01:23:59.326" end="01:24:01.912" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Bringing</span><br /><span tts:fontStyle="italic">Shingotenba Substation online.</span></p>
   <p begin="01:24:01.996" end="01:24:05.332" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Bringing Shinyugawara</span><br /><span tts:fontStyle="italic">Auxiliary Substation online as well.</span></p>
   <p begin="01:24:05.916" end="01:24:07.293" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Cooling systems operational.</span></p>
   <p begin="01:24:07.543" end="01:24:08.794" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] Stage three power connection.</p>
   <p begin="01:24:08.878" end="01:24:12.089" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Roger, redirecting all power<br />to the Futagoyama installation.</p>
   <p begin="01:24:12.548" end="01:24:16.177" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Maintain maximum</span><br /><span tts:fontStyle="italic">allowable power transmission voltage.</span></p>
   <p begin="01:24:16.260" end="01:24:18.053" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Superconducting battery banks...</span></p>
   <p begin="01:24:18.137" end="01:24:20.097" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Verifying all indicators: status green.</span></p>
   <p begin="01:24:20.181" end="01:24:22.516" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Maintain highest possible</span><br /><span tts:fontStyle="italic">frequency modulation</span></p>
   <p begin="01:24:22.600" end="01:24:24.894" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">on power from Western Japan.</span></p>
   <p begin="01:24:25.394" end="01:24:27.521" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Stage three power connection:<br />status green.</p>
   <p begin="01:24:27.605" end="01:24:30.483" region="AmazonDefaultRegion" style="AmazonDefaultStyle">OK, very good. Inform<br />Fortress Command Centers four and five.</p>
   <p begin="01:24:30.566" end="01:24:32.985" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Begin operations as planned.</p>
   <p begin="01:24:33.068" end="01:24:34.779" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Pull back surveillance aircraft.</p>
   <p begin="01:24:36.906" end="01:24:37.698" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blasts]</p>
   <p begin="01:25:04.058" end="01:25:06.310" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Number Three Anti-Air Defense System<br />vaporized!</p>
   <p begin="01:25:06.393" end="01:25:08.145" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Keep piling it on. Keep it preoccupied.</p>
   <p begin="01:25:08.521" end="01:25:09.355" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Next!</p>
   <p begin="01:25:09.438" end="01:25:10.272" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[shooting]</p>
   <p begin="01:25:18.113" end="01:25:18.823" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="01:25:21.116" end="01:25:22.493" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Turret Battery has been hit.</p>
   <p begin="01:25:22.576" end="01:25:23.994" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">VLS Battery Group vaporized.</span></p>
   <p begin="01:25:24.078" end="01:25:26.789" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No. 4 Anti-Air Defense System,</span><br /><span tts:fontStyle="italic">initiating attack.</span></p>
   <p begin="01:25:30.292" end="01:25:33.337" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Positron accelerator, charging.</span><br /><span tts:fontStyle="italic">Currently at One Terrawatt.</span></p>
   <p begin="01:25:33.420" end="01:25:36.549" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">No. 7 Turret Battery, open fire.</span></p>
   <p begin="01:25:36.632" end="01:25:39.093" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Transmission loss increasing.</span><br /><span tts:fontStyle="italic">Shutting down...</span></p>
   <p begin="01:25:39.677" end="01:25:42.555" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Circuit has been isolated.</span><br /><span tts:fontStyle="italic">No abnormal over-voltage.</span></p>
   <p begin="01:25:42.638" end="01:25:44.056" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Power loss within acceptable range.</span></p>
   <p begin="01:25:44.139" end="01:25:47.309" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Circuit breakers operational.</span><br /><span tts:fontStyle="italic">Recovery in progress.</span></p>
   <p begin="01:25:47.393" end="01:25:48.519" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Positron canon.</span></p>
   <p begin="01:25:48.602" end="01:25:52.022" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Circuit cut-off nominal. No abnormalities</span><br /><span tts:fontStyle="italic">detected in intake overvoltage.</span></p>
   <p begin="01:25:52.106" end="01:25:54.859" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Safeties, operational,</span><br /><span tts:fontStyle="italic">proceed with operation.</span></p>
   <p begin="01:25:54.984" end="01:25:57.027" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">At 0.019 %.</span></p>
   <p begin="01:25:57.111" end="01:25:58.863" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Final safety devise. Disabled!</p>
   <p begin="01:25:58.946" end="01:25:59.905" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Arm gun to fire!</p>
   <p begin="01:26:05.953" end="01:26:08.455" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Initiating final input</span><br /><span tts:fontStyle="italic">of sniping parameters.</span></p>
   <p begin="01:26:09.331" end="01:26:13.335" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Targeting scope calibration correction:</span><br /><span tts:fontStyle="italic">plus 0.0009.</span></p>
   <p begin="01:26:13.419" end="01:26:15.796" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">The rangekeeper is autotracking target.</span></p>
   <p begin="01:26:15.880" end="01:26:18.090" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Target Scope calibration complete.</p>
   <p begin="01:26:18.173" end="01:26:19.633" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Positrons accelerating:</span></p>
   <p begin="01:26:19.717" end="01:26:22.511" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">reaching firing threshold</span><br /><span tts:fontStyle="italic">in two seconds, one second.</span></p>
   <p begin="01:26:22.595" end="01:26:25.514" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Initiate final stage five<br />power connection.</p>
   <p begin="01:26:25.598" end="01:26:29.143" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Route all energy to extreme<br />high-voltage discharge subsystem.</p>
   <p begin="01:26:29.226" end="01:26:31.145" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Ready for full power influx.</span></p>
   <p begin="01:26:31.228" end="01:26:33.606" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA]<span tts:fontStyle="italic"> Proceeding</span><br /><span tts:fontStyle="italic">with final calibration of positron</span></p>
   <p begin="01:26:33.689" end="01:26:35.065" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">acceleration chamber.</span></p>
   <p begin="01:26:35.149" end="01:26:38.110" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] I don't have<br />Rei's courage and resolve.</p>
   <p begin="01:26:38.193" end="01:26:41.614" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don't have much confidence<br />in piloting my Eva...</p>
   <p begin="01:26:41.697" end="01:26:43.157" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I don’t understand what I’m doing.</p>
   <p begin="01:26:43.240" end="01:26:44.783" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I’m just doing what I’m told to do.</p>
   <p begin="01:26:45.409" end="01:26:47.661" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Protecting humanity?</p>
   <p begin="01:26:47.745" end="01:26:50.414" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I can't even begin<br />to understand that responsibility.</p>
   <p begin="01:26:51.624" end="01:26:53.125" region="AmazonDefaultRegion" style="AmazonDefaultStyle">So why me?</p>
   <p begin="01:26:54.460" end="01:26:57.087" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Thirteen... Twelve... Eleven...</p>
   <p begin="01:26:57.171" end="01:26:59.131" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ten... Nine...</p>
   <p begin="01:26:59.214" end="01:27:01.091" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Eight... Seven...</p>
   <p begin="01:27:01.175" end="01:27:02.092" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Six...</p>
   <p begin="01:27:02.176" end="01:27:03.093" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Five...</p>
   <p begin="01:27:03.177" end="01:27:04.094" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Four...</p>
   <p begin="01:27:04.178" end="01:27:05.095" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Three...</p>
   <p begin="01:27:05.179" end="01:27:06.096" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Two...</p>
   <p begin="01:27:06.180" end="01:27:07.139" region="AmazonDefaultRegion" style="AmazonDefaultStyle">One...</p>
   <p begin="01:27:07.222" end="01:27:07.806" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Fire!</p>
   <p begin="01:27:10.684" end="01:27:11.268" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast]</p>
   <p begin="01:27:16.565" end="01:27:18.317" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[angel screaming]</p>
   <p begin="01:27:28.327" end="01:27:29.161" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We got it?</p>
   <p begin="01:27:36.126" end="01:27:38.379" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- No! We missed!<br />- Impossible! The timing was perfect!</p>
   <p begin="01:27:39.421" end="01:27:41.173" region="AmazonDefaultRegion" style="AmazonDefaultStyle">High energy readings coming from target!</p>
   <p begin="01:27:41.256" end="01:27:43.467" region="AmazonDefaultRegion" style="AmazonDefaultStyle">All personnel, brace for impact!</p>
   <p begin="01:27:48.430" end="01:27:50.641" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[angel screaming]</p>
   <p begin="01:27:51.141" end="01:27:51.934" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="01:28:10.160" end="01:28:11.078" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[alarm]</p>
   <p begin="01:28:16.667" end="01:28:18.252" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Energy systems, status report.</p>
   <p begin="01:28:18.335" end="01:28:21.630" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Systems operational!<br />Recharging is already underway.</p>
   <p begin="01:28:21.714" end="01:28:23.132" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Status of the Positron Cannon?</p>
   <p begin="01:28:23.215" end="01:28:26.135" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Still operational.<br />Initiating barrel cooling process.</p>
   <p begin="01:28:26.218" end="01:28:28.637" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But cannot verify<br />if another shot is possible...</p>
   <p begin="01:28:28.721" end="01:28:31.348" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Forget the diagnostics.<br />We have to do it anyway!</p>
   <p begin="01:28:31.432" end="01:28:32.474" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji? Are you alright?</p>
   <p begin="01:28:33.475" end="01:28:36.061" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Hurry and get Unit One<br />back in firing position.</p>
   <p begin="01:28:38.689" end="01:28:39.440" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji?</p>
   <p begin="01:28:40.107" end="01:28:41.900" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji gasping]</p>
   <p begin="01:28:41.984" end="01:28:44.445" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="01:28:44.945" end="01:28:46.572" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji crying]</p>
   <p begin="01:28:47.281" end="01:28:48.782" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crying]</p>
   <p begin="01:28:49.825" end="01:28:52.536" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] As of now,<br />Unit One pilot is relieved of duty.</p>
   <p begin="01:28:53.412" end="01:28:55.748" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Make Unit Zero's pilot the gunner.</p>
   <p begin="01:28:56.206" end="01:28:57.541" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But Ikari...</p>
   <p begin="01:28:57.624" end="01:29:00.085" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ikari] If he can't do the job,<br />we cut him off.</p>
   <p begin="01:29:00.169" end="01:29:01.670" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Please, delay that order!</p>
   <p begin="01:29:02.254" end="01:29:04.256" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He didn't run from piloting the Eva.</p>
   <p begin="01:29:05.591" end="01:29:08.260" region="AmazonDefaultRegion" style="AmazonDefaultStyle">He should be left in charge<br />unless he wants out!</p>
   <p begin="01:29:08.677" end="01:29:09.428" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji strains]</p>
   <p begin="01:29:09.928" end="01:29:11.180" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Tohji] <span tts:fontStyle="italic">And Shinji?</span></p>
   <p begin="01:29:11.472" end="01:29:12.473" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">I'm counting on you.</span></p>
   <p begin="01:29:12.556" end="01:29:14.224" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kensuke] <span tts:fontStyle="italic">Ikari. Go get 'em.</span></p>
   <p begin="01:29:31.408" end="01:29:33.869" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] I'm begging you, sir.<br />Have faith in your son.</p>
   <p begin="01:29:41.418" end="01:29:44.004" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I assure you<br />I do have faith in him right now.</p>
   <p begin="01:29:47.216" end="01:29:50.052" region="AmazonDefaultRegion" style="AmazonDefaultStyle">As you wish. You can carry on.</p>
   <p begin="01:29:50.135" end="01:29:51.136" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Thank you, sir.</p>
   <p begin="01:29:52.554" end="01:29:54.681" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Shinji.<br />- Yes, ma'am.</p>
   <p begin="01:29:54.765" end="01:29:57.643" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We're going to entrust you<br />with all the energy produced in Japan.</p>
   <p begin="01:29:58.352" end="01:30:01.605" region="AmazonDefaultRegion" style="AmazonDefaultStyle">With our hope, all humanity's future</p>
   <p begin="01:30:01.688" end="01:30:03.982" region="AmazonDefaultRegion" style="AmazonDefaultStyle">and the future of all living things<br />that've survived...</p>
   <p begin="01:30:04.983" end="01:30:06.110" region="AmazonDefaultRegion" style="AmazonDefaultStyle">It's all up to you, now.</p>
   <p begin="01:30:06.944" end="01:30:09.071" region="AmazonDefaultRegion" style="AmazonDefaultStyle">- Go for it.<br />- Yes, ma'am.</p>
   <p begin="01:30:12.074" end="01:30:14.159" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Hyuga] Cannon locked in position.</p>
   <p begin="01:30:14.451" end="01:30:16.411" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Unit One,<br />removing Type G components.</p>
   <p begin="01:30:16.995" end="01:30:19.414" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Switching Fire Control Systems<br />to manual mode.</p>
   <p begin="01:30:21.291" end="01:30:22.042" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[drilling]</p>
   <p begin="01:30:26.672" end="01:30:29.591" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Aoba] Enemy drill has breached<br />point zero, directly above HQ!</p>
   <p begin="01:30:29.675" end="01:30:30.926" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ready the second shot now!</p>
   <p begin="01:30:32.845" end="01:30:35.264" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Fuse replaced!<br />Barrel cooling process complete!</p>
   <p begin="01:30:35.347" end="01:30:38.100" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[female PA] <span tts:fontStyle="italic">Power transmission systems...</span></p>
   <p begin="01:30:38.183" end="01:30:40.102" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Ground crew evacuation complete.</span></p>
   <p begin="01:30:40.185" end="01:30:42.271" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Cooling subsystem pressure</span><br /><span tts:fontStyle="italic">is exceeding max limit.</span></p>
   <p begin="01:30:42.354" end="01:30:44.773" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] Final firing solution<br />data input complete.</p>
   <p begin="01:30:44.857" end="01:30:47.442" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Final adjustments entrusted<br />to pilot’s manual control.</p>
   <p begin="01:30:47.943" end="01:30:51.155" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[male PA] <span tts:fontStyle="italic">Firing threshold reached</span><br /><span tts:fontStyle="italic">in zero point two.</span></p>
   <p begin="01:30:51.655" end="01:30:53.615" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Ibuki] High energy readings<br />from target again!</p>
   <p begin="01:30:54.074" end="01:30:54.825" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Damn it!</p>
   <p begin="01:30:55.242" end="01:30:56.243" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="01:30:56.326" end="01:30:57.286" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="01:31:03.375" end="01:31:04.501" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji?</p>
   <p begin="01:31:04.585" end="01:31:05.502" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="01:31:07.254" end="01:31:08.130" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[explosion]</p>
   <p begin="01:31:16.263" end="01:31:17.598" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami!</p>
   <p begin="01:31:18.974" end="01:31:19.975" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[blast]</p>
   <p begin="01:31:22.686" end="01:31:23.562" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shield is breaking up!</p>
   <p begin="01:31:23.645" end="01:31:24.354" region="AmazonDefaultRegion" style="AmazonDefaultStyle">How long can it hold?</p>
   <p begin="01:31:24.438" end="01:31:25.355" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Twenty seconds!</p>
   <p begin="01:31:26.315" end="01:31:27.733" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Come on!</p>
   <p begin="01:31:35.032" end="01:31:37.034" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Shinji] Come on! Come on!</p>
   <p begin="01:31:39.912" end="01:31:40.829" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Come on!</p>
   <p begin="01:32:02.726" end="01:32:04.561" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[angel screaming]</p>
   <p begin="01:32:12.819" end="01:32:13.695" region="AmazonDefaultRegion" style="AmazonDefaultStyle">We did it!</p>
   <p begin="01:32:30.712" end="01:32:32.256" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[rain]</p>
   <p begin="01:32:35.425" end="01:32:37.261" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing]</p>
   <p begin="01:32:42.766" end="01:32:44.643" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crashing, broken glass]</p>
   <p begin="01:32:44.726" end="01:32:45.602" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami!</p>
   <p begin="01:32:50.732" end="01:32:52.484" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami?</p>
   <p begin="01:33:13.880" end="01:33:15.882" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[efforts]</p>
   <p begin="01:33:16.383" end="01:33:17.509" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[strains]</p>
   <p begin="01:33:18.343" end="01:33:19.511" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[strains]</p>
   <p begin="01:33:24.599" end="01:33:25.809" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Ayanami!</p>
   <p begin="01:33:25.892" end="01:33:28.270" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Are you OK? Ayanami? Ayanami!</p>
   <p begin="01:33:35.610" end="01:33:38.405" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[sighs]</p>
   <p begin="01:33:39.489" end="01:33:43.493" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I never want to hear you say things like,<br />like: "This is all I have."</p>
   <p begin="01:33:46.496" end="01:33:48.582" region="AmazonDefaultRegion" style="AmazonDefaultStyle">And I never want<br />to hear you say "farewell",</p>
   <p begin="01:33:48.665" end="01:33:50.667" region="AmazonDefaultRegion" style="AmazonDefaultStyle">like we're never going<br />to see each other again.</p>
   <p begin="01:33:51.043" end="01:33:53.045" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[crying]</p>
   <p begin="01:34:00.260" end="01:34:01.970" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji... Why are you crying?</p>
   <p begin="01:34:05.390" end="01:34:06.725" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm sorry.</p>
   <p begin="01:34:06.808" end="01:34:10.270" region="AmazonDefaultRegion" style="AmazonDefaultStyle">But I don't know<br />how I should act at a time like this.</p>
   <p begin="01:34:10.854" end="01:34:13.648" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You could smile... that would be good.</p>
   <p begin="01:34:14.066" end="01:34:14.858" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="01:34:43.929" end="01:34:44.596" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[gasps]</p>
   <p begin="01:34:51.770" end="01:34:55.774" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kaworu] I know.<br />The boy down there has awakened,</p>
   <p begin="01:34:55.857" end="01:34:57.984" region="AmazonDefaultRegion" style="AmazonDefaultStyle">and is now<br />in the generalization stage, right?</p>
   <p begin="01:34:59.069" end="01:34:59.820" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Kiel] Yes.</p>
   <p begin="01:34:59.903" end="01:35:03.698" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The Dead Sea Scrolls Apocrypha have<br />been fulfilled up to the Book of Codes.</p>
   <p begin="01:35:04.699" end="01:35:07.077" region="AmazonDefaultRegion" style="AmazonDefaultStyle">The time of the pact draws near.</p>
   <p begin="01:35:10.580" end="01:35:12.541" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Number three again?</p>
   <p begin="01:35:12.624" end="01:35:14.459" region="AmazonDefaultRegion" style="AmazonDefaultStyle">You don't change, do you?</p>
   <p begin="01:35:15.961" end="01:35:17.462" region="AmazonDefaultRegion" style="AmazonDefaultStyle">I'm looking forward to meeting you,</p>
   <p begin="01:35:18.338" end="01:35:19.548" region="AmazonDefaultRegion" style="AmazonDefaultStyle">Shinji Ikari.</p>
   <p begin="01:35:29.307" end="01:35:31.476" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[end credits]</p>
   <p begin="01:40:22.892" end="01:40:25.770" region="AmazonDefaultRegion" style="AmazonDefaultStyle">[Misato] <span tts:fontStyle="italic">Provisional Eva Unit Five</span><br /><span tts:fontStyle="italic">scrambles to action!</span></p>
   <p begin="01:40:25.854" end="01:40:27.939" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Eva Unit 02 and its pilot appear!</span></p>
   <p begin="01:40:28.022" end="01:40:29.691" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Eva Unit Four vanishes!</span></p>
   <p begin="01:40:29.774" end="01:40:32.444" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">The forced activation test</span><br /><span tts:fontStyle="italic">of Eva Unit Three.</span></p>
   <p begin="01:40:32.527" end="01:40:36.197" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">And Eva Unit Six and its pilot</span><br /><span tts:fontStyle="italic">descend from the Moon.</span></p>
   <p begin="01:40:36.990" end="01:40:39.993" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Our story unfolds and Shinji unravels.</span></p>
   <p begin="01:40:40.076" end="01:40:41.953" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">How long can it last?</span></p>
   <p begin="01:40:42.662" end="01:40:45.081" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Don't miss: Evangelion two</span></p>
   <p begin="01:40:45.165" end="01:40:46.166" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">point twenty-two!</span></p>
   <p begin="01:40:46.249" end="01:40:49.919" region="AmazonDefaultRegion" style="AmazonDefaultStyle"><span tts:fontStyle="italic">Get ready for all that,</span><br /><span tts:fontStyle="italic">plus many surprises, coming up!</span></p>
  </div>
 </body></tt>